<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is required for App Store distribution. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outgoing network access — for S3 endpoints. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected files: upload sources and download destinations
         picked via NSOpenPanel / NSSavePanel. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Default ~/Downloads access for quick saves without picker. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- App Group and shared Keychain access group are added in Phase 9
         when the File Provider extension is introduced. They require
         registration at developer.apple.com before they can be used. -->
</dict>
</plist>
