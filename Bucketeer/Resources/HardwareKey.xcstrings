    "hardwareKey.preview.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technická ukázka — brána pro zobrazení tajných klíčů zatím používá Touch ID. Ověřování hardwarovým klíčem přijde ve v1.1 po širším ověření na zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk forhåndsversion — visning af hemmeligheder kræver stadig Touch ID. Godkendelse med hardwarenøgle kommer i v1.1 efter yderligere test på flere enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische Vorschau — das Anzeigen gespeicherter Geheimnisse nutzt weiterhin Touch ID. Die Authentifizierung per Hardware-Schlüssel folgt in v1.1 nach umfassender Gerätevalidierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τεχνική προεπισκόπηση — η πύλη εμφάνισης μυστικών εξακολουθεί να χρησιμοποιεί Touch ID. Η ταυτοποίηση με κλειδί υλικού θα κυκλοφορήσει στην έκδοση v1.1 μετά από ευρύτερο έλεγχο συσκευών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical preview — the secret-reveal gate still uses Touch ID. Hardware-key authentication ships in v1.1 after a wider device-validation pass."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical preview — the secret-reveal gate still uses Touch ID. Hardware-key authentication ships in v1.1 after a wider device-validation pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa técnica — el desbloqueo de secretos sigue usando Touch ID. La autenticación por hardware llegará en v1.1 tras una validación más amplia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekninen esiversio — salaisuuksien näyttäminen vaatii yhä Touch ID:n. Laitteistoavaimella todentaminen tulee versioon 1.1 laajemman laitetestauksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu technique — le déverrouillage de secret utilise toujours Touch ID. L’authentification par clé matérielle arrivera en v1.1 après une validation matérielle plus large."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technikai előzetes — a titkos adatok felfedése továbbra is Touch ID-t használ. A hardverkulcsos hitelesítés a v1.1-ben érkezik, szélesebb körű eszközvalidálás után."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima tecnica — lo sblocco dei segreti usa ancora Touch ID. L’autenticazione hardware arriva in v1.1 dopo una validazione su più dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術プレビュー — シークレットの表示には引き続き Touch ID を使用します。ハードウェアキーによる認証は、より多くのデバイスで検証したうえで v1.1 で提供予定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기술 미리보기 — 비밀 키 표시에는 여전히 Touch ID가 사용됩니다. 하드웨어 키 인증은 더 많은 기기에서 검증한 후 v1.1에서 제공될 예정입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk forhåndsversjon — visning av hemmeligheter krever fortsatt Touch ID. Autentisering med maskinvarenøkkel kommer i v1.1 etter mer testing på flere enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische preview — het tonen van geheime sleutels gebruikt nog Touch ID. Verificatie met een hardwaresleutel komt in v1.1, na bredere validatie op apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd techniczny — odblokowanie sekretów nadal używa Touch ID. Uwierzytelnianie sprzętowe pojawi się w v1.1 po szerszej weryfikacji urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-visualização técnica — o desbloqueio de segredos ainda usa Touch ID. Autenticação por hardware chega na v1.1 após validação ampla em dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-visualização técnica — a proteção de revelação de segredos ainda usa o Touch ID. A autenticação por chave de hardware chega na v1.1, após uma validação mais ampla de dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предварительная техническая версия — доступ к секретам по-прежнему защищается Touch ID. Аутентификация аппаратным ключом появится в v1.1 после более широкой проверки на устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk förhandsversion — spärren för att visa hemligheter använder fortfarande Touch ID. Autentisering med maskinvarunyckel kommer i v1.1 efter en bredare enhetsvalidering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknik önizleme: gizli bilgiyi gösterme adımı hâlâ Touch ID kullanıyor. Donanım anahtarıyla kimlik doğrulama, daha geniş bir cihaz doğrulama sürecinden sonra v1.1'de gelecek."
          }
        }
      }
    },
