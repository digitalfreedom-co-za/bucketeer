<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bucketeer does not track users across apps or websites
         owned by other companies. -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
        Bucketeer collects no personal data on behalf of its publisher.
        Every host-side store stays on the user's Mac:

          • Bucketeer.store          — accounts + sync jobs (App Group)
          • BucketeerActivity.store  — Phase 13.1 audit log
          • BucketeerTrash.store     — Phase 13.4 soft-delete + cache
          • BucketeerAutoTags.store  — Phase 13.8 rule definitions
          • BucketeerCheckpoints.store — Phase 13.10 resumable uploads
          • BucketeerEncryptionKeys.store + Keychain — Phase 13.15 BYOK

        Apple processes purchase transactions for the Bucketeer Pro IAP
        under their own privacy policy. Per Apple's App Privacy
        guidance the developer does NOT declare data Apple collects to
        process StoreKit transactions — the app itself never sees
        purchase history beyond the local entitlement check, so the
        collected-data list is empty and the nutrition label reads
        "Data Not Collected".
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!--
        Required-reason API declarations.

        Apple introduced this manifest gate in 2024 to make sure apps
        only call the listed API categories for documented purposes.
        Reasons referenced below come from Apple's published table:
        https://developer.apple.com/documentation/bundleresources/privacy_manifest_files/describing_use_of_required_reason_api
    -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>

        <!--
            UserDefaults: app's own preferences.

            Phase 13.x added a lot of small toggles that all live in
            standard UserDefaults via @Observable / @AppStorage:
              • activity log filter state
              • bandwidth-limit preset + custom MB/s (13.2)
              • trash retention days + cache cap MB + master toggle (13.4)
              • Spotlight indexing toggle (13.13)
              • indexed-account UUIDs set (13.14 follow-up, Phase 14)
              • hardware-key preferred slot + enabled toggle (13.16)
              • trial start date + consumed marker (Phase B)

            All read/written by the app itself. Reason CA92.1 covers
            "app's own preferences".
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>

        <!--
            FileTimestamp uses, expanded for Phase 13.x:
              • C617.1 — display Last-Modified to user (browser + sync)
              • DDA9.1 — display local file timestamps in the app's
                          own download / preview lists
              • B8FF.1 — inspect timestamp of files the user explicitly
                          granted access to (security-scoped local
                          folder sync, Phase 9.8 + 9.10 + 13.3)
              • 0A2A.1 — file-replace / metadata reads on the user's
                          own caches (resumable-upload fingerprint
                          mtime/inode, Phase 13.10 + Codex R3 medium)
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
                <string>DDA9.1</string>
                <string>B8FF.1</string>
                <string>0A2A.1</string>
            </array>
        </dict>

        <!--
            DiskSpace: defensive declaration for the statically linked
            networking stack (swift-nio / async-http-client via Soto)
            whose file-system probes the app cannot audit release-to-
            release. E174.1/85F4.1 cover user-visible cache management
            and write-failure avoidance.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>E174.1</string>
                <string>85F4.1</string>
            </array>
        </dict>

        <!--
            SystemBootTime: swift-nio (statically linked via Soto)
            reads the monotonic clock (mach_absolute_time via
            NIODeadline/DispatchTime) for connection timeouts; the app
            itself measures transfer intervals with ContinuousClock.
            Reason 35F9.1 covers measuring time intervals within the
            app.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>

    </array>
</dict>
</plist>
