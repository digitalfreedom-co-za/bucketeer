    "trash.action.restore.help.available": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload the cached file to its original location."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die zwischengespeicherte Datei an den ursprünglichen Ort hoch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-téléverse le fichier mis en cache à son emplacement d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a subir el archivo en caché a su ubicación original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riupload del file in cache nella posizione originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたファイルを元の場所に再アップロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 파일을 원래 위치에 다시 업로드합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload het bestand in de cache opnieuw naar de oorspronkelijke locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wgrywa ponownie plik z pamięci podręcznej w jego pierwotne miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenvia o arquivo em cache para o local original."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu nahrát soubor z mezipaměti na jeho původní místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload den cachede fil til dens oprindelige placering igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφορτώνει ξανά το αποθηκευμένο στην προσωρινή μνήμη αρχείο στην αρχική του θέση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä välimuistissa oleva tiedosto uudelleen alkuperäiseen sijaintiinsa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyorsítótárazott fájl újrafeltöltése az eredeti helyére."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last opp den bufrede filen på nytt til den opprinnelige plasseringen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a carregar o ficheiro em cache para a localização original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить кэшированный файл обратно в исходное расположение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda upp den cachade filen till dess ursprungliga plats igen."
          }
        }
      }
    },
    "trash.action.restore.help.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore is not available without a cached copy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung benötigt eine zwischengespeicherte Kopie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration nécessite une copie en cache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar requiere una copia en caché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino richiede una copia in cache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元にはキャッシュされたコピーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하려면 캐시된 사본이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstellen vereist een gecachte kopie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie wymaga zachowanej kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração requer uma cópia em cache."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovení není bez kopie v mezipaměti k dispozici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannelse er ikke mulig uden en cachet kopi."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επαναφορά δεν είναι διαθέσιμη χωρίς αντίγραφο στην προσωρινή μνήμη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palautus ei ole mahdollista ilman välimuistikopiota."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyorsítótárazott másolat nélkül a visszaállítás nem érhető el."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenoppretting er ikke tilgjengelig uten en bufret kopi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O restauro não está disponível sem uma cópia em cache."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление недоступно без кэшированной копии."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställning är inte möjlig utan en cachad kopia."
          }
        }
      }
