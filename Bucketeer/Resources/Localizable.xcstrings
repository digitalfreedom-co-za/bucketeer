    "error.accessKeyNotRecognized.civo" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo tento přístupový klíč v oblasti %@ nezná. Klíče Civo fungují jen v oblasti, ve které byly vytvořeny – zkontrolujte oblast v nastavení účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo kender ikke denne adgangsnøgle i regionen %@. Civo-nøgler virker kun i den region, de blev oprettet i – kontrollér regionen i kontoindstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo kennt diesen Zugriffsschlüssel in der Region %@ nicht. Civo-Schlüssel gelten nur in der Region, in der sie erstellt wurden – prüfe die Region in den Kontoeinstellungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Civo δεν αναγνωρίζει αυτό το κλειδί πρόσβασης στην περιοχή %@. Τα κλειδιά Civo λειτουργούν μόνο στην περιοχή όπου δημιουργήθηκαν — ελέγξτε την περιοχή στις ρυθμίσεις του λογαριασμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo does not recognize this access key in region %@. Civo keys only work in the region they were created in — check the region in the account settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo does not recognise this access key in region %@. Civo keys only work in the region they were created in — check the region in the account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo no reconoce esta clave de acceso en la región %@. Las claves de Civo solo funcionan en la región en la que se crearon: comprueba la región en los ajustes de la cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ei tunnista tätä käyttöavainta alueella %@. Civo-avaimet toimivat vain alueella, jolla ne luotiin – tarkista alue tilin asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo ne reconnaît pas cette clé d’accès dans la région %@. Les clés Civo ne fonctionnent que dans la région où elles ont été créées – vérifiez la région dans les réglages du compte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Civo nem ismeri ezt a hozzáférési kulcsot a(z) %@ régióban. A Civo-kulcsok csak abban a régióban működnek, ahol létrehozták őket – ellenőrizze a régiót a fiók beállításaiban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo non riconosce questa chiave di accesso nella regione %@. Le chiavi Civo funzionano solo nella regione in cui sono state create: controlla la regione nelle impostazioni dell’account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo はリージョン %@ でこのアクセスキーを認識できません。Civo のキーは作成したリージョンでのみ使えます。アカウント設定のリージョンを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo가 %@ 리전에서 이 액세스 키를 인식하지 못합니다. Civo 키는 생성된 리전에서만 작동합니다. 계정 설정의 리전을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo kjenner ikke igjen denne tilgangsnøkkelen i regionen %@. Civo-nøkler fungerer bare i regionen de ble opprettet i – kontroller regionen i kontoinnstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo herkent deze toegangssleutel niet in regio %@. Civo-sleutels werken alleen in de regio waarin ze zijn aangemaakt – controleer de regio in de accountinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Civo nie rozpoznaje tego klucza dostępu w regionie %@. Klucze Civo działają tylko w regionie, w którym zostały utworzone – sprawdź region w ustawieniach konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Civo não reconhece esta chave de acesso na região %@. As chaves do Civo só funcionam na região em que foram criadas — verifique a região nos ajustes da conta."
          }
        },
        "pt-PT" : {
