    "mount.error.notProvisioned": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die File-Provider-Erweiterung ist noch nicht eingerichtet. App-Group-Entitlement und das Extension-Target müssen zuerst angelegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The File Provider extension is not yet provisioned. App Group entitlement and the extension target must be set up first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión de File Provider aún no está aprovisionada. El permiso App Group y el target de la extensión deben configurarse primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension File Provider n'est pas encore provisionnée. L'entitlement App Group et la cible d'extension doivent être configurés au préalable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'estensione File Provider non è ancora configurata. L'entitlement App Group e il target dell'estensione vanno impostati prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider 拡張がまだ準備されていません。先に App Group エンタイトルメントと拡張ターゲットを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider 확장이 아직 프로비저닝되지 않았습니다. 먼저 App Group 권한과 확장 타깃을 설정해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De File Provider-extensie is nog niet ingericht. App Group-entitlement en de extensietarget moeten eerst worden geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozszerzenie File Provider nie zostało jeszcze udostępnione. Najpierw skonfiguruj uprawnienie App Group oraz cel rozszerzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão File Provider ainda não está provisionada. O entitlement App Group e o target da extensão precisam ser configurados primeiro."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozšíření File Provider ještě není zprovozněno. Nejprve je nutné nastavit oprávnění App Group a cíl rozšíření."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider-udvidelsen er endnu ikke klargjort. App Group-rettigheden og udvidelsens target skal først konfigureres."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η επέκταση File Provider δεν έχει ρυθμιστεί ακόμη. Πρέπει πρώτα να ρυθμιστούν το δικαίωμα App Group και ο στόχος της επέκτασης."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider -laajennusta ei ole vielä provisioitu. App Group -oikeus ja laajennuskohde on määritettävä ensin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A File Provider bővítmény még nincs beállítva. Először az App Group jogosultságot és a bővítménycélt kell konfigurálni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider-utvidelsen er ikke klargjort ennå. App Group-rettigheten og utvidelsesmålet må konfigureres først."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão File Provider ainda não está aprovisionada. É necessário configurar primeiro o entitlement do App Group e o target da extensão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение File Provider ещё не настроено. Сначала необходимо настроить право App Group и целевой модуль расширения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider-tillägget är inte provisionerat ännu. App Group-behörigheten och tilläggsmålet måste konfigureras först."
          }
        }
      }
    },
