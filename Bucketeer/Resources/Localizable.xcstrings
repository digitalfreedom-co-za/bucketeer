    "sync.schedule.onLocalChange.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znovu spustí tuto úlohu při každé změně místní zdrojové složky. Spuštění se mírně zpozdí, aby série rychlých změn nevyvolala desítky běhů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kører dette job igen, hver gang den lokale kildemappe ændres. Ændringer samles op med en kort forsinkelse for at undgå unødige kørsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den Auftrag erneut aus, sobald sich der lokale Quellordner ändert. Entprellt, um Schübe zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκτελεί ξανά αυτήν την εργασία κάθε φορά που αλλάζει ο τοπικός φάκελος προέλευσης. Με μικρή καθυστέρηση, ώστε να αποφεύγονται διαδοχικές εκτελέσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-runs this job whenever the local source folder changes. Debounced to avoid storms."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-runs this job whenever the local source folder changes. Debounced to avoid storms."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ejecutar esta tarea cuando cambia la carpeta de origen local, con un breve retardo para evitar ejecuciones en ráfaga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suorittaa työn uudelleen aina, kun paikallinen lähdekansio muuttuu. Muutokset kootaan lyhyen viiveen ajan, jotta työtä ei käynnistetä turhaan monta kertaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réexécute cette tâche dès que le dossier source local change. Un délai anti-rebond évite les déclenchements en rafale."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Újrafuttatja a feladatot, valahányszor a helyi forrásmappa megváltozik. Késleltetve, hogy elkerülje a tömeges újraindításokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riesegue questo job ogni volta che la cartella di origine locale cambia, con un breve ritardo per evitare esecuzioni a raffica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのソースフォルダが変更されるたびにこのジョブを再実行します。短時間に何度も実行されないよう、実行は少し遅らせて行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 소스 폴더가 변경될 때마다 이 작업을 다시 실행합니다. 연속 실행을 방지하기 위해 잠시 기다린 후 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjører jobben på nytt hver gang den lokale kildemappen endres. Endringer samles opp med en kort forsinkelse for å unngå unødvendige kjøringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voert deze synchronisatie opnieuw uit zodra de lokale bronmap verandert. Wijzigingen worden kort gebundeld om een reeks herhaalde uitvoeringen te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia to zadanie ponownie po każdej zmianie lokalnego folderu źródłowego. Z niewielkim opóźnieniem, aby seria zmian nie wywołała wielu uruchomień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa esta tarefa novamente sempre que a pasta de origem local mudar. Com um pequeno atraso para evitar execuções em excesso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta a executar esta tarefa sempre que a pasta de origem local mudar. Com um pequeno atraso para evitar execuções em excesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторно запускает задание при каждом изменении локальной папки-источника. Срабатывания группируются, чтобы избежать лавины запусков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kör om det här jobbet varje gång den lokala källmappen ändras. Fördröjs för att undvika skurar av körningar."
          }
        }
      }
    },
