    "about.tagline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native macOS app for browsing, transferring, mounting and synchronising S3-compatible object storage across multiple providers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native macOS-App zum Durchstöbern, Übertragen, Einbinden und Synchronisieren von S3-kompatiblem Object Storage über verschiedene Anbieter hinweg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "App nativa de macOS para navegar, transferir, montar y sincronizar almacenamiento de objetos compatible con S3 entre varios proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application macOS native pour parcourir, transférer, monter et synchroniser le stockage d'objets compatible S3 entre plusieurs fournisseurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App nativa per macOS per esplorare, trasferire, montare e sincronizzare object storage compatibile con S3 tra più provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のプロバイダにまたがって S3 互換オブジェクトストレージを参照、転送、マウント、同期できる macOS ネイティブアプリ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 공급자의 S3 호환 오브젝트 스토리지를 탐색, 전송, 마운트, 동기화할 수 있는 macOS 네이티브 앱."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Native macOS-app om S3-compatibele objectopslag bij meerdere providers te verkennen, te verplaatsen, te koppelen en te synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natywna aplikacja macOS do przeglądania, przesyłania, montowania i synchronizowania pamięci obiektowej kompatybilnej z S3 między wieloma dostawcami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "App nativo do macOS para navegar, transferir, montar e sincronizar armazenamento de objetos compatível com S3 entre vários provedores."
          }
        }
      }
    },
