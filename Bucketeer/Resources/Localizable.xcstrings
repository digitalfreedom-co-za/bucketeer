    "account.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen? Die gespeicherten Zugangsdaten werden aus dem Schlüsselbund gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? This deletes the saved credentials from your Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Esto borra las credenciales guardadas del Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Cela efface les identifiants enregistrés du Trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@? Le credenziali salvate verranno cancellate dal Portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか?キーチェーンに保存された認証情報も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거하시겠습니까? 키체인에 저장된 자격 증명이 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwijderen? De opgeslagen referenties worden ook uit de Sleutelhanger verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@? Spowoduje to skasowanie zapisanych poświadczeń z Pęku kluczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@? Isso apaga as credenciais salvas no Acesso às Chaves."
          }
        }
      }
    },
