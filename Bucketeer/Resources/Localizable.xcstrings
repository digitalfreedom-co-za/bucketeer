    "settings.trash.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash stays on this Mac only. Provider-side objects are deleted immediately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Papierkorb bleibt nur auf diesem Mac. Provider-Objekte werden sofort gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La corbeille reste uniquement sur ce Mac. Les objets côté fournisseur sont supprimés immédiatement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La papelera permanece solo en este Mac. Los objetos en el proveedor se eliminan inmediatamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cestino resta solo su questo Mac. Gli oggetti lato provider vengono eliminati immediatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱はこのMac内にのみ残ります。プロバイダ側のオブジェクトは即時削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통은 이 Mac에만 보관됩니다. 공급자 측 객체는 즉시 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prullenbak blijft alleen op deze Mac. Provider-objecten worden direct verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosz pozostaje tylko na tym Macu. Obiekty po stronie dostawcy są usuwane natychmiast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lixeira fica apenas neste Mac. Os objetos no provedor são excluídos imediatamente."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Koš zůstává pouze na tomto Macu. Objekty na straně poskytovatele se mažou okamžitě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Papirkurven findes kun på denne Mac. Objekter hos udbyderen slettes med det samme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο Κάδος παραμένει μόνο σε αυτό το Mac. Τα αντικείμενα στην πλευρά του παρόχου διαγράφονται αμέσως."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskakori pysyy vain tällä Macilla. Palveluntarjoajan puolella objektit poistetaan heti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kuka csak ezen a Macen marad. A szolgáltatóoldali objektumok azonnal törlődnek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Papirkurven finnes bare på denne Macen. Objekter hos leverandøren slettes umiddelbart."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Lixo permanece apenas neste Mac. Os objetos do lado do fornecedor são eliminados imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корзина хранится только на этом Mac. Объекты на стороне провайдера удаляются немедленно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Papperskorgen finns bara på denna Mac. Objekt hos leverantören raderas omedelbart."
          }
        }
      }
    },
