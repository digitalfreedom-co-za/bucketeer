    "sync.delete.confirm.message %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit %@? Objektová úložiště zůstanou nedotčena; smaže se pouze definice úlohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne %@? Objektlagrene røres ikke; kun jobdefinitionen slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entfernen? Die Object Stores bleiben unverändert; nur die Job-Definition wird gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαίρεση του %@; Οι χώροι αποθήκευσης αντικειμένων δεν επηρεάζονται· διαγράφεται μόνο ο ορισμός της εργασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@? Object stores are untouched; only the job definition is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@? Los almacenes de objetos no se tocan; solo se borra la definición del trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko %@? Objektivarastoihin ei kosketa; vain työn määritys poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ ? Les stockages d'objets ne sont pas touchés ; seule la définition du job est supprimée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a(z) %@ feladatot? Az objektumtárolók érintetlenek maradnak; csak a feladatdefiníció törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %@? Gli object store non vengono toccati; viene cancellata solo la definizione del job."
          }
        },
        "ja" : {
          "stringUnit" : {
