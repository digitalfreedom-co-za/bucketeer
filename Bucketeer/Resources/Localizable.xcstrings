    "versions.delete.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version from %@ will be permanently deleted. Lifecycle rules are bypassed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version vom %@ wird endgültig gelöscht. Lifecycle-Regeln werden umgangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version du %@ sera supprimée définitivement. Les règles de cycle de vie sont ignorées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del %@ se eliminará permanentemente. Se omiten las reglas de ciclo de vida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione del %@ verrà eliminata definitivamente. Le regole di lifecycle vengono ignorate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のバージョンを完全に削除します。ライフサイクルルールは無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 의 버전이 영구적으로 삭제됩니다. 라이프사이클 규칙은 무시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versie van %@ wordt permanent verwijderd. Lifecycle-regels worden omzeild."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja z %@ zostanie trwale usunięta. Reguły cyklu życia są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de %@ será excluída permanentemente. As regras de ciclo de vida são ignoradas."
          }
        }
      }
    },
