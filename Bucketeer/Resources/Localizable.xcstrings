    "account.delete.confirm.message %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit %@? Tím se smažou uložené přihlašovací údaje z vaší klíčenky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne %@? Dette sletter de gemte adgangsoplysninger fra din nøglering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entfernen? Die gespeicherten Zugangsdaten werden aus dem Schlüsselbund gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαίρεση του %@; Αυτό διαγράφει τα αποθηκευμένα διαπιστευτήρια από την Κλειδοθήκη σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@? This deletes the saved credentials from your Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@? Esto borra las credenciales guardadas del Llavero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko %@? Tämä poistaa tallennetut tunnistetiedot avainnipusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ ? Cela efface les identifiants enregistrés du Trousseau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a(z) %@ fiókot? Ezzel törlődnek a mentett hitelesítő adatok a kulcskarikáról."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %@? Le credenziali salvate verranno cancellate dal Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除しますか?キーチェーンに保存された認証情報も削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 제거하시겠습니까? 키체인에 저장된 자격 증명이 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne %@? Dette sletter den lagrede påloggingsinformasjonen fra nøkkelringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwijderen? De opgeslagen referenties worden ook uit de Sleutelhanger verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć %@? Spowoduje to skasowanie zapisanych poświadczeń z Pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %@? Isso apaga as credenciais salvas no Acesso às Chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %@? Isto elimina as credenciais guardadas do seu porta-chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %@? Сохранённые учётные данные будут удалены из Связки ключей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort %@? Detta raderar de sparade inloggningsuppgifterna från din nyckelring."
          }
        }
      }
    },
