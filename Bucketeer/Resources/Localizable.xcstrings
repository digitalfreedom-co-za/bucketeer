    "metadata.userMetadata.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are lower-case ASCII with dashes — e.g. project-id, content-language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel sind kleinbuchstabig ASCII mit Bindestrichen — z. B. project-id, content-language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés sont en ASCII minuscule avec des tirets — p. ex. project-id, content-language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves son ASCII en minúscula con guiones — p. ej. project-id, content-language."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi sono ASCII minuscolo con trattini — es. project-id, content-language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは小文字ASCIIとハイフン（例: project-id, content-language）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 소문자 ASCII와 하이픈을 사용합니다 — 예: project-id, content-language."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels zijn ASCII in kleine letters met streepjes — bv. project-id, content-language."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze są małymi literami ASCII z myślnikami — np. project-id, content-language."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves são ASCII em minúsculas com hifens — ex.: project-id, content-language."
          }
        }
      }
