    "openWith.conflict.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ se na serveru změnil poté, co jste ho otevřeli. Vaše verze byla nahrána vedle něj jako „%2$@“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" blev ændret på serveren, efter du åbnede den. Din version blev uploadet ved siden af som \"%2$@\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wurde auf dem Server geändert, nachdem du die Datei geöffnet hast. Deine Version wurde daneben als „%2$@“ hochgeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» άλλαξε στον διακομιστή αφού το ανοίξατε. Η έκδοσή σας μεταφορτώθηκε δίπλα του ως «%2$@»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" was changed on the server after you opened it. Your version was uploaded next to it as \"%2$@\"."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" was changed on the server after you opened it. Your version was uploaded next to it as \"%2$@\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» cambió en el servidor después de que lo abrieras. Tu versión se subió junto a él como «%2$@»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostoa ”%1$@” muutettiin palvelimella sen jälkeen, kun avasit sen. Versiosi lähetettiin sen viereen nimellä ”%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a été modifié sur le serveur après son ouverture. Votre version a été téléversée à côté sous le nom « %2$@ »."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%1$@” megváltozott a szerveren, miután megnyitotta. Az Ön verzióját „%2$@” néven mellé töltöttük fel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" è stato modificato sul server dopo che l'hai aperto. La tua versione è stata caricata accanto come \"%2$@\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は、開いた後にサーバ上で変更されました。お使いのバージョンは「%2$@」としてその隣にアップロードされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" 파일은 사용자가 연 이후 서버에서 변경되었습니다. 사용자의 버전은 그 옆에 \"%2$@\"(이)라는 이름으로 업로드되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» ble endret på serveren etter at du åpnet den. Din versjon ble lastet opp ved siden av som «%2$@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’ is op de server gewijzigd nadat je het hebt geopend. Jouw versie is ernaast geüpload als ‘%2$@’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” został zmieniony na serwerze po jego otwarciu. Twoja wersja została wysłana obok jako „%2$@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" foi alterado no servidor depois que você o abriu. Sua versão foi enviada ao lado como \"%2$@\"."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" foi alterado no servidor depois de o abrir. A sua versão foi carregada ao lado como \"%2$@\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» изменился на сервере после того, как вы его открыли. Ваша версия загружена рядом под именем «%2$@»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” ändrades på servern efter att du öppnade den. Din version laddades upp bredvid som ”%2$@”."
          }
        }
      }
    },
