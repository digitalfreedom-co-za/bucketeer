    "mount.error.notProvisioned": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die File-Provider-Erweiterung ist noch nicht eingerichtet. App-Group-Entitlement und das Extension-Target müssen zuerst angelegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The File Provider extension is not yet provisioned. App Group entitlement and the extension target must be set up first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión de File Provider aún no está aprovisionada. El permiso App Group y el target de la extensión deben configurarse primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'extension File Provider n'est pas encore provisionnée. L'entitlement App Group et la cible d'extension doivent être configurés au préalable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'estensione File Provider non è ancora configurata. L'entitlement App Group e il target dell'estensione vanno impostati prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider 拡張がまだ準備されていません。先に App Group エンタイトルメントと拡張ターゲットを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "File Provider 확장이 아직 프로비저닝되지 않았습니다. 먼저 App Group 권한과 확장 타깃을 설정해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De File Provider-extensie is nog niet ingericht. App Group-entitlement en de extensietarget moeten eerst worden geconfigureerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozszerzenie File Provider nie zostało jeszcze udostępnione. Najpierw skonfiguruj uprawnienie App Group oraz cel rozszerzenia."
