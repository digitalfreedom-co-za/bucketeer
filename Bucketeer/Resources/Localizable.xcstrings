    "error.azure.dns": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure-Endpunkt konnte nicht aufgelöst werden. Speicherkontoname und ggf. eigenen Endpunkt prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resolve the Azure endpoint. Check the storage account name and any custom endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo resolver el endpoint de Azure. Verifica el nombre de la cuenta de almacenamiento y cualquier endpoint personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de résoudre le point de terminaison Azure. Vérifiez le nom du compte de stockage et tout point de terminaison personnalisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile risolvere l'endpoint Azure. Verifica il nome dell'account di archiviazione e l'eventuale endpoint personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure エンドポイントを解決できませんでした。ストレージアカウント名とカスタムエンドポイントを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Azure 엔드포인트를 확인할 수 없습니다. 스토리지 계정 이름과 사용자 지정 엔드포인트를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het Azure-eindpunt kon niet worden opgelost. Controleer de naam van het opslag-account en het eventuele aangepaste eindpunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się rozwiązać endpointu Azure. Sprawdź nazwę konta magazynu oraz ewentualny niestandardowy endpoint."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível resolver o endpoint do Azure. Verifique o nome da conta de armazenamento e qualquer endpoint personalizado."
          }
        }
      }
    },
