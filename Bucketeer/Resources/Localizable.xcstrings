    "settings.transfers.bandwidth.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caps total upload + download throughput. Accurate for Azure; best-effort for the S3 family (Soto reports byte progress in fractions only)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt den gesamten Upload- und Download-Durchsatz. Bei Azure exakt; bei der S3-Familie nur näherungsweise (Soto meldet Bytefortschritt nur in Bruchteilen)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite le débit total en téléversement + téléchargement. Précis pour Azure ; au mieux pour la famille S3 (Soto ne signale la progression qu’en fractions)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el rendimiento total de subida + descarga. Preciso para Azure; aproximado para la familia S3 (Soto sólo reporta progreso por fracciones)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita il throughput totale di upload e download. Preciso per Azure; approssimato per la famiglia S3 (Soto riporta il progresso solo in frazioni)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード／ダウンロードの合計スループットを制限します。Azureでは正確、S3系統では概算（Sotoは進捗を分数でしか返さないため）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 업로드 + 다운로드 처리량을 제한합니다. Azure에서는 정확하며 S3 계열에서는 근사치입니다(Soto는 진행률을 비율로만 보고)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beperkt totale upload- + downloaddoorvoer. Nauwkeurig voor Azure; benadering voor de S3-familie (Soto rapporteert voortgang alleen als fractie)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogranicza łączną przepustowość wysyłania + pobierania. Dokładne dla Azure; przybliżone dla rodziny S3 (Soto raportuje postęp tylko jako ułamek)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita o throughput total de upload + download. Preciso para Azure; aproximado para a família S3 (Soto reporta o progresso apenas em frações)."
          }
        }
      }
    },
