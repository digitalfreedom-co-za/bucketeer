        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름은 비워둘 수 없으며 슬래시를 포함할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navn kan ikke være tomme eller inneholde skråstreker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen mogen niet leeg zijn en geen schuine strepen bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwy nie mogą być puste ani zawierać ukośników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os nomes não podem ficar em branco nem conter barras."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
