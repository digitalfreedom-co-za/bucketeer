    "browser.account.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewähltes Konto %@. Die Bucket-Liste erscheint mit Phase 3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected account %@. Bucket listing will appear here once Phase 3 lands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta seleccionada %@. La lista de buckets aparecerá aquí cuando llegue la fase 3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte sélectionné %@. La liste des buckets apparaîtra ici dès la phase 3."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Account selezionato %@. L'elenco dei bucket comparirà qui dalla fase 3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアカウント %@。バケット一覧はフェーズ 3 以降に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 계정 %@. 버킷 목록은 3단계에서 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerd account %@. De bucketlijst verschijnt hier vanaf fase 3."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane konto %@. Lista bucketów pojawi się tutaj w fazie 3."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta selecionada %@. A lista de buckets aparecerá aqui na fase 3."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybrán účet %@. Seznam bucketů se zde objeví po dokončení fáze 3."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto %@ er valgt. Oversigten over buckets vises her, når fase 3 er klar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέχθηκε ο λογαριασμός %@. Η λίστα των bucket θα εμφανιστεί εδώ όταν ολοκληρωθεί η Φάση 3."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittu tili %@. Bucket-luettelo näkyy tässä, kun vaihe 3 valmistuu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiválasztott fiók: %@. A bucketlista itt jelenik meg, amint a 3. fázis elkészül."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgt konto: %@. Bucket-oversikten vises her når fase 3 er på plass."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta selecionada: %@. A lista de buckets aparecerá aqui quando a Fase 3 estiver disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
