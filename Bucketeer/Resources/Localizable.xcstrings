    "sync.error.nameCollision" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přeskočeno: v cílové složce se tento název shoduje s jinou položkou (liší se jen velikostí písmen nebo diakritikou). Přejmenujte jednu z nich, aby se synchronizovaly obě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprunget over: i destinationsmappen svarer navnet til et andet element (kun store/små bogstaver eller accenter er forskellige). Omdøb et af dem for at synkronisere begge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersprungen: Im Zielordner entspricht dieser Name einem anderen Objekt (nur Groß-/Kleinschreibung oder Akzente unterscheiden sich). Benenne eines davon um, damit beide synchronisiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παραλείφθηκε: στον φάκελο προορισμού αυτό το όνομα ταυτίζεται με άλλο στοιχείο (διαφέρουν μόνο πεζά/κεφαλαία ή τόνοι). Μετονομάστε ένα από τα δύο για να συγχρονιστούν και τα δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipped: in the destination folder this name matches another item (only letter case or accents differ). Rename one of them to sync both."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skipped: in the destination folder this name matches another item (only letter case or accents differ). Rename one of them to sync both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitido: en la carpeta de destino este nombre coincide con otro elemento (solo cambian mayúsculas o acentos). Cambia el nombre de uno para sincronizar ambos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohitettu: kohdekansiossa tämä nimi vastaa toista kohdetta (vain kirjainkoko tai aksentit eroavat). Nimeä toinen uudelleen, niin molemmat synkronoidaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignoré : dans le dossier de destination, ce nom correspond à un autre élément (seules la casse ou les accents diffèrent). Renommez l’un des deux pour synchroniser les deux."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kihagyva: a célmappában ez a név egy másik elemmel egyezik (csak a kis- és nagybetűk vagy az ékezetek különböznek). Nevezze át az egyiket, hogy mindkettő szinkronizálódjon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltato: nella cartella di destinazione questo nome coincide con un altro elemento (cambiano solo maiuscole o accenti). Rinomina uno dei due per sincronizzarli entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップしました：保存先フォルダでは、この名前が別の項目と一致します（大文字小文字やアクセントの違いのみ）。両方を同期するには、どちらかの名前を変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건너뜀: 대상 폴더에서 이 이름이 다른 항목과 같습니다(대소문자나 악센트만 다름). 둘 다 동기화하려면 하나의 이름을 변경하세요."
