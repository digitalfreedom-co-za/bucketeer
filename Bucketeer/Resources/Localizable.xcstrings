          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source bucket is encrypted, but the destination bucket has no encryption key. Turn on “Store unencrypted copies of encrypted files” in the job to allow this sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bucket de origen está cifrado, pero el bucket de destino no tiene clave de cifrado. Activa “Guardar copias sin cifrar de archivos cifrados” en la tarea para permitir esta sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähdebucket on salattu, mutta kohdebucketilla ei ole salausavainta. Salli tämä synkronointi ottamalla työssä käyttöön ”Tallenna salattujen tiedostojen salaamattomat kopiot”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bucket source est chiffré, mais le bucket de destination n’a pas de clé de chiffrement. Activez « Enregistrer des copies non chiffrées des fichiers chiffrés » dans la tâche pour autoriser cette synchronisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A forrás bucket titkosított, de a cél bucket nem rendelkezik titkosítási kulccsal. A szinkronizálás engedélyezéséhez kapcsolja be a feladatban a „Titkosított fájlok titkosítatlan másolatainak mentése” beállítást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il bucket di origine è crittografato, ma il bucket di destinazione non ha una chiave di crittografia. Attiva “Salva copie non crittografate dei file crittografati” nel job per consentire questa sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースのバケットは暗号化されていますが、宛先のバケットには鍵が設定されていません。この同期を許可するには、ジョブで「暗号化されたファイルを暗号化せずにコピーして保存」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스 버킷은 암호화되어 있지만 대상 버킷에는 암호화 키가 없습니다. 이 동기화를 허용하려면 작업에서 ‘암호화된 파일의 암호화되지 않은 사본 저장’을 켜십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kildebucketen er kryptert, men målbucketen har ingen krypteringsnøkkel. Slå på «Lagre ukrypterte kopier av krypterte filer» i jobben for å tillate denne synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bronbucket is versleuteld, maar de doelbucket heeft geen versleutelingssleutel. Schakel ‘Onversleutelde kopieën van versleutelde bestanden bewaren’ in bij de synchronisatie om dit toe te staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródłowy bucket jest zaszyfrowany, ale docelowy bucket nie ma klucza szyfrowania. Aby zezwolić na tę synchronizację, włącz w zadaniu opcję „Zapisuj niezaszyfrowane kopie zaszyfrowanych plików”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bucket de origem está criptografado, mas o bucket de destino não tem chave de criptografia. Ative “Salvar cópias não criptografadas de arquivos criptografados” na tarefa para permitir esta sincronização."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O bucket de origem está encriptado, mas o bucket de destino não tem chave de encriptação. Ative «Guardar cópias não encriptadas de ficheiros encriptados» na tarefa para permitir esta sincronização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исходный бакет зашифрован, но у бакета назначения нет ключа шифрования. Чтобы разрешить эту синхронизацию, включите в задании параметр «Сохранять незашифрованные копии зашифрованных файлов»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Källbucketen är krypterad, men målbucketen har ingen krypteringsnyckel. Aktivera ”Spara okrypterade kopior av krypterade filer” i jobbet för att tillåta den här synkroniseringen."
          }
        }
      }
    },
