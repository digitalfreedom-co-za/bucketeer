            "value": "링크 준비 완료 — URL이 있는 누구나 만료 전까지 다운로드할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeling klaar — iedereen met de URL kan downloaden tot deze verloopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link gotowy — każdy, kto ma URL, może pobierać do wygaśnięcia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link pronto — qualquer pessoa com a URL pode baixar até expirar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz je připraven — kdokoli s touto URL může stahovat, dokud platnost nevyprší"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linket er klar — alle med URL'en kan downloade, indtil det udløber"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο σύνδεσμος είναι έτοιμος — όποιος έχει το URL μπορεί να κάνει λήψη μέχρι να λήξει"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkki valmis — kuka tahansa URL-osoitteen haltija voi ladata, kunnes linkki vanhenee"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A link kész — az URL birtokában bárki letöltheti a lejáratig"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenken er klar — alle med URL-en kan laste ned til den utløper"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação pronta — qualquer pessoa com o URL pode descarregar até expirar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка готова — любой, у кого есть URL, может скачивать до истечения срока действия"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länken är klar — alla med URL:en kan hämta tills den upphör"
          }
        }
      }
    },
