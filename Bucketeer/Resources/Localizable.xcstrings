    "paywall.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorázovým nákupem odemkněte připojování disků, synchronizaci na pozadí, kopírování mezi účty a režim řádku nabídek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op for montering, baggrundssynkronisering, kopiering mellem konti og menulinjetilstand med et engangskøb."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem einmaligen Kauf Laufwerke einbinden, im Hintergrund synchronisieren, zwischen Konten kopieren und den Menüleisten-Modus nutzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκλειδώστε την προσάρτηση, τον συγχρονισμό στο παρασκήνιο, την αντιγραφή μεταξύ λογαριασμών και τη λειτουργία γραμμής μενού με μία εφάπαξ αγορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock mounting, background sync, cross-account copy and menubar mode with a one-time purchase."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock mounting, background sync, cross-account copy and menubar mode with a one-time purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea el montaje, la sincronización en segundo plano, la copia entre cuentas y el modo barra de menús con una compra única."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa liittäminen, taustasynkronointi, tilien välinen kopiointi ja valikkorivitila kertaostoksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez le montage, la synchronisation en arrière-plan, la copie entre comptes et le mode barre des menus avec un achat unique."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszeri vásárlással feloldhatja a csatolást, a háttérszinkronizálást, a fiókok közötti másolást és a menüsoros módot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sblocca il montaggio, la sincronizzazione in background, la copia tra account e la modalità barra dei menu con un acquisto unico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の購入で、マウント、バックグラウンド同期、アカウント間コピー、メニューバーモードが使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 구입으로 마운트, 백그라운드 동기화, 계정 간 복사, 메뉴 막대 모드를 이용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås opp montering, bakgrunnssynkronisering, kopiering mellom kontoer og menylinjemodus med et engangskjøp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
