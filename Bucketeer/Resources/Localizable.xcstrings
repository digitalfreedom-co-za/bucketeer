    "autoTag.glob.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty matches every filename. Use * and ? for wildcards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer = jede Datei. * und ? sind Platzhalter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide = tout fichier. * et ? sont des jokers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío = cualquier archivo. * y ? son comodines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto = qualsiasi file. * e ? sono caratteri jolly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄ですべてのファイル名にマッチ。* と ? はワイルドカード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워두면 모든 파일명에 일치. * 와 ? 는 와일드카드."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeg matcht elke bestandsnaam. * en ? zijn jokers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusty = każda nazwa. * i ? to znaki wieloznaczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio = qualquer arquivo. * e ? são curingas."
          }
        }
      }
    },
