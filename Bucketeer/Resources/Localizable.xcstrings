    "paywall.trial.terms %lld %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkušební verze je zdarma a trvá %1$#@days@. Poté přestanou fungovat výše uvedené funkce Pro, Bucketeer se vrátí k bezplatné verzi a nic se neúčtuje. Pro doživotně je jednorázový nákup za %2$@."
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg den"
                    }
                  },
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg dny"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg dní"
                    }
                  }
                }
              }
            }
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøveperioden er gratis og varer %1$#@days@. Derefter holder Pro-funktionerne ovenfor op med at virke, Bucketeer går tilbage til gratisversionen, og der opkræves intet. Pro Livstid er et engangskøb til %2$@."
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg dag"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg dage"
                    }
                  }
                }
              }
            }
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Testphase ist kostenlos und dauert %1$#@days@. Danach funktionieren die oben genannten Pro-Funktionen nicht mehr, Bucketeer läuft als kostenlose Version weiter und es wird nichts berechnet. Pro für immer ist ein einmaliger Kauf für %2$@."
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Tag"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg Tage"
                    }
                  }
                }
              }
            }
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δοκιμή είναι δωρεάν και διαρκεί %1$#@days@. Μετά οι λειτουργίες Pro που αναφέρονται παραπάνω σταματούν να λειτουργούν, το Bucketeer επιστρέφει στη δωρεάν έκδοση και δεν γίνεται καμία χρέωση. Το Pro εφ' όρου ζωής είναι εφάπαξ αγορά στην τιμή %2$@."
          },
          "substitutions" : {
            "days" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
