    "sync.delete.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazání při zrcadlení se provádí jako poslední, takže přechodná chyba porovnání nikdy nezpůsobí ztrátu dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletninger ved spejling udføres til sidst, så en midlertidig sammenligningsfejl aldrig fører til datatab."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschungen im Spiegelmodus werden zuletzt ausgeführt, damit ein vorübergehender Vergleichsfehler nie zu Datenverlust führt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διαγραφές κατοπτρισμού εφαρμόζονται τελευταίες, ώστε ένα παροδικό σφάλμα σύγκρισης να μην προκαλεί ποτέ απώλεια δεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror deletes are applied last so a transient compare error never loses data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror deletes are applied last so a transient compare error never loses data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En modo espejo, las eliminaciones se aplican al final para que un error temporal de comparación nunca provoque pérdida de datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peilauksen poistot tehdään viimeisenä, joten tilapäinen vertailuvirhe ei koskaan johda tietojen menetykseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppressions miroir sont appliquées en dernier — une erreur transitoire de comparaison ne perd jamais de données."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tükrözési törlések a legvégén futnak le, így egy átmeneti összehasonlítási hiba sem okozhat adatvesztést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nella modalità Rispecchia le eliminazioni vengono applicate per ultime, così un errore temporaneo di confronto non causa mai perdite di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミラー削除は最後に適用されるため、一時的な比較エラーでもデータが失われることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미러 삭제는 마지막에 적용되므로 일시적인 비교 오류로 데이터가 손실되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettinger ved speiling utføres til slutt, slik at en midlertidig sammenligningsfeil aldri fører til datatap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderingen bij spiegelen worden als laatste uitgevoerd, zodat een tijdelijke vergelijkingsfout nooit tot gegevensverlies leidt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcia w trybie kopii lustrzanej są wykonywane na końcu, aby chwilowy błąd porównania nigdy nie spowodował utraty danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exclusões em modo espelho são aplicadas por último para que um erro temporário de comparação nunca perca dados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As eliminações em modo espelho são aplicadas no fim, para que um erro transitório de comparação nunca cause perda de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаления при зеркалировании применяются в последнюю очередь, поэтому временная ошибка сравнения никогда не приводит к потере данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speglingsraderingar tillämpas sist så att ett tillfälligt jämförelsefel aldrig leder till dataförlust."
          }
        }
      }
    },
    "sync.diff.localHint" : {
