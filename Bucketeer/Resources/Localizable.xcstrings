  "strings": {
    "%@/%@": {
      "comment": "A label displaying the name of a bucket and the key name of an object in that bucket. The first argument is the name of the bucket. The second argument is the key name of the object.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@/%2$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A badge that shows the number of active transfers.",
      "isCommentAutoGenerated": true
    },
