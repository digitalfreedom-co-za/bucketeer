    "dashboard.truncated.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing partial totals after %lld pages — bucket is larger than the dashboard cap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil-Summen nach %lld Seiten — der Bucket übersteigt das Dashboard-Limit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaux partiels après %lld pages — le bucket dépasse le plafond du tableau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Totales parciales tras %lld páginas — el bucket supera el límite del panel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Totali parziali dopo %lld pagine — il bucket supera il limite del dashboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ページの集計のみ表示中。バケットがダッシュボードの上限を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 페이지까지만 집계됨 — 버킷이 대시보드 한계를 초과합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedeeltelijke totalen na %lld pagina’s — bucket overschrijdt de limiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Częściowe sumy po %lld stronach — bucket przekracza limit pulpitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Totais parciais após %lld páginas — o bucket excede o limite do painel."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po %lld stránkách jsou zobrazeny jen částečné součty — bucket je větší než limit přehledu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser delvise totaler efter %lld sider — bucketen er større end dashboardets grænse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζονται μερικά σύνολα μετά από %lld σελίδες — το bucket είναι μεγαλύτερο από το όριο του πίνακα ελέγχου."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään osittaiset summat %lld sivun jälkeen — bucket on koontinäytön rajaa suurempi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Részleges összesítés %lld oldal után — a bucket nagyobb az irányítópult korlátjánál."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser delvise totaler etter %lld sider — bucketen er større enn dashbord-grensen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A mostrar totais parciais após %lld páginas — o bucket é maior do que o limite do painel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны частичные итоги после %lld страниц — бакет больше, чем ограничение панели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar ofullständiga summor efter %lld sidor — bucketen är större än översiktens gräns."
          }
        }
      }
    },
