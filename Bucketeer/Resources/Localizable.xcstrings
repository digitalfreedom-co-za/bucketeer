    "dashboard.cost.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard storage tier only — ignores requests, egress and tier transitions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Standard-Speichertier — Anfragen, Egress und Klassenwechsel sind nicht eingerechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveau de stockage standard uniquement — ignore les requêtes, la sortie et les transitions de classe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo nivel de almacenamiento estándar — ignora peticiones, salida y cambios de clase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tier di archiviazione standard — ignora richieste, egress e cambi di classe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンダードストレージのみ。リクエスト・エグレス・階層変動は考慮されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표준 스토리지 계층 전용 — 요청, 송신, 계층 전환은 무시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen standaard-opslagniveau — exclusief verzoeken, uitgaand verkeer en niveau-overgangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko standardowy poziom — pomija żądania, ruch wychodzący i przejścia między klasami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas tier de armazenamento padrão — ignora requisições, egresso e transições de classe."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze standardní úroveň úložiště — nezahrnuje požadavky, odchozí přenosy ani přechody mezi úrovněmi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun standardlagertrin — ignorerer forespørgsler, udgående trafik og trinovergange."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο βαθμίδα τυπικής αποθήκευσης — δεν συνυπολογίζει αιτήματα, εξερχόμενη κίνηση και μεταβάσεις βαθμίδων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain vakiotallennustaso — ei huomioi pyyntöjä, ulossiirtoja eikä tasosiirtymiä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak a standard tárolási szint — a kérések, a kimenő forgalom és a szintváltások nélkül."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare standard lagringsnivå — ser bort fra forespørsler, utgående trafikk og nivåoverganger."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o nível de armazenamento standard — ignora pedidos, tráfego de saída e transições de nível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только стандартный класс хранения — без учёта запросов, исходящего трафика и переходов между классами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast standardlagringsnivån — bortser från förfrågningar, utgående trafik och nivåövergångar."
          }
        }
      }
    },
