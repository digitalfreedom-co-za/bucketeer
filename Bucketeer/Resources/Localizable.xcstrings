          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto czytnika. Podłącz YubiKey lub czytnik kart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum leitor detectado. Conecte um YubiKey ou leitor de cartão."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyla zjištěna žádná čtečka. Připojte YubiKey nebo čtečku čipových karet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen læser registreret. Tilslut en YubiKey eller en smartcard-læser."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν εντοπίστηκε αναγνώστης. Συνδέστε ένα YubiKey ή έναν αναγνώστη έξυπνων καρτών."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
