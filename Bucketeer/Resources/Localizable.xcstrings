    "sync.diff.localHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local folders have no ETag. Name + size is the only viable diff strategy for cross-system syncs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Ordner haben keinen ETag. Name + Größe ist die einzige sinnvolle Vergleichsstrategie für system-übergreifende Syncs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas locales no tienen ETag. Nombre + tamaño es la única estrategia de comparación viable para sincronizaciones entre sistemas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers locaux n'ont pas d'ETag. Nom + taille est la seule stratégie de comparaison viable pour des synchronisations entre systèmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle locali non hanno ETag. Nome + dimensione è l'unica strategia di confronto utilizzabile per sincronizzazioni fra sistemi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルフォルダには ETag がありません。クロスシステム同期では名前+サイズが唯一実用的な比較方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 폴더에는 ETag가 없습니다. 시스템 간 동기화에는 이름 + 크기 비교만 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale mappen hebben geen ETag. Naam + grootte is de enige werkbare vergelijking voor synchronisaties tussen systemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne foldery nie mają ETag. Nazwa + rozmiar to jedyna sensowna strategia porównania dla synchronizacji między systemami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas locais não têm ETag. Nome + tamanho é a única estratégia de comparação viável para sincronizações entre sistemas."
          }
        }
      }
    },
