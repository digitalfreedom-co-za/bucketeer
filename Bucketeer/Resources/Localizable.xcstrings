    "browser.action.delete.confirm.multi %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte aus diesem Bucket löschen? Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld objects from this bucket? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %lld objetos de este bucket? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %lld objets de ce bucket ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %lld oggetti da questo bucket? L'azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバケットから %lld 個のオブジェクトを削除しますか?この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버킷에서 %lld개의 객체를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld objecten uit deze bucket verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %lld obiektów z tego bucketu? Operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %lld objetos deste bucket? Esta ação não pode ser desfeita."
          }
        }
      }
    },
