    "settings.menubar.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt das Dock-Symbol und lässt Bucketeer in der Menüleiste laufen, auch wenn das Hauptfenster geschlossen ist. Eingebundene Laufwerke und Synchronisationen bleiben aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the Dock icon and keeps Bucketeer alive in the menu bar while the main window is closed. Mounted drives and sync jobs stay running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el icono del Dock y mantiene Bucketeer activo en la barra de menús mientras la ventana principal está cerrada. Las unidades montadas y las sincronizaciones siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime l'icône du Dock et maintient Bucketeer actif dans la barre de menus lorsque la fenêtre principale est fermée. Les volumes montés et les synchronisations restent actifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove l'icona dal Dock e mantiene Bucketeer attivo nella barra dei menu mentre la finestra principale è chiusa. Le unità montate e le sincronizzazioni continuano a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock アイコンを非表示にし、メインウィンドウを閉じてもメニューバーで Bucketeer を動かし続けます。マウント済みドライブと同期ジョブはそのまま稼働します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 아이콘을 제거하고 메인 창이 닫혀 있는 동안에도 Bucketeer를 메뉴 막대에서 계속 실행합니다. 마운트된 드라이브와 동기화 작업은 계속 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbergt het Dock-icoon en houdt Bucketeer actief in de menubalk terwijl het hoofdvenster gesloten is. Gekoppelde volumes en synchronisaties blijven actief."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa ikonę z Docka i utrzymuje Bucketeer aktywny w pasku menu, gdy główne okno jest zamknięte. Zamontowane dyski i zadania synchronizacji nadal działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o ícone do Dock e mantém o Bucketeer ativo na barra de menus enquanto a janela principal está fechada. Unidades montadas e sincronizações continuam em execução."
          }
        }
      }
    },
