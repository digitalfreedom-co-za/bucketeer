    "browser.action.delete.confirm.multi %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Objekte aus diesem Bucket löschen? Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %lld objects from this bucket? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %lld objetos de este bucket? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %lld objets de ce bucket ? Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %lld oggetti da questo bucket? L'azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバケットから %lld 個のオブジェクトを削除しますか?この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버킷에서 %lld개의 객체를 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld objecten uit deze bucket verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %lld obiektów z tego bucketu? Operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %lld objetos deste bucket? Esta ação não pode ser desfeita."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat z tohoto bucketu vybrané objekty (%lld)? Tuto akci nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette %lld objekter fra denne bucket? Dette kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή %lld αντικειμένων από αυτό το bucket; Αυτή η ενέργεια δεν μπορεί να αναιρεθεί."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %lld objektia tästä bucketista? Tätä ei voi perua."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törli a(z) %lld objektumot ebből a bucketből? A művelet nem vonható vissza."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du slette %lld objekter fra denne bucketen? Dette kan ikke angres."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %lld objetos deste bucket? Esta ação não pode ser anulada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %lld объектов из этого бакета? Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera %lld objekt från den här bucketen? Detta kan inte ångras."
          }
        }
      }
    },
