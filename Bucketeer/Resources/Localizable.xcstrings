    "encryption.editor.bucketInvalid" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte 3–63 malých písmen, číslic, teček nebo pomlček; na začátku a na konci musí být písmeno nebo číslice. Bez dvou teček za sebou, bez IP adresy a bez vyhrazené předpony nebo přípony, např. xn-- nebo -s3alias."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug 3–63 små bogstaver, tal, punktummer eller bindestreger, der starter og slutter med et bogstav eller tal. Ingen to punktummer i træk, ingen IP-adresse og intet reserveret præfiks eller suffiks som xn-- eller -s3alias."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende 3–63 Kleinbuchstaben, Ziffern, Punkte oder Bindestriche, beginnend und endend mit einem Buchstaben oder einer Ziffer. Keine zwei Punkte hintereinander, keine IP-Adresse und kein reserviertes Präfix oder Suffix wie xn-- oder -s3alias."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε 3–63 πεζά γράμματα, ψηφία, τελείες ή παύλες, με γράμμα ή ψηφίο στην αρχή και στο τέλος. Όχι δύο τελείες στη σειρά, όχι διεύθυνση IP και όχι δεσμευμένο πρόθεμα ή επίθημα όπως xn-- ή -s3alias."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 3–63 lowercase letters, digits, dots or hyphens, starting and ending with a letter or digit. No two dots in a row, no IP address and no reserved prefix or suffix such as xn-- or -s3alias."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use 3–63 lower-case letters, digits, full stops or hyphens, starting and ending with a letter or digit. No two full stops in a row, no IP address and no reserved prefix or suffix such as xn-- or -s3alias."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa entre 3 y 63 letras minúsculas, dígitos, puntos o guiones, empezando y terminando por una letra o un dígito. Sin dos puntos seguidos, sin formato de dirección IP y sin prefijos ni sufijos reservados como xn-- o -s3alias."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä 3–63 pientä kirjainta, numeroa, pistettä tai yhdysmerkkiä. Ensimmäisen ja viimeisen merkin on oltava kirjain tai numero. Ei kahta pistettä peräkkäin, ei IP-osoitetta eikä varattua etu- tai jälkiliitettä, kuten xn-- tai -s3alias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez 3 à 63 lettres minuscules, chiffres, points ou traits d’union, en commençant et en terminant par une lettre ou un chiffre. Pas deux points consécutifs, pas d’adresse IP ni de préfixe ou suffixe réservé comme xn-- ou -s3alias."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–63 kisbetűt, számjegyet, pontot vagy kötőjelet használjon; az első és az utolsó karakter betű vagy számjegy legyen. Nem lehet benne két egymást követő pont, nem lehet IP-cím, és nem lehet fenntartott előtag vagy utótag, például xn-- vagy -s3alias."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa da 3 a 63 lettere minuscole, cifre, punti o trattini, iniziando e terminando con una lettera o una cifra. Niente due punti consecutivi, niente indirizzo IP e nessun prefisso o suffisso riservato come xn-- o -s3alias."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小文字、数字、ピリオド、ハイフンを3〜63文字で入力し、先頭と末尾は英字か数字にしてください。連続したピリオド、IPアドレス形式、xn-- や -s3alias などの予約済みの接頭辞・接尾辞は使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소문자, 숫자, 마침표, 하이픈으로 3~63자를 사용하고, 처음과 끝은 문자나 숫자여야 합니다. 마침표를 연속으로 쓰거나 IP 주소 형식, xn-- 또는 -s3alias 같은 예약된 접두사·접미사는 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk 3–63 små bokstaver, sifre, punktum eller bindestreker, som starter og slutter med en bokstav eller et siffer. Ikke to punktum etter hverandre, ingen IP-adresse og ingen reservert prefiks eller suffiks som xn-- eller -s3alias."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik 3–63 kleine letters, cijfers, punten of koppeltekens, beginnend en eindigend met een letter of cijfer. Geen twee punten achter elkaar, geen IP-adres en geen gereserveerd voor- of achtervoegsel zoals xn-- of -s3alias."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj 3–63 małych liter, cyfr, kropek lub łączników; pierwszy i ostatni znak musi być literą lub cyfrą. Bez dwóch kropek z rzędu, bez adresu IP i bez zastrzeżonych przedrostków ani przyrostków, np. xn-- lub -s3alias."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use de 3 a 63 letras minúsculas, dígitos, pontos ou hifens, começando e terminando com uma letra ou um dígito. Sem dois pontos seguidos, sem formato de endereço IP e sem prefixos ou sufixos reservados como xn-- ou -s3alias."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize 3 a 63 letras minúsculas, algarismos, pontos ou hífenes, começando e terminando com uma letra ou um algarismo. Sem dois pontos seguidos, sem formato de endereço IP e sem prefixos ou sufixos reservados como xn-- ou -s3alias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте 3–63 строчные буквы, цифры, точки или дефисы; первый и последний символ — буква или цифра. Без двух точек подряд, без формата IP-адреса и без зарезервированных префиксов или суффиксов, например xn-- или -s3alias."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd 3–63 gemener, siffror, punkter eller bindestreck, som börjar och slutar med en bokstav eller siffra. Inga två punkter i rad, ingen IP-adress och inget reserverat prefix eller suffix som xn-- eller -s3alias."
          }
        }
      }
    },
