    "browser.action.newFolder.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnernamen dürfen nicht leer sein oder Schrägstriche enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder names cannot be empty or contain slashes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre de la carpeta no puede estar vacío ni contener barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de dossier ne peuvent pas être vides ni contenir de barres obliques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle cartelle non possono essere vuoti né contenere barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ名は空にもスラッシュ入りにもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 이름은 비워둘 수 없으며 슬래시를 포함할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapnamen mogen niet leeg zijn en geen schuine strepen bevatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy folderów nie mogą być puste ani zawierać ukośników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes das pastas não podem ficar em branco nem conter barras."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Názvy složek nesmí být prázdné ani obsahovat lomítka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappenavne må ikke være tomme eller indeholde skråstreger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ονόματα φακέλων δεν μπορούν να είναι κενά ή να περιέχουν καθέτους."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kansion nimi ei voi olla tyhjä eikä sisältää vinoviivoja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mappanév nem lehet üres, és nem tartalmazhat perjelet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappenavn kan ikke være tomme eller inneholde skråstreker."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes de pastas não podem estar vazios nem conter barras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя папки не может быть пустым или содержать косую черту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappnamn kan inte vara tomma eller innehålla snedstreck."
