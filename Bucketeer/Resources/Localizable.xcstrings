    "versions.restore.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version from %@ will become the new latest copy. The previous latest is preserved as an older version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version vom %@ wird zur neuen aktuellen Kopie. Die bisherige aktuelle Version bleibt als ältere Version erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version du %@ deviendra la nouvelle copie actuelle. L’ancienne actuelle est conservée comme version antérieure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del %@ se convertirá en la copia actual. La copia actual anterior se conserva como versión anterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione del %@ diventerà la nuova copia attuale. La precedente attuale viene conservata come versione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のバージョンが新しい最新コピーになります。以前の最新は古いバージョンとして保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 의 버전이 새 최신 사본이 됩니다. 이전 최신본은 이전 버전으로 보존됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versie van %@ wordt de nieuwe huidige kopie. De vorige huidige wordt bewaard als oudere versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja z %@ stanie się nową aktualną kopią. Poprzednia aktualna jest zachowywana jako starsza wersja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de %@ se tornará a cópia mais recente. A versão anterior é preservada como versão antiga."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Verze z %@ se stane novou nejnovější kopií. Předchozí nejnovější zůstane zachována jako starší verze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionen fra %@ bliver den nye seneste kopi. Den hidtidige seneste bevares som en ældre version."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η έκδοση από %@ θα γίνει το νέο πιο πρόσφατο αντίγραφο. Η προηγούμενη πιο πρόσφατη διατηρείται ως παλαιότερη έκδοση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Versio ajalta %@ nousee uusimmaksi kopioksi. Aiempi uusin säilyy vanhempana versiona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ időpontból származó verzió lesz az új legfrissebb másolat. A korábbi legfrissebb régebbi verzióként megmarad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Versjonen fra %@ blir den nye nyeste kopien. Den forrige nyeste bevares som en eldre versjon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão de %@ passará a ser a nova cópia mais recente. A anterior mais recente é preservada como versão mais antiga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия от %@ станет новой последней копией. Предыдущая последняя версия сохраняется как более старая."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionen från %@ blir den nya senaste kopian. Den tidigare senaste bevaras som en äldre version."
          }
        }
      }
    },
