    "autoTag.glob.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty matches every filename. Use * and ? for wildcards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer = jede Datei. * und ? sind Platzhalter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide = tout fichier. * et ? sont des jokers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío = cualquier archivo. * y ? son comodines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto = qualsiasi file. * e ? sono caratteri jolly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄ですべてのファイル名にマッチ。* と ? はワイルドカード。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워두면 모든 파일명에 일치. * 와 ? 는 와일드카드."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeg matcht elke bestandsnaam. * en ? zijn jokers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusty = każda nazwa. * i ? to znaki wieloznaczne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio = qualquer arquivo. * e ? são curingas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné odpovídá každému názvu souboru. Pro zástupné znaky použijte * a ?."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom matcher alle filnavne. Brug * og ? som wildcards."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κενό ταιριάζει με κάθε όνομα αρχείου. Χρησιμοποιήστε * και ? ως χαρακτήρες μπαλαντέρ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjä vastaa kaikkia tiedostonimiä. Käytä jokerimerkkejä * ja ?."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üresen minden fájlnévre illeszkedik. Helyettesítő karakterek: * és ?."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomt samsvarer med alle filnavn. Bruk * og ? som jokertegn."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio corresponde a todos os nomes de ficheiro. Use * e ? como carateres universais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустое значение соответствует любому имени файла. Используйте * и ? как подстановочные символы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomt matchar alla filnamn. Använd * och ? som jokertecken."
          }
        }
      }
    },
