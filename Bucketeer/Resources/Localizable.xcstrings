          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The credentials for this account are missing. Edit the account and enter the access key and secret key again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The credentials for this account are missing. Edit the account and enter the access key and secret key again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
