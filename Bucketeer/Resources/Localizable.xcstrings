    "autoTag.glob.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prázdné odpovídá každému názvu souboru. Pro zástupné znaky použijte * a ?."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tom matcher alle filnavne. Brug * og ? som wildcards."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer = jede Datei. * und ? sind Platzhalter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κενό ταιριάζει με κάθε όνομα αρχείου. Χρησιμοποιήστε * και ? ως χαρακτήρες μπαλαντέρ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empty matches every filename. Use * and ? for wildcards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacío = cualquier archivo. * y ? son comodines."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhjä vastaa kaikkia tiedostonimiä. Käytä jokerimerkkejä * ja ?."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vide = tout fichier. * et ? sont des jokers."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üresen minden fájlnévre illeszkedik. Helyettesítő karakterek: * és ?."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
