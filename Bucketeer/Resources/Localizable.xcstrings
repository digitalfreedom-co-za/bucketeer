        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppet over: i målmappen tilsvarer dette navnet et annet element (bare store/små bokstaver eller aksenter er ulike). Gi et av dem nytt navn for å synkronisere begge."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgeslagen: in de doelmap komt deze naam overeen met een ander onderdeel (alleen hoofdletters of accenten verschillen). Wijzig de naam van een van beide om ze allebei te synchroniseren."
          }
