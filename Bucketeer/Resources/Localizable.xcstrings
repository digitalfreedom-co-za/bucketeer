    "browser.action.rename.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejmenování zkopíruje objekt na straně serveru a smaže původní. Velké objekty (> 5 GB) a přejmenování napříč poskytovateli nejsou ve v1 podporovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdøbning kopierer objektet på serversiden og sletter originalen. Store objekter (> 5 GB) og omdøbning på tværs af udbydere understøttes ikke i v1."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umbenennen kopiert serverseitig und löscht das Original. Objekte über 5 GB und anbieterübergreifende Umbenennungen werden in v1 nicht unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μετονομασία αντιγράφει το αντικείμενο στην πλευρά του διακομιστή και διαγράφει το πρωτότυπο. Μεγάλα αντικείμενα (> 5 GB) και μετονομασίες μεταξύ παρόχων δεν υποστηρίζονται στην έκδοση v1."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rename copies the object server-side and deletes the original. Large objects (> 5 GB) and cross-provider renames are not supported in v1."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rename copies the object server-side and deletes the original. Large objects (> 5 GB) and cross-provider renames are not supported in v1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renombrar copia el objeto en el servidor y elimina el original. Los objetos grandes (> 5 GB) y los cambios de nombre entre proveedores no se admiten en la v1."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudelleennimeäminen kopioi objektin palvelinpuolella ja poistaa alkuperäisen. Suuria objekteja (> 5 Gt) ja palveluntarjoajien välisiä uudelleennimeämisiä ei tueta versiossa 1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renommer copie l'objet côté serveur puis supprime l'original. Les objets volumineux (> 5 Go) et les renommages entre fournisseurs ne sont pas pris en charge dans la v1."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az átnevezés a szerveroldalon másolja az objektumot, majd törli az eredetit. A nagy objektumok (> 5 GB) és a szolgáltatók közötti átnevezés a v1-ben nem támogatott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rinomina copia l'oggetto lato server ed elimina l'originale. Oggetti grandi (> 5 GB) e rinomine fra provider non sono supportati nella v1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前を変更すると、サーバ側でオブジェクトをコピーしてから元のオブジェクトを削除します。5 GB を超えるオブジェクトや、プロバイダをまたぐ名前変更は v1 ではサポートされていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름 변경은 서버에서 객체를 복사한 다음 원본을 삭제합니다. 5 GB가 넘는 큰 객체나 공급자 간 이름 변경은 v1에서 지원되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi nytt navn kopierer objektet på serversiden og sletter originalen. Store objekter (> 5 GB) og navneendring på tvers av leverandører støttes ikke i v1."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hernoemen kopieert het object op de server en verwijdert het origineel. Grote objecten (> 5 GB) en hernoemen tussen providers worden niet ondersteund in v1."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana nazwy kopiuje obiekt po stronie serwera, a następnie usuwa oryginał. Duże obiekty (> 5 GB) i zmiana nazwy między dostawcami nie są obsługiwane w v1."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renomear copia o objeto no servidor e exclui o original. Objetos grandes (> 5 GB) e renomeações entre provedores não são suportados na v1."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudar o nome copia o objeto do lado do servidor e elimina o original. Objetos grandes (> 5 GB) e mudanças de nome entre fornecedores não são suportados na v1."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переименование копирует объект на стороне сервера и удаляет оригинал. Большие объекты (> 5 ГБ) и переименование между провайдерами в v1 не поддерживаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namnbyte kopierar objektet på serversidan och raderar originalet. Stora objekt (> 5 GB) och namnbyten mellan leverantörer stöds inte i v1."
          }
        }
      }
    },
