    "browser.empty.buckets.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto enthält noch keine Buckets oder die aktuellen Zugangsdaten sehen keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account has no buckets yet, or none are visible with the current credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no tiene buckets aún, o no son visibles con las credenciales actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte n'a pas encore de buckets, ou aucun n'est visible avec les identifiants actuels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account non ha ancora bucket, oppure non sono visibili con le credenziali attuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにはまだバケットがないか、現在の認証情報では表示できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정에는 아직 버킷이 없거나 현재 자격 증명으로는 표시할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit account heeft nog geen buckets, of geen zijn zichtbaar met de huidige referenties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To konto nie ma jeszcze bucketów albo żadne nie są widoczne z bieżącymi poświadczeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta ainda não tem buckets, ou nenhum é visível com as credenciais atuais."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento účet zatím nemá žádné buckety, nebo žádné nejsou s aktuálními přihlašovacími údaji viditelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne konto har ingen buckets endnu, eller ingen er synlige med de aktuelle adgangsoplysninger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός ο λογαριασμός δεν έχει ακόμη buckets ή κανένα δεν είναι ορατό με τα τρέχοντα διαπιστευτήρια."
