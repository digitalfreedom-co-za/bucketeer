    "hardwareKey.status.searching": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reader detected. Plug in a YubiKey or smartcard reader."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Leser erkannt. YubiKey oder Smartcard-Reader anschließen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun lecteur détecté. Branchez une YubiKey ou un lecteur de carte à puce."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha detectado un lector. Conecta una YubiKey o lector de tarjeta."
          }
