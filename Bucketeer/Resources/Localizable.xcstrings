          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέτει ένα τοπικό αρχείο στην ουρά για μεταφόρτωση στο επιλεγμένο bucket. Η μεταφόρτωση εκτελείται στο παρασκήνιο."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queues a local file for upload to the chosen bucket. The upload runs in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pone en cola un archivo local para subirlo al bucket elegido. La subida se realiza en segundo plano."
