    "transfers.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Up- und Downloads erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploaded and downloaded files will appear here while they are in flight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos subidos y descargados aparecerán aquí mientras se transfieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers téléversés et téléchargés apparaîtront ici pendant leur transfert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file caricati e scaricati appariranno qui durante il trasferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード中・ダウンロード中のファイルがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드와 다운로드 중인 파일이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geüploade en gedownloade bestanden verschijnen hier tijdens overdracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesyłane i pobierane pliki pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos enviados e baixados aparecerão aqui durante a transferência."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávané a stahované soubory se zde zobrazí, dokud přenos probíhá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploadede og downloadede filer vises her, mens de er i gang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αρχεία που μεταφορτώνονται και λαμβάνονται θα εμφανίζονται εδώ όσο βρίσκονται σε εξέλιξη."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetettävät ja ladattavat tiedostot näkyvät tässä siirron aikana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feltöltött és letöltött fájlok itt jelennek meg, amíg folyamatban vannak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplastede og nedlastede filer vises her mens de er underveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros carregados e descarregados aparecerão aqui enquanto estiverem em curso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь будут отображаться файлы, которые сейчас загружаются или скачиваются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdade och hämtade filer visas här medan överföringen pågår."
