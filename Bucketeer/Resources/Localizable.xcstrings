    "encryption.editor.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíč bezpečně uložte — jeho ztráta trvale uzamkne všechny objekty, které jím byly zašifrovány. Bucketeer ztracené klíče obnovit nedokáže."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem nøglen et sikkert sted — mistes den, låses alle objekter krypteret med den permanent. Bucketeer kan ikke gendanne mistede nøgler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre den Schlüssel sicher auf — geht er verloren, bleiben alle damit verschlüsselten Objekte dauerhaft gesperrt. Bucketeer kann verlorene Schlüssel nicht wiederherstellen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φυλάξτε το κλειδί με ασφάλεια — η απώλειά του κλειδώνει οριστικά κάθε αντικείμενο που κρυπτογραφήθηκε με αυτό. Το Bucketeer δεν μπορεί να ανακτήσει χαμένα κλειδιά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the key safely — losing it permanently locks any object encrypted with it. Bucketeer cannot recover lost keys."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the key safely — losing it permanently locks any object encrypted with it. Bucketeer cannot recover lost keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la clave en un lugar seguro: si la pierdes, los objetos cifrados con ella quedan bloqueados para siempre. Bucketeer no puede recuperar claves perdidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna avain turvallisesti — sen kadottaminen lukitsee pysyvästi kaikki sillä salatut objektit. Bucketeer ei voi palauttaa kadonneita avaimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez la clé en sécurité — la perdre verrouille définitivement les objets chiffrés avec elle. Bucketeer ne peut pas la récupérer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentse el a kulcsot biztonságos helyre — elvesztése véglegesen zárolja az összes vele titkosított objektumot. A Bucketeer nem tudja helyreállítani az elveszett kulcsokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la chiave in un luogo sicuro — se la perdi, gli oggetti crittografati con essa restano bloccati per sempre. Bucketeer non può recuperare le chiavi perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵は安全な場所に保管してください — 紛失すると、その鍵で暗号化されたオブジェクトには永久にアクセスできなくなります。Bucketeer は紛失した鍵を復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 안전하게 보관하십시오 — 키를 분실하면 해당 키로 암호화된 모든 객체에 영구적으로 접근할 수 없습니다. Bucketeer는 분실된 키를 복구할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta godt vare på nøkkelen — mister du den, låses alle objekter som er kryptert med den, permanent. Bucketeer kan ikke gjenopprette tapte nøkler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar de sleutel veilig — als je hem kwijtraakt, blijven alle hiermee versleutelde objecten permanent ontoegankelijk. Bucketeer kan verloren sleutels niet herstellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj klucz bezpiecznie — utrata trwale blokuje wszystkie obiekty zaszyfrowane tym kluczem. Bucketeer nie może go odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde a chave em segurança — perdê-la bloqueia permanentemente os objetos criptografados com ela. O Bucketeer não pode recuperar chaves perdidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde a chave em segurança — perdê-la bloqueia permanentemente qualquer objeto encriptado com ela. O Bucketeer não consegue recuperar chaves perdidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните ключ в надёжном месте — его утрата навсегда заблокирует все зашифрованные им объекты. Bucketeer не может восстановить утерянные ключи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara nyckeln på ett säkert ställe — om du förlorar den låses alla objekt som krypterats med den permanent. Bucketeer kan inte återskapa förlorade nycklar."
          }
        }
      }
    },
    "encryption.empty.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte klíč pro transparentní šifrování každého nahrání do jednoho z vašich bucketů. Stahování ze stejného bucketu se dešifruje za běhu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en nøgle for transparent at kryptere alle uploads til en af dine buckets. Downloads fra samme bucket dekrypteres løbende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege einen Schlüssel an, um jeden Upload in einen deiner Buckets transparent zu verschlüsseln. Downloads aus demselben Bucket werden automatisch entschlüsselt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ένα κλειδί για διαφανή κρυπτογράφηση κάθε μεταφόρτωσης σε ένα από τα buckets σας. Οι λήψεις από το ίδιο bucket αποκρυπτογραφούνται αυτόματα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a key to encrypt every upload to one of your buckets transparently. Downloads from the same bucket are decrypted on the fly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a key to encrypt every upload to one of your buckets transparently. Downloads from the same bucket are decrypted on the fly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una clave para cifrar de forma transparente cada subida a uno de tus buckets. Las descargas se descifran sobre la marcha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää avain, niin kaikki lähetykset johonkin bucketeistasi salataan automaattisesti. Lataukset samasta bucketista puretaan lennossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une clé pour chiffrer chaque téléversement vers un de vos buckets de manière transparente. Les téléchargements sont déchiffrés à la volée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon hozzá egy kulcsot, és a Bucketeer automatikusan titkosít minden feltöltést az adott bucketbe. Az ugyanabból a bucketből letöltött fájlokat menet közben visszafejti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una chiave per crittografare in modo trasparente ogni caricamento verso uno dei tuoi bucket. I download dallo stesso bucket vengono decrittografati al volo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵を追加すると、対象のバケットへのアップロードがすべて自動的に暗号化されます。同じバケットからのダウンロードはその場で復号されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키를 추가하면 해당 버킷으로의 모든 업로드가 자동으로 암호화됩니다. 같은 버킷에서 다운로드할 때는 즉시 복호화됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en nøkkel for å kryptere alle opplastinger til en av bucketene dine transparent. Nedlastinger fra samme bucket dekrypteres fortløpende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een sleutel toe om elke upload naar een van je buckets transparant te versleutelen. Downloads uit dezelfde bucket worden direct ontsleuteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj klucz, aby automatycznie szyfrować wszystko, co wysyłasz do wybranego bucketu. Pobrania z tego bucketu są odszyfrowywane na bieżąco."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma chave para criptografar de forma transparente cada upload em um dos seus buckets. Downloads do mesmo bucket são descriptografados na hora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma chave para encriptar de forma transparente todos os carregamentos para um dos seus buckets. Os descarregamentos do mesmo bucket são desencriptados na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте ключ, чтобы прозрачно шифровать каждую загрузку в один из ваших бакетов. Скачивания из того же бакета расшифровываются на лету."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en nyckel för att transparent kryptera varje uppladdning till en av dina buckets. Hämtningar från samma bucket dekrypteras direkt."
          }
        }
      }
    },
