      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-upload the cached file to its original location."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die zwischengespeicherte Datei an den ursprünglichen Ort hoch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-téléverse le fichier mis en cache à son emplacement d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a subir el archivo en caché a su ubicación original."
          }
