    "metadata.tags.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 10 tags per object. Used by lifecycle rules and access policies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 10 Tags pro Objekt. Werden von Lifecycle-Regeln und Access Policies genutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à 10 tags par objet. Utilisés par les règles de cycle de vie et les politiques d’accès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 10 etiquetas por objeto. Las usan las reglas de ciclo de vida y políticas de acceso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a 10 tag per oggetto. Usati da regole di lifecycle e policy di accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトあたり最大10タグ。ライフサイクルルールやアクセスポリシーで利用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "객체당 최대 10개의 태그. 라이프사이클 규칙과 액세스 정책에 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximaal 10 tags per object. Worden gebruikt door lifecycle-regels en toegangsbeleid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do 10 tagów na obiekt. Używane przez reguły cyklu życia i polityki dostępu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 10 tags por objeto. Usadas por regras de ciclo de vida e políticas de acesso."
          }
        }
      }
    },
