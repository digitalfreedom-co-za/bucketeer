    "sync.delete.confirm.message %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen? Die Object Stores bleiben unverändert; nur die Job-Definition wird gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? Object stores are untouched; only the job definition is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Los almacenes de objetos no se tocan; solo se borra la definición del trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Les stockages d'objets ne sont pas touchés ; seule la définition du job est supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@? Gli object store non vengono toccati; viene cancellata solo la definizione del job."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか?オブジェクトストアはそのままで、ジョブ定義のみ削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거하시겠습니까? 오브젝트 스토어는 그대로 두고 작업 정의만 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwijderen? De objectopslag blijft ongemoeid; alleen de jobdefinitie wordt verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@? Magazyny obiektów pozostaną nietknięte; usunięta zostanie tylko definicja zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@? Os object stores não são afetados; apenas a definição da tarefa é excluída."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit %@? Objektová úložiště zůstanou nedotčena; smaže se pouze definice úlohy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne %@? Objektlagrene røres ikke; kun jobdefinitionen slettes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση του %@; Οι χώροι αποθήκευσης αντικειμένων δεν επηρεάζονται· διαγράφεται μόνο ο ορισμός της εργασίας."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %@? Objektivarastoihin ei kosketa; vain työn määritys poistetaan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a(z) %@ feladatot? Az objektumtárolók érintetlenek maradnak; csak a feladatdefiníció törlődik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du fjerne %@? Objektlagrene berøres ikke; bare jobbdefinisjonen slettes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@? Os armazenamentos de objetos não são alterados; apenas a definição da tarefa é eliminada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@? Объектные хранилища не затрагиваются; удаляется только определение задания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort %@? Objektlagringen påverkas inte; endast jobbdefinitionen raderas."
          }
        }
      }
    },
