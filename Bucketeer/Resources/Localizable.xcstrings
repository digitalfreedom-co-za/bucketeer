    "versions.delete.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze z %@ bude trvale smazána. Pravidla životního cyklu budou obejita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versionen fra %@ slettes permanent. Livscyklusregler omgås."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Version vom %@ wird endgültig gelöscht. Lifecycle-Regeln werden umgangen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η έκδοση από %@ θα διαγραφεί οριστικά. Οι κανόνες κύκλου ζωής παρακάμπτονται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The version from %@ will be permanently deleted. Lifecycle rules are bypassed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión del %@ se eliminará permanentemente. Se omiten las reglas de ciclo de vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versio ajalta %@ poistetaan pysyvästi. Elinkaarisäännöt ohitetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version du %@ sera supprimée définitivement. Les règles de cycle de vie sont ignorées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ időpontból származó verzió véglegesen törlődik. Az életciklus-szabályok figyelmen kívül maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione del %@ verrà eliminata definitivamente. Le regole di lifecycle vengono ignorate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のバージョンを完全に削除します。ライフサイクルルールは無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 의 버전이 영구적으로 삭제됩니다. 라이프사이클 규칙은 무시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versjonen fra %@ slettes permanent. Livssyklusregler omgås."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De versie van %@ wordt permanent verwijderd. Lifecycle-regels worden omzeild."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersja z %@ zostanie trwale usunięta. Reguły cyklu życia są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão de %@ será excluída permanentemente. As regras de ciclo de vida são ignoradas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão de %@ será eliminada permanentemente. As regras de ciclo de vida são ignoradas."
          }
        },
        "ru" : {
