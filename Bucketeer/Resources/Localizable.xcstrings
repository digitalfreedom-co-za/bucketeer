    "versions.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This object has no version history. Enable versioning on the bucket to start recording."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt hat keine Versionshistorie. Aktiviere Versionierung am Bucket, um die Aufzeichnung zu starten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet objet n’a pas d’historique de versions. Activez le versioning sur le bucket pour commencer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este objeto no tiene historial de versiones. Habilita el versionado del bucket para empezar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo oggetto non ha una cronologia di versioni. Abilita il versioning sul bucket per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオブジェクトにはバージョン履歴がありません。バケットでバージョン管理を有効にして記録を開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 객체에는 버전 기록이 없습니다. 버킷에서 버전 관리를 활성화해 기록을 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit object heeft geen versiegeschiedenis. Schakel versiebeheer op de bucket in om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten obiekt nie ma historii wersji. Włącz wersjonowanie bucketu, aby zacząć rejestrowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este objeto não tem histórico de versões. Ative o versionamento no bucket para começar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento objekt nemá historii verzí. Zapněte verzování bucketu, aby se začaly zaznamenávat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette objekt har ingen versionshistorik. Slå versionering til på bucketen for at begynde at registrere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το αντικείμενο δεν έχει ιστορικό εκδόσεων. Ενεργοποιήστε τη διαχείριση εκδόσεων στο bucket για να ξεκινήσει η καταγραφή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä objektilla ei ole versiohistoriaa. Ota versiointi käyttöön bucketissa aloittaaksesi tallennuksen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennek az objektumnak nincs verzióelőzménye. A rögzítés megkezdéséhez engedélyezze a verziózást a bucketen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette objektet har ingen versjonshistorikk. Aktiver versjonering på bucketen for å begynne å registrere."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este objeto não tem histórico de versões. Ative o versionamento no bucket para começar a registar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого объекта нет истории версий. Включите версионирование бакета, чтобы начать запись."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här objektet har ingen versionshistorik. Aktivera versionshantering på bucketen för att börja registrera."
          }
        }
      }
    },
