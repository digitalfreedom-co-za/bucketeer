          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Учётные данные этой учётной записи отсутствуют. Измените учётную запись и снова введите ключ доступа и секретный ключ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
