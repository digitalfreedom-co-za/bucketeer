    "account.note.credentials-rewrite": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten erneut eingeben, um sie zu behalten oder zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enter access key and secret to keep the saved credentials, or to update them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a introducir la clave de acceso y el secreto para conservar las credenciales guardadas o actualizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resaisissez la clé d'accès et le secret pour conserver les identifiants enregistrés ou les mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinserisci la chiave di accesso e il segreto per conservare le credenziali salvate o aggiornarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持または更新するには、アクセスキーとシークレットを再入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하거나 업데이트하려면 액세스 키와 시크릿을 다시 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de toegangssleutel en het geheim opnieuw in om de opgeslagen referenties te behouden of bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz ponownie klucz dostępu i sekret, aby zachować zapisane poświadczenia lub je zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira novamente a chave de acesso e o segredo para manter as credenciais salvas ou atualizá-las."
          }
        }
      }
    },
