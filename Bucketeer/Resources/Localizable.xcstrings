    "sync.allowsDecryptedCopies.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platí, když je zdrojový bucket šifrovaný a cílový bucket nemá šifrovací klíč: soubory se dešifrují a uloží nešifrované. Když je volba vypnutá, taková úloha se nespustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder, når kildens bucket er krypteret, og destinationens bucket ikke har nogen krypteringsnøgle: Filerne dekrypteres og gemmes ukrypteret. Når indstillingen er slået fra, kører et sådant job ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn der Quell-Bucket verschlüsselt ist und der Ziel-Bucket keinen Schlüssel hat: Die Dateien werden entschlüsselt und unverschlüsselt gespeichert. Ist die Option aus, läuft ein solcher Auftrag nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχύει όταν το bucket προέλευσης είναι κρυπτογραφημένο και το bucket προορισμού δεν έχει κλειδί κρυπτογράφησης: τα αρχεία αποκρυπτογραφούνται και αποθηκεύονται χωρίς κρυπτογράφηση. Όταν η επιλογή είναι ανενεργή, μια τέτοια εργασία δεν εκτελείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when the source bucket is encrypted and the destination bucket has no encryption key: files are decrypted and stored unencrypted. When this is off, such a job does not run."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies when the source bucket is encrypted and the destination bucket has no encryption key: files are decrypted and stored unencrypted. When this is off, such a job does not run."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica cuando el bucket de origen está cifrado y el de destino no tiene clave de cifrado: los archivos se descifran y se guardan sin cifrar. Si está desactivada, esa tarea no se ejecuta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koskee tilannetta, jossa lähdebucket on salattu eikä kohdebucketilla ole salausavainta: tiedostojen salaus puretaan ja ne tallennetaan salaamattomina. Kun asetus on pois päältä, tällaista työtä ei suoriteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique lorsque le bucket source est chiffré et que le bucket de destination n’a pas de clé de chiffrement : les fichiers sont déchiffrés et enregistrés sans chiffrement. Si l’option est désactivée, une telle tâche ne s’exécute pas."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor érvényes, ha a forrás bucket titkosított, a cél bucket pedig nem rendelkezik titkosítási kulccsal: a fájlok visszafejtve, titkosítatlanul kerülnek mentésre. Ha a beállítás ki van kapcsolva, az ilyen feladat nem fut le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica quando il bucket di origine è crittografato e quello di destinazione non ha una chiave di crittografia: i file vengono decrittografati e salvati senza crittografia. Se l’opzione è disattivata, un job di questo tipo non viene eseguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースのバケットが暗号化されていて、宛先のバケットに鍵が設定されていない場合に適用されます。ファイルは復号され、暗号化されないまま保存されます。オフの場合、このようなジョブは実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스 버킷이 암호화되어 있고 대상 버킷에 암호화 키가 없을 때 적용됩니다. 파일이 복호화되어 암호화되지 않은 상태로 저장됩니다. 이 옵션이 꺼져 있으면 해당 작업은 실행되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjelder når kildebucketen er kryptert og målbucketen ikke har noen krypteringsnøkkel: Filene dekrypteres og lagres ukryptert. Når innstillingen er av, kjøres ikke en slik jobb."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geldt als de bronbucket versleuteld is en de doelbucket geen versleutelingssleutel heeft: de bestanden worden ontsleuteld en onversleuteld bewaard. Staat deze optie uit, dan wordt zo’n synchronisatie niet uitgevoerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy sytuacji, gdy źródłowy bucket jest zaszyfrowany, a docelowy nie ma klucza szyfrowania: pliki są odszyfrowywane i zapisywane bez szyfrowania. Gdy opcja jest wyłączona, takie zadanie nie zostanie uruchomione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale quando o bucket de origem está criptografado e o bucket de destino não tem chave de criptografia: os arquivos são descriptografados e salvos sem criptografia. Com a opção desativada, essa tarefa não é executada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se quando o bucket de origem está encriptado e o bucket de destino não tem chave de encriptação: os ficheiros são desencriptados e guardados sem encriptação. Com a opção desativada, essa tarefa não é executada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Действует, когда исходный бакет зашифрован, а у бакета назначения нет ключа шифрования: файлы расшифровываются и сохраняются без шифрования. Если параметр выключен, такое задание не запускается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäller när källbucketen är krypterad och målbucketen saknar krypteringsnyckel: filerna dekrypteras och sparas okrypterade. När alternativet är av körs inte ett sådant jobb."
          }
        }
      }
    },
