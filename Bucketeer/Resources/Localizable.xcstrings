    "hardwareKey.preview.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technická ukázka — brána pro zobrazení tajných klíčů zatím používá Touch ID. Ověřování hardwarovým klíčem přijde ve v1.1 po širším ověření na zařízeních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk forhåndsversion — porten til visning af hemmeligheder bruger stadig Touch ID. Godkendelse med hardwarenøgle kommer i v1.1 efter en bredere enhedsvalidering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische Vorschau — Secret-Reveal nutzt weiterhin Touch ID. Hardware-Authentifizierung folgt in v1.1 nach umfassender Gerätevalidierung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τεχνική προεπισκόπηση — η πύλη εμφάνισης μυστικών εξακολουθεί να χρησιμοποιεί Touch ID. Η ταυτοποίηση με κλειδί υλικού θα κυκλοφορήσει στην έκδοση v1.1 μετά από ευρύτερο έλεγχο συσκευών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical preview — the secret-reveal gate still uses Touch ID. Hardware-key authentication ships in v1.1 after a wider device-validation pass."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista previa técnica — el desbloqueo de secretos sigue usando Touch ID. La autenticación por hardware llegará en v1.1 tras una validación más amplia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekninen esiversio — salaisuuksien paljastus käyttää yhä Touch ID:tä. Laitteistoavaintodennus tulee versiossa 1.1 laajemman laitetestauksen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperçu technique — le déverrouillage de secret utilise toujours Touch ID. L’authentification par clé matérielle arrivera en v1.1 après une validation matérielle plus large."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technikai előzetes — a titkos adatok felfedése továbbra is Touch ID-t használ. A hardverkulcsos hitelesítés a v1.1-ben érkezik, szélesebb körű eszközvalidálás után."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteprima tecnica — lo sblocco dei segreti usa ancora Touch ID. L’autenticazione hardware arriva in v1.1 dopo una validazione su più dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術プレビュー — シークレット解除は引き続き Touch ID を使用します。ハードウェア認証はより広範な検証後に v1.1 で提供予定。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기술 미리보기 — 비밀 공개 잠금 해제는 여전히 Touch ID를 사용합니다. 하드웨어 인증은 광범위한 검증 후 v1.1에서 제공됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk forhåndsvisning — porten for visning av hemmeligheter bruker fortsatt Touch ID. Autentisering med maskinvarenøkkel kommer i v1.1 etter en bredere enhetsvalidering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technische preview — secret-reveal gebruikt nog Touch ID. Hardware-authenticatie komt in v1.1 na bredere apparaatvalidatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podgląd techniczny — odblokowanie sekretów nadal używa Touch ID. Uwierzytelnianie sprzętowe pojawi się w v1.1 po szerszej weryfikacji urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-visualização técnica — o desbloqueio de segredos ainda usa Touch ID. Autenticação por hardware chega na v1.1 após validação ampla em dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pré-visualização técnica — a proteção de revelação de segredos ainda usa o Touch ID. A autenticação por chave de hardware chega na v1.1, após uma validação mais ampla de dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Технический превью — доступ к секретам по-прежнему защищается Touch ID. Аутентификация аппаратным ключом появится в v1.1 после более широкой проверки устройств."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teknisk förhandsversion — spärren för att visa hemligheter använder fortfarande Touch ID. Autentisering med maskinvarunyckel kommer i v1.1 efter en bredare enhetsvalidering."
          }
        }
      }
    },
