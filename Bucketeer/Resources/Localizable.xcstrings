    "sync.schedule.onLocalChange.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-runs this job whenever the local source folder changes. Debounced to avoid storms."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt den Auftrag erneut aus, sobald sich der lokale Quellordner ändert. Entprellt, um Schübe zu vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réexécute cette tâche dès que le dossier source local change. Débouncé pour éviter les rafales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutar este trabajo cuando cambie la carpeta de origen local. Antirrebote para evitar ráfagas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riesegue questo job ogni volta che la cartella sorgente locale cambia. Debounced per evitare raffiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのソースフォルダが変更されるたびにこのジョブを再実行します。連続発火を抑えるためデバウンスされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 소스 폴더가 변경될 때마다 이 작업을 다시 실행합니다. 폭주 방지를 위해 디바운스됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voert deze taak opnieuw uit zodra de lokale bronmap verandert. Gedebouncet om stormen te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia to zadanie ponownie po każdej zmianie lokalnego folderu źródłowego. Z debouncingiem, by uniknąć lawiny zdarzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa esta tarefa novamente sempre que a pasta de origem local mudar. Com debounce para evitar enxurradas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu spustí tuto úlohu při každé změně místní zdrojové složky. S prodlevou (debounce), aby se zabránilo záplavě spuštění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører dette job igen, hver gang den lokale kildemappe ændres. Ændringer samles op med en kort forsinkelse for at undgå unødige kørsler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτελεί ξανά αυτήν την εργασία κάθε φορά που αλλάζει ο τοπικός φάκελος προέλευσης. Με καθυστέρηση ομαδοποίησης (debounce) για αποφυγή καταιγισμών."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorittaa työn uudelleen aina, kun paikallinen lähdekansio muuttuu. Viivästetty ryöppyjen välttämiseksi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Újrafuttatja a feladatot, valahányszor a helyi forrásmappa megváltozik. Késleltetve, hogy elkerülje a tömeges újraindításokat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjører jobben på nytt hver gang den lokale kildemappen endres. Utsettes kort for å unngå stormer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a executar esta tarefa sempre que a pasta de origem local mudar. Com debounce para evitar rajadas de execuções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно запускает задание при каждом изменении локальной папки-источника. Срабатывания группируются, чтобы избежать лавины запусков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör om det här jobbet varje gång den lokala källmappen ändras. Fördröjs för att undvika skurar av körningar."
          }
        }
      }
    },
