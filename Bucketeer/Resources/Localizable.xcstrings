    "activity.clear.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every audit row from this Mac. It does not affect any data in your buckets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alle Auditzeilen von diesem Mac. Daten in den Buckets bleiben unangetastet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime toutes les lignes d’audit de ce Mac. Elle n’affecte aucune donnée dans vos buckets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las filas de auditoría de este Mac. No afecta a los datos de los buckets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno rimosse tutte le righe di audit da questo Mac. I dati nei bucket non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacからすべての監査行が削除されます。バケットのデータは影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 모든 감사 행이 제거됩니다. 버킷의 데이터에는 영향을 주지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke auditregel van deze Mac. Buckets blijven onaangetast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wszystkich wierszy audytu z tego Maca. Dane w bucketach pozostają nietknięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as linhas de auditoria deste Mac. Não afeta os dados dos buckets."
          }
        }
      }
    },
