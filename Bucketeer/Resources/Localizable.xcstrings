    "error.dnsLookup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS lookup failed for the endpoint hostname. For non-AWS providers this usually means the bucket-as-subdomain URL is not served — enable Path-Style addressing in the account's Advanced settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Auflösung fehlgeschlagen. Bei Nicht-AWS-Anbietern liegt das meist daran, dass die Bucket-als-Subdomain-URL nicht existiert — schalte in den Account-Einstellungen unter „Erweitert“ die Path-Style-Adressierung ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la búsqueda DNS del nombre de host del endpoint. Para proveedores que no son AWS, esto suele significar que la URL bucket-as-subdominio no se sirve — activa el direccionamiento estilo path en los ajustes avanzados de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la résolution DNS du nom d'hôte du point de terminaison. Pour les fournisseurs non-AWS, cela signifie généralement que l'URL bucket-en-sous-domaine n'est pas servie — activez l'adressage path-style dans les réglages avancés du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risoluzione DNS del nome host dell'endpoint non riuscita. Per i provider non-AWS in genere significa che l'URL bucket-as-subdomain non è servito — abilita l'indirizzamento path-style nelle impostazioni avanzate dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントホスト名の DNS 解決に失敗しました。AWS 以外のプロバイダでは、バケットをサブドメインとして使う URL が配信されていないことが多いため、アカウントの詳細設定でパススタイルアドレッシングを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트 호스트 이름의 DNS 조회에 실패했습니다. AWS가 아닌 공급자에서는 일반적으로 버킷-서브도메인 URL이 제공되지 않으므로 계정의 고급 설정에서 경로 스타일 주소를 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-opzoeking voor de eindpunt-hostnaam is mislukt. Bij niet-AWS-providers betekent dit meestal dat de bucket-als-subdomein-URL niet wordt aangeboden — schakel path-stijl-adressering in onder Geavanceerd in het account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyszukać DNS dla nazwy hosta endpointu. W przypadku dostawców innych niż AWS oznacza to zwykle, że adres URL bucket-jako-subdomena nie jest obsługiwany — włącz adresowanie w stylu ścieżki w ustawieniach zaawansowanych konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A consulta DNS para o nome do host do endpoint falhou. Em provedores que não são AWS, isso normalmente significa que a URL bucket-como-subdomínio não é servida — ative o endereçamento path-style nas configurações avançadas da conta."
          }
        }
      }
    },
