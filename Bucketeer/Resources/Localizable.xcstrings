    "activity.empty.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávání, stahování, mazání, běhy synchronizace a podepsané URL se zobrazí zde."
