    "encryption.plainCopy.message %@ %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ je šifrovaný, ale „%2$@“ nemá šifrovací klíč. Soubory budou dešifrovány a v cíli uloženy nešifrované."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%1$@« er krypteret, men »%2$@« har ingen krypteringsnøgle. Filerne bliver dekrypteret og gemt ukrypteret i destinationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist verschlüsselt, aber „%2$@“ hat keinen Schlüssel. Die Dateien werden entschlüsselt und im Ziel unverschlüsselt gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» είναι κρυπτογραφημένο, αλλά το «%2$@» δεν έχει κλειδί κρυπτογράφησης. Τα αρχεία θα αποκρυπτογραφηθούν και θα αποθηκευτούν χωρίς κρυπτογράφηση στον προορισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is encrypted, but “%2$@” has no encryption key. The files will be decrypted and stored unencrypted in the destination."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” is encrypted, but “%2$@” has no encryption key. The files will be decrypted and stored unencrypted in the destination."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” está cifrado, pero “%2$@” no tiene clave de cifrado. Los archivos se descifrarán y se guardarán sin cifrar en el destino."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%1$@” on salattu, mutta kohteella ”%2$@” ei ole salausavainta. Tiedostojen salaus puretaan ja ne tallennetaan kohteeseen salaamattomina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est chiffré, mais « %2$@ » n’a pas de clé de chiffrement. Les fichiers seront déchiffrés et enregistrés sans chiffrement dans la destination."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%1$@” titkosított, de a(z) „%2$@” nem rendelkezik titkosítási kulccsal. A fájlok visszafejtve, titkosítatlanul kerülnek a célhelyre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” è crittografato, ma “%2$@” non ha una chiave di crittografia. I file verranno decrittografati e salvati senza crittografia nella destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は暗号化されていますが、「%2$@」には鍵が設定されていません。ファイルは復号され、暗号化されないまま宛先に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%1$@’은(는) 암호화되어 있지만 ‘%2$@’에는 암호화 키가 없습니다. 파일이 복호화되어 대상에 암호화되지 않은 상태로 저장됩니다."
          }
        },
        "nb" : {
