    "watchFolder.deleteAfterUpload.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful as a hot folder — anything you drop in is uploaded and then removed from disk. Off by default to prevent accidental data loss."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Praktisch als Hot Folder — alles, was hineingelegt wird, wird hochgeladen und anschließend von der Platte entfernt. Standardmäßig aus, um Datenverlust zu vermeiden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratique comme dossier d’upload : tout ce que vous y déposez est téléversé puis supprimé du disque. Désactivé par défaut pour éviter toute perte accidentelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil como carpeta de subida: todo lo que sueltes se sube y luego se elimina del disco. Desactivado por defecto para evitar pérdidas accidentales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile come hot folder: tutto ciò che ci si lascia viene caricato e poi rimosso dal disco. Disabilitato di default per evitare perdite di dati accidentali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホットフォルダとして便利です。ドロップしたものはアップロード後にディスクから削除されます。誤削除防止のため既定はオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핫 폴더로 유용합니다 — 드롭한 항목은 업로드된 뒤 디스크에서 삭제됩니다. 우발적 데이터 손실을 막기 위해 기본적으로 꺼져 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig als hot folder: alles wat je erin zet, wordt geüpload en vervolgens van schijf verwijderd. Standaard uit om gegevensverlies te voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przydatne jako hot folder — wszystko, co tam upuścisz, zostanie wgrane, a następnie usunięte z dysku. Domyślnie wyłączone, aby uniknąć utraty danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil como hot folder — tudo o que você soltar é enviado e depois removido do disco. Desativado por padrão para evitar perda acidental."
          }
        }
      }
    },
