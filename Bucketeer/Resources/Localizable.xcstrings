          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit не сообщает о слотах. Возможно, macOS не загрузила драйвер — попробуйте отключить и снова подключить считыватель."
          }
        },
        "sv" : {
