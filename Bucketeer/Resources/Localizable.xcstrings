    "account.note.credentials-rewrite": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten erneut eingeben, um sie zu behalten oder zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enter access key and secret to keep the saved credentials, or to update them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a introducir la clave de acceso y el secreto para conservar las credenciales guardadas o actualizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resaisissez la clé d'accès et le secret pour conserver les identifiants enregistrés ou les mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinserisci la chiave di accesso e il segreto per conservare le credenziali salvate o aggiornarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持または更新するには、アクセスキーとシークレットを再入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하거나 업데이트하려면 액세스 키와 시크릿을 다시 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de toegangssleutel en het geheim opnieuw in om de opgeslagen referenties te behouden of bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz ponownie klucz dostępu i sekret, aby zachować zapisane poświadczenia lub je zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira novamente a chave de acesso e o segredo para manter as credenciais salvas ou atualizá-las."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte znovu přístupový klíč a tajný klíč, aby uložené přihlašovací údaje zůstaly zachovány, nebo pokud je chcete aktualizovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast adgangsnøgle og hemmelig nøgle igen for at beholde de gemte adgangsoplysninger eller for at opdatere dem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε ξανά το κλειδί πρόσβασης και το μυστικό κλειδί για να διατηρήσετε τα αποθηκευμένα διαπιστευτήρια ή για να τα ενημερώσετε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä käyttöavain ja salainen avain uudelleen säilyttääksesi tallennetut tunnistetiedot tai päivittääksesi ne."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja meg újra a hozzáférési kulcsot és a titkos kulcsot a mentett hitelesítő adatok megtartásához vagy frissítéséhez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn tilgangsnøkkel og hemmelig nøkkel på nytt for å beholde den lagrede påloggingsinformasjonen, eller for å oppdatere den."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte a introduzir a chave de acesso e a chave secreta para manter as credenciais guardadas ou para as atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ доступа и секретный ключ повторно, чтобы сохранить существующие учётные данные или обновить их."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange åtkomstnyckel och hemlig nyckel igen för att behålla de sparade inloggningsuppgifterna, eller för att uppdatera dem."
          }
        }
      }
    },
    "account.note.credentialsKept": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die gespeicherten Zugangsdaten zu behalten. Mit Touch ID oder Passwort anzeigen, um sie zu sehen oder zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to keep the stored credentials. Reveal them with Touch ID or your password to view or change them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para conservar las credenciales guardadas. Revélalas con Touch ID o tu contraseña para verlas o cambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour conserver les identifiants enregistrés. Révélez-les avec Touch ID ou votre mot de passe pour les voir ou les modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per conservare le credenziali salvate. Rivela tramite Touch ID o password per visualizzarle o modificarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持するには空欄のままにします。Touch ID またはパスワードで表示・変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하려면 비워 두세요. Touch ID 또는 암호로 확인하거나 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de opgeslagen referenties te behouden. Toon ze met Touch ID of je wachtwoord om ze te bekijken of te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby zachować zapisane poświadczenia. Wyświetl je za pomocą Touch ID lub hasła, aby je sprawdzić lub zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para manter as credenciais salvas. Mostre-as com Touch ID ou senha para visualizá-las ou alterá-las."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponechte prázdné, chcete-li zachovat uložené přihlašovací údaje. Pro zobrazení nebo změnu je odhalte pomocí Touch ID nebo hesla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lad felterne stå tomme for at beholde de gemte adgangsoplysninger. Vis dem med Touch ID eller din adgangskode for at se eller ændre dem."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφήστε το κενό για να διατηρηθούν τα αποθηκευμένα διαπιστευτήρια. Εμφανίστε τα με Touch ID ή με το συνθηματικό σας για να τα δείτε ή να τα αλλάξετε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätä tyhjäksi säilyttääksesi tallennetut tunnistetiedot. Näytä ne Touch ID:llä tai salasanallasi katsoaksesi tai muuttaaksesi niitä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hagyja üresen a mentett hitelesítő adatok megtartásához. Megtekintésükhöz vagy módosításukhoz fedje fel őket Touch ID-val vagy a jelszavával."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "La feltene stå tomme for å beholde den lagrede påloggingsinformasjonen. Vis den med Touch ID eller passordet ditt for å se eller endre den."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para manter as credenciais guardadas. Revele-as com Touch ID ou com a sua palavra-passe para as ver ou alterar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте поля пустыми, чтобы сохранить текущие учётные данные. Чтобы просмотреть или изменить их, откройте их с помощью Touch ID или пароля."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för att behålla de sparade inloggningsuppgifterna. Visa dem med Touch ID eller ditt lösenord för att se eller ändra dem."
          }
        }
      }
    },
    "account.note.credentialsRevealed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Zugangsdaten geladen. Änderungen überschreiben beim Speichern den Schlüsselbund-Eintrag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored credentials loaded. Edits will overwrite the Keychain entry on Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciales guardadas cargadas. Las ediciones sobrescribirán la entrada del Llavero al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants enregistrés chargés. Les modifications écraseront l'entrée du Trousseau lors de l'enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenziali salvate caricate. Le modifiche sovrascriveranno la voce del Portachiavi al salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を読み込みました。保存時にキーチェーンエントリを上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명이 로드되었습니다. 편집 내용은 저장 시 키체인 항목을 덮어씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen referenties geladen. Wijzigingen overschrijven het Sleutelhangeritem bij opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane poświadczenia załadowane. Edycje nadpiszą wpis w Pęku kluczy podczas zapisywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais salvas carregadas. Edições sobrescreverão a entrada no Acesso às Chaves ao salvar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené přihlašovací údaje byly načteny. Úpravy při uložení přepíší záznam v klíčence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemte adgangsoplysninger indlæst. Ændringer overskriver posten i nøgleringen, når du gemmer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα αποθηκευμένα διαπιστευτήρια φορτώθηκαν. Οι αλλαγές θα αντικαταστήσουν την εγγραφή στην Κλειδοθήκη κατά την Αποθήκευση."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetut tunnistetiedot ladattu. Muutokset korvaavat avainnipun merkinnän tallennettaessa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mentett hitelesítő adatok betöltve. A módosítások mentéskor felülírják a kulcskarika-bejegyzést."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret påloggingsinformasjon er lastet inn. Endringer overskriver oppføringen i nøkkelringen når du lagrer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais guardadas carregadas. As edições irão substituir a entrada no porta-chaves ao guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые учётные данные загружены. При сохранении изменения перезапишут запись в Связке ключей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade inloggningsuppgifter inlästa. Ändringar skriver över nyckelringsposten när du sparar."
          }
        }
      }
    },
