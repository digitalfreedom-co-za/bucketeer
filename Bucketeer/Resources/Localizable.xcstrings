    "watchFolder.deleteAfterUpload.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užitečné jako hot folder — vše, co do složky vložíte, se nahraje a poté odstraní z disku. Ve výchozím nastavení vypnuto, aby nedošlo k nechtěné ztrátě dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyttig som hot folder — alt, du lægger i mappen, uploades og fjernes derefter fra disken. Slået fra som standard for at forhindre utilsigtet datatab."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktisch als Hot Folder — alles, was du hineinlegst, wird hochgeladen und anschließend vom Datenträger entfernt. Standardmäßig aus, um versehentlichen Datenverlust zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρήσιμο ως φάκελος αυτόματης μεταφόρτωσης — ό,τι αποθέτετε μέσα μεταφορτώνεται και έπειτα αφαιρείται από τον δίσκο. Απενεργοποιημένο από προεπιλογή για αποφυγή τυχαίας απώλειας δεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful as a hot folder — anything you drop in is uploaded and then removed from disk. Off by default to prevent accidental data loss."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useful as a hot folder — anything you drop in is uploaded and then removed from disk. Off by default to prevent accidental data loss."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil como carpeta de entrega: todo lo que sueltes en ella se sube y luego se elimina del disco. Desactivado por defecto para evitar pérdidas accidentales de datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kätevä hot folder -käyttöön — kaikki kansioon pudotettu lähetetään ja poistetaan sitten levyltä. Oletuksena pois päältä tahattoman tietojen menetyksen estämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique comme dossier de dépôt : tout ce que vous y déposez est téléversé puis supprimé du disque. Désactivé par défaut pour éviter toute perte accidentelle de données."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gyűjtőmappaként hasznos — minden ide helyezett fájl feltöltődik, majd törlődik a lemezről. A véletlen adatvesztés elkerülése érdekében alapértelmezés szerint kikapcsolva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utile come cartella di deposito: tutto ciò che vi trascini viene caricato e poi rimosso dal disco. Disattivato per impostazione predefinita per evitare perdite accidentali di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホットフォルダとして便利です。ドロップしたものはアップロード後にディスクから削除されます。誤ってデータを失わないよう、デフォルトではオフです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핫 폴더로 유용합니다 — 넣은 항목은 업로드된 후 디스크에서 삭제됩니다. 실수로 인한 데이터 손실을 방지하기 위해 기본적으로 꺼져 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyttig som hot folder — alt du slipper i mappen lastes opp og fjernes deretter fra disken. Av som standard for å hindre utilsiktet datatap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handig als hot folder: alles wat je erin zet, wordt geüpload en vervolgens van schijf verwijderd. Standaard uit om gegevensverlies te voorkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przydatne jako „hot folder” — wszystko, co tam upuścisz, zostanie wysłane, a następnie usunięte z dysku. Domyślnie wyłączone, aby uniknąć przypadkowej utraty danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil como hot folder — tudo o que você soltar é enviado e depois removido do disco. Desativado por padrão para evitar perda acidental."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Útil como pasta automática — tudo o que largar aqui é carregado e depois removido do disco. Desativado por predefinição para evitar perda acidental de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удобно как «горячая» папка — всё, что вы в неё помещаете, загружается и затем удаляется с диска. По умолчанию выключено, чтобы предотвратить случайную потерю данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Användbart som släppmapp — allt du släpper i mappen laddas upp och tas sedan bort från disken. Av som standard för att förhindra oavsiktlig dataförlust."
          }
        }
      }
    },
