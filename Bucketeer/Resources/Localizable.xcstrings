    "paywall.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte die Funktionen frei, die Bucketeer zu einer echten Cloud-Workstation machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the features that turn Bucketeer into a real cloud workstation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea las funciones que convierten a Bucketeer en una verdadera estación de trabajo en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez les fonctionnalités qui font de Bucketeer une véritable station de travail cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca le funzionalità che trasformano Bucketeer in una vera workstation cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer を本格的なクラウドワークステーションにする機能を解除しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer를 진정한 클라우드 워크스테이션으로 만들어 주는 기능을 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de functies die van Bucketeer een echt cloudwerkstation maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj funkcje, które zamieniają Bucketeer w prawdziwą stację roboczą w chmurze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie os recursos que tornam o Bucketeer uma verdadeira estação de trabalho em nuvem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odemkněte funkce, které z aplikace Bucketeer udělají skutečnou cloudovou pracovní stanici."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås de funktioner op, der gør Bucketeer til en rigtig cloud-arbejdsstation."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκλειδώστε τις δυνατότητες που μετατρέπουν το Bucketeer σε πραγματικό σταθμό εργασίας νέφους."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa ominaisuudet, jotka tekevät Bucketeerista todellisen pilvityöaseman."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oldja fel azokat a funkciókat, amelyek a Bucketeert igazi felhő-munkaállomássá teszik."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp funksjonene som gjør Bucketeer til en ekte sky-arbeidsstasjon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie as funcionalidades que transformam o Bucketeer numa verdadeira estação de trabalho na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте функции, которые превращают Bucketeer в полноценную облачную рабочую станцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp funktionerna som gör Bucketeer till en riktig molnarbetsstation."
          }
        }
      }
    },
