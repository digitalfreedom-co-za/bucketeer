        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄ですべてのMIMEにマッチ。大文字小文字を区別しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워두면 모든 MIME에 일치. 대소문자 구분 없음."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leeg matcht elke MIME. Niet hoofdlettergevoelig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusty = każdy MIME. Bez rozróżniania wielkości liter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio = qualquer MIME. Não diferencia maiúsculas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prázdné odpovídá každému MIME. Prefix nerozlišuje velikost písmen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tom matcher alle MIME-typer. Præfikset skelner ikke mellem store og små bogstaver."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κενό ταιριάζει με κάθε MIME. Το πρόθεμα δεν κάνει διάκριση πεζών-κεφαλαίων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjä vastaa kaikkia MIME-tyyppejä. Etuliite ei erottele kirjainkokoa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Üresen minden MIME-típusra illeszkedik. Az előtag nem különbözteti meg a kis- és nagybetűket."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomt samsvarer med alle MIME-typer. Prefikset skiller ikke mellom store og små bokstaver."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio corresponde a todos os MIME. O prefixo não distingue maiúsculas de minúsculas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустое значение соответствует любому MIME. Регистр префикса не учитывается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomt matchar alla MIME-typer. Prefixet är skiftlägesokänsligt."
          }
        }
      }
