    "empty.no-account.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in der Seitenleiste ein S3-Konto hinzu, um loszulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an S3 account from the sidebar to start browsing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una cuenta S3 desde la barra lateral para empezar a navegar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un compte S3 depuis la barre latérale pour commencer à parcourir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un account S3 dalla barra laterale per iniziare a esplorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーから S3 アカウントを追加してブラウズを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탐색을 시작하려면 사이드바에서 S3 계정을 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een S3-account toe via de zijbalk om te beginnen met bladeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj konto S3 z paska bocznego, aby rozpocząć przeglądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma conta S3 na barra lateral para começar a navegar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte účet S3 z bočního panelu a začněte procházet."
