          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiók hitelesítő adatai hiányoznak. Szerkessze a fiókot, és adja meg újra a hozzáférési kulcsot és a titkos kulcsot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali di questo account mancano. Modifica l’account e inserisci di nuovo la chiave di accesso e la chiave segreta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアカウントの認証情報がありません。アカウントを編集し、アクセスキーとシークレットキーをもう一度入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 계정의 자격 증명이 없습니다. 계정을 편집하고 액세스 키와 비밀 키를 다시 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påloggingsinformasjonen for denne kontoen mangler. Rediger kontoen og skriv inn tilgangsnøkkelen og den hemmelige nøkkelen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De inloggegevens van dit account ontbreken. Wijzig het account en voer de toegangssleutel en de geheime sleutel opnieuw in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje danych logowania tego konta. Edytuj konto i ponownie wpisz klucz dostępu oraz klucz tajny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As credenciais desta conta estão faltando. Edite a conta e insira novamente a chave de acesso e a chave secreta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
