    "account.note.credentials-rewrite": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugangsdaten erneut eingeben, um sie zu behalten oder zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enter access key and secret to keep the saved credentials, or to update them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a introducir la clave de acceso y el secreto para conservar las credenciales guardadas o actualizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resaisissez la clé d'accès et le secret pour conserver les identifiants enregistrés ou les mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinserisci la chiave di accesso e il segreto per conservare le credenziali salvate o aggiornarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持または更新するには、アクセスキーとシークレットを再入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하거나 업데이트하려면 액세스 키와 시크릿을 다시 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de toegangssleutel en het geheim opnieuw in om de opgeslagen referenties te behouden of bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz ponownie klucz dostępu i sekret, aby zachować zapisane poświadczenia lub je zaktualizować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira novamente a chave de acesso e o segredo para manter as credenciais salvas ou atualizá-las."
          }
        }
      }
    },
    "account.note.credentialsKept": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die gespeicherten Zugangsdaten zu behalten. Mit Touch ID oder Passwort anzeigen, um sie zu sehen oder zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to keep the stored credentials. Reveal them with Touch ID or your password to view or change them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para conservar las credenciales guardadas. Revélalas con Touch ID o tu contraseña para verlas o cambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour conserver les identifiants enregistrés. Révélez-les avec Touch ID ou votre mot de passe pour les voir ou les modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per conservare le credenziali salvate. Rivela tramite Touch ID o password per visualizzarle o modificarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持するには空欄のままにします。Touch ID またはパスワードで表示・変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하려면 비워 두세요. Touch ID 또는 암호로 확인하거나 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de opgeslagen referenties te behouden. Toon ze met Touch ID of je wachtwoord om ze te bekijken of te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby zachować zapisane poświadczenia. Wyświetl je za pomocą Touch ID lub hasła, aby je sprawdzić lub zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
