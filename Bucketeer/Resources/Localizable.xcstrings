    "sync.delete.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror-Löschungen laufen zum Schluss, damit ein temporärer Vergleichsfehler nie Daten zerstört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror deletes are applied last so a transient compare error never loses data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las eliminaciones del espejo se aplican al final para que un error temporal de comparación nunca pierda datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suppressions miroir sont appliquées en dernier — une erreur transitoire de comparaison ne perd jamais de données."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le eliminazioni mirror vengono applicate per ultime così un errore temporaneo non perde dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラー削除は最後に適用されるため、一時的な比較エラーでもデータが失われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러 삭제는 마지막에 적용되므로 일시적인 비교 오류로 데이터가 손실되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror-verwijderingen worden als laatste uitgevoerd, zodat een tijdelijke vergelijkingsfout nooit data verliest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcia w trybie mirror są wykonywane na końcu, by tymczasowy błąd porównania nigdy nie spowodował utraty danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exclusões em modo espelho são aplicadas por último para que um erro temporário de comparação nunca perca dados."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mazání při zrcadlení se provádí jako poslední, takže přechodná chyba porovnání nikdy nezpůsobí ztrátu dat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spejlsletninger udføres til sidst, så en forbigående sammenligningsfejl aldrig mister data."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι διαγραφές κατοπτρισμού εφαρμόζονται τελευταίες, ώστε ένα παροδικό σφάλμα σύγκρισης να μην προκαλεί ποτέ απώλεια δεδομένων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Peilauspoistot tehdään viimeisenä, jotta ohimenevä vertailuvirhe ei koskaan hävitä dataa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tükrözési törlések utoljára kerülnek alkalmazásra, így egy átmeneti összehasonlítási hiba sosem okoz adatvesztést."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Speil-slettinger utføres til slutt, slik at en forbigående sammenligningsfeil aldri fører til datatap."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As eliminações em modo espelho são aplicadas no fim, para que um erro transitório de comparação nunca cause perda de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаления при зеркалировании применяются в последнюю очередь, поэтому временная ошибка сравнения никогда не приводит к потере данных."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Speglingsraderingar tillämpas sist så att ett tillfälligt jämförelsefel aldrig leder till dataförlust."
          }
        }
      }
    },
