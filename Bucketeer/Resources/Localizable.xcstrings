    "encryption.error.bucketMounted" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento bucket je připojen ve Finderu. Před zapnutím šifrování jej odpojte, protože soubory kopírované přes Finder by nebyly šifrovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne bucket er monteret i Finder. Afmontér den, før du slår kryptering til, da filer kopieret via Finder ikke ville blive krypteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bucket ist im Finder eingebunden. Wirf ihn aus, bevor du die Verschlüsselung aktivierst, denn über den Finder kopierte Dateien würden nicht verschlüsselt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το bucket είναι προσαρτημένο στο Finder. Αποπροσαρτήστε το πριν ενεργοποιήσετε την κρυπτογράφηση, επειδή τα αρχεία που αντιγράφονται μέσω του Finder δεν θα κρυπτογραφούνταν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bucket is mounted in Finder. Unmount it before turning on encryption, because files copied through Finder would not be encrypted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bucket is mounted in Finder. Unmount it before turning on encryption, because files copied through Finder would not be encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket está montado en el Finder. Desmóntalo antes de activar el cifrado, porque los archivos copiados a través del Finder no se cifrarían."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä bucket on liitetty Finderiin. Irrota se ennen salauksen käyttöönottoa, koska Finderin kautta kopioituja tiedostoja ei salattaisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce bucket est monté dans le Finder. Démontez-le avant d'activer le chiffrement, car les fichiers copiés via le Finder ne seraient pas chiffrés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a bucket csatolva van a Finderben. Válassza le a titkosítás bekapcsolása előtt, mert a Finderen keresztül másolt fájlok nem lennének titkosítva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo bucket è montato nel Finder. Smontalo prima di attivare la crittografia, perché i file copiati tramite il Finder non verrebbero crittografati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバケットは Finder にマウントされています。Finder 経由でコピーしたファイルは暗号化されないため、暗号化をオンにする前にマウントを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버킷은 Finder에 마운트되어 있습니다. Finder를 통해 복사한 파일은 암호화되지 않으므로 암호화를 켜기 전에 마운트를 해제하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne bucketen er montert i Finder. Avmonter den før du slår på kryptering, fordi filer kopiert via Finder ikke ville blitt kryptert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze bucket is gekoppeld in de Finder. Ontkoppel hem voordat je versleuteling inschakelt, want via de Finder gekopieerde bestanden zouden niet worden versleuteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten bucket jest zamontowany w Finderze. Odmontuj go przed włączeniem szyfrowania, ponieważ pliki kopiowane przez Findera nie byłyby szyfrowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket está montado no Finder. Desmonte-o antes de ativar a criptografia, pois arquivos copiados pelo Finder não seriam criptografados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket está montado no Finder. Desmonte-o antes de ativar a encriptação, porque os ficheiros copiados através do Finder não seriam encriptados."
          }
        },
        "ru" : {
