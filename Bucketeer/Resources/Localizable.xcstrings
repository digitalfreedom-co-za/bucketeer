    "trash.empty.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny položky koše a kopie v mezipaměti budou z tohoto Macu odstraněny. Data na straně poskytovatele jsou už pryč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle poster i papirkurven og cachede kopier fjernes fra denne Mac. Data hos udbyderen er allerede væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Einträge und zwischengespeicherten Kopien werden von diesem Mac entfernt. Provider-Daten sind bereits gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι εγγραφές του Κάδου και τα αντίγραφα στην προσωρινή μνήμη θα αφαιρεθούν από αυτό το Mac. Τα δεδομένα στην πλευρά του παρόχου έχουν ήδη διαγραφεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All trash entries and cached copies will be removed from this Mac. Provider-side data is already gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las entradas y copias en caché de este Mac. Los datos en el proveedor ya están eliminados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki roskakorin merkinnät ja välimuistikopiot poistetaan tältä Macilta. Palveluntarjoajan puolella data on jo poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les entrées et copies en cache seront supprimées de ce Mac. Les données chez le fournisseur sont déjà supprimées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kukabejegyzés és gyorsítótárazott másolat el lesz távolítva erről a Macről. A szolgáltatóoldali adatok már törlődtek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le voci e le copie in cache verranno rimosse da questo Mac. I dati lato provider sono già stati eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacからすべてのエントリとキャッシュされたコピーが削除されます。プロバイダ側のデータはすでに削除済みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 모든 항목과 캐시된 사본이 삭제됩니다. 공급자 측 데이터는 이미 삭제되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle papirkurv-oppføringer og bufrede kopier fjernes fra denne Macen. Dataene hos leverandøren er allerede borte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vermeldingen en gecachte kopieën worden verwijderd van deze Mac. Provider-data is al weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wpisy i zachowane kopie zostaną usunięte z tego Maca. Dane po stronie dostawcy już nie istnieją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as entradas e cópias em cache serão removidas deste Mac. Os dados no provedor já foram excluídos."
          }
