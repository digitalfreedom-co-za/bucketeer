    "encryption.delete.confirm.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting %@ makes every object encrypted with it unrecoverable. Are you sure?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen von %@ macht alle damit verschlüsselten Objekte unwiederherstellbar. Sicher?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ rend irrécupérable tout objet chiffré avec cette clé. Êtes-vous sûr ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %@ hace irrecuperables todos los objetos cifrados con ella. ¿Seguro?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eliminazione di %@ rende irrecuperabili tutti gli oggetti cifrati con essa. Sicuro?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除すると、そのキーで暗号化されたオブジェクトは復元不可能になります。よろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@를 삭제하면 해당 키로 암호화된 모든 객체를 복구할 수 없습니다. 계속하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderen van %@ maakt alle hiermee versleutelde objecten onherstelbaar. Zeker weten?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie %@ sprawi, że wszystkie obiekty zaszyfrowane tym kluczem będą nieodzyskiwalne. Na pewno?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@ torna irrecuperáveis todos os objetos cifrados com ela. Tem certeza?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazáním %@ se všechny objekty jím zašifrované stanou neobnovitelnými. Opravdu pokračovat?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletning af %@ gør alle objekter krypteret med den uoprettelige. Er du sikker?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή του %@ καθιστά μη ανακτήσιμο κάθε αντικείμενο που κρυπτογραφήθηκε με αυτό. Είστε βέβαιοι;"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteen %@ poistaminen tekee kaikista sillä salatuista objekteista palautuskelvottomia. Oletko varma?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ törlése után minden vele titkosított objektum helyreállíthatatlanná válik. Biztos benne?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter du %@, blir alle objekter som er kryptert med den, umulige å gjenopprette. Er du sikker?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar %@ torna irrecuperáveis todos os objetos encriptados com ela. Tem a certeza?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
