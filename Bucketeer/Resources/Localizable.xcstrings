    "settings.menubar.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní ikonu z Docku a udrží Bucketeer běžet v řádku nabídek i po zavření hlavního okna. Připojené disky a synchronizační úlohy zůstávají v provozu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner ikonet i Dock og holder Bucketeer kørende i menulinjen, mens hovedvinduet er lukket. Monterede drev og synkroniseringsjob fortsætter med at køre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt das Dock-Symbol und lässt Bucketeer in der Menüleiste laufen, auch wenn das Hauptfenster geschlossen ist. Eingebundene Laufwerke und Synchronisationen bleiben aktiv."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί το εικονίδιο από το Dock και διατηρεί το Bucketeer ενεργό στη γραμμή μενού όσο το κύριο παράθυρο είναι κλειστό. Οι προσαρτημένοι δίσκοι και οι εργασίες συγχρονισμού συνεχίζουν να εκτελούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the Dock icon and keeps Bucketeer alive in the menu bar while the main window is closed. Mounted drives and sync jobs stay running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el icono del Dock y mantiene Bucketeer activo en la barra de menús mientras la ventana principal está cerrada. Las unidades montadas y las sincronizaciones siguen funcionando."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa Dock-kuvakkeen ja pitää Bucketeerin käynnissä valikkorivillä, kun pääikkuna on suljettu. Liitetyt asemat ja synkronointityöt jatkavat toimintaansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l'icône du Dock et maintient Bucketeer actif dans la barre de menus lorsque la fenêtre principale est fermée. Les volumes montés et les synchronisations restent actifs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a Dock ikont, és a menüsorban tartja életben a Bucketeert, amíg a főablak zárva van. A csatolt meghajtók és a szinkronizálási feladatok tovább futnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove l'icona dal Dock e mantiene Bucketeer attivo nella barra dei menu mentre la finestra principale è chiusa. Le unità montate e le sincronizzazioni continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock アイコンを非表示にし、メインウィンドウを閉じてもメニューバーで Bucketeer を動かし続けます。マウント済みドライブと同期ジョブはそのまま稼働します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock 아이콘을 제거하고 메인 창이 닫혀 있는 동안에도 Bucketeer를 메뉴 막대에서 계속 실행합니다. 마운트된 드라이브와 동기화 작업은 계속 실행됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner Dock-symbolet og holder Bucketeer i gang i menylinjen mens hovedvinduet er lukket. Monterte disker og synkroniseringsjobber fortsetter å kjøre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbergt het Dock-icoon en houdt Bucketeer actief in de menubalk terwijl het hoofdvenster gesloten is. Gekoppelde volumes en synchronisaties blijven actief."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa ikonę z Docka i utrzymuje Bucketeer aktywny w pasku menu, gdy główne okno jest zamknięte. Zamontowane dyski i zadania synchronizacji nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove o ícone do Dock e mantém o Bucketeer ativo na barra de menus enquanto a janela principal está fechada. Unidades montadas e sincronizações continuam em execução."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove o ícone da Dock e mantém o Bucketeer em execução na barra de menus enquanto a janela principal está fechada. Os discos montados e as tarefas de sincronização continuam a funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убирает значок из Dock и оставляет Bucketeer работать в строке меню при закрытом главном окне. Смонтированные диски и задания синхронизации продолжают работать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort symbolen i Dock och håller Bucketeer igång i menyraden när huvudfönstret är stängt. Monterade enheter och synkjobb fortsätter att köra."
          }
        }
      }
    },
