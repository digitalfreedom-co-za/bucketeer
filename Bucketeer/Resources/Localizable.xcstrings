    "sync.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Synchronisation an, um Objekte zwischen Buckets und Anbietern zu kopieren, zu verschieben oder zu spiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a job to copy, move or mirror objects between buckets and providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sincronización para copiar, mover o reflejar objetos entre buckets y proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une tâche pour copier, déplacer ou refléter des objets entre buckets et fournisseurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un job per copiare, spostare o rispecchiare oggetti tra bucket e provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バケットやプロバイダ間でオブジェクトをコピー、移動、ミラーするジョブを作成しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버킷과 공급자 간에 객체를 복사, 이동, 미러링하는 작업을 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een job om objecten te kopiëren, verplaatsen of spiegelen tussen buckets en providers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz zadanie do kopiowania, przenoszenia lub mirrorowania obiektów między bucketami i dostawcami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma tarefa para copiar, mover ou espelhar objetos entre buckets e provedores."
          }
        }
      }
    },
