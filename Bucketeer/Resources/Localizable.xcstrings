    "autoTag.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules tag and add metadata to objects automatically after upload — e.g. set project-id on every PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln versehen Objekte nach dem Upload automatisch mit Tags und Metadaten — z. B. project-id für jede PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles taguent et ajoutent automatiquement des métadonnées après téléversement — p. ex. project-id pour chaque PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas etiquetan y añaden metadatos automáticamente tras subir — p. ej. project-id en cada PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole aggiungono automaticamente tag e metadati dopo l’upload — es. project-id su ogni PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはアップロード後にタグやメタデータを自動付与します。例: 全PDFに project-id を設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 업로드 후 객체에 자동으로 태그와 메타데이터를 추가합니다 — 예: 모든 PDF에 project-id 설정."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels taggen en voorzien geüploade objecten automatisch van metadata — bv. project-id op elke PDF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły automatycznie nadają tagi i metadane po wgraniu — np. project-id na każdym PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras adicionam tags e metadados automaticamente após upload — ex. project-id em todo PDF."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravidla automaticky přidávají objektům štítky a metadata po nahrání — např. nastaví project-id každému PDF."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Regler tagger og tilføjer metadata til objekter automatisk efter upload — sæt f.eks. project-id på hver PDF."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι κανόνες προσθέτουν αυτόματα ετικέτες και μεταδεδομένα στα αντικείμενα μετά τη μεταφόρτωση — π.χ. ορισμός project-id σε κάθε PDF."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säännöt lisäävät objekteihin tunnisteita ja metatietoja automaattisesti lähetyksen jälkeen — esim. aseta project-id jokaiselle PDF:lle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szabályok feltöltés után automatikusan címkéket és metaadatokat adnak az objektumokhoz — pl. project-id beállítása minden PDF-re."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Regler tagger og legger til metadata på objekter automatisk etter opplasting — f.eks. sett project-id på hver PDF."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras etiquetam e adicionam metadados aos objetos automaticamente após o carregamento — p. ex. definir project-id em todos os PDF."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правила автоматически добавляют теги и метаданные к объектам после загрузки — например, задают project-id для каждого PDF."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Regler taggar objekt och lägger till metadata automatiskt efter uppladdning — t.ex. sätter project-id på varje PDF."
          }
        }
      }
    },
