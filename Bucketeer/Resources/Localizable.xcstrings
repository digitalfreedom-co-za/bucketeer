    "error.dnsLookup" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Překlad DNS pro název hostitele endpointu selhal. U poskytovatelů mimo AWS to obvykle znamená, že URL s bucketem jako subdoménou není obsluhována — zapněte path-style adresování v pokročilých nastaveních účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-opslag mislykkedes for endpointets værtsnavn. For udbydere uden for AWS betyder det som regel, at bucket-som-underdomæne-URL'en ikke serveres — slå path-style-adressering til under kontoens avancerede indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-Auflösung fehlgeschlagen. Bei Nicht-AWS-Anbietern liegt das meist daran, dass die Bucket-als-Subdomain-URL nicht existiert — schalte in den Konto-Einstellungen unter „Erweitert“ die Path-Style-Adressierung ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αναζήτηση DNS για το όνομα κεντρικού υπολογιστή του endpoint απέτυχε. Για παρόχους εκτός AWS αυτό συνήθως σημαίνει ότι το URL με το bucket ως υποτομέα δεν εξυπηρετείται — ενεργοποιήστε τη διευθυνσιοδότηση τύπου διαδρομής (path-style) στις Προηγμένες ρυθμίσεις του λογαριασμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS lookup failed for the endpoint hostname. For non-AWS providers this usually means the bucket-as-subdomain URL is not served — enable Path-Style addressing in the account's Advanced settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS lookup failed for the endpoint hostname. For non-AWS providers this usually means the bucket-as-subdomain URL is not served — enable Path-Style addressing in the account's Advanced settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falló la búsqueda DNS del nombre de host del endpoint. Con proveedores distintos de AWS, esto suele significar que la URL con el bucket como subdominio no está disponible — activa el direccionamiento de estilo ruta (path-style) en los ajustes avanzados de la cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endpointin isäntänimen DNS-haku epäonnistui. Muilla kuin AWS-palveluntarjoajilla tämä tarkoittaa yleensä, että bucket-aliverkkotunnuksena-URL ei ole käytössä — ota path-style-osoitus käyttöön tilin lisäasetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la résolution DNS du nom d'hôte du point de terminaison. Pour les fournisseurs autres qu'AWS, cela signifie généralement que l'URL avec le bucket en sous-domaine n'est pas prise en charge — activez l'adressage par chemin (path-style) dans les réglages avancés du compte."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A végpont gazdagépnevének DNS-feloldása sikertelen. Nem AWS-szolgáltatóknál ez általában azt jelenti, hogy a bucket-aldomaines URL nincs kiszolgálva — engedélyezze a path-style címzést a fiók Speciális beállításaiban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Risoluzione DNS del nome host dell'endpoint non riuscita. Per i provider diversi da AWS in genere significa che l'URL con il bucket come sottodominio non è supportato — abilita l'indirizzamento path-style nelle impostazioni avanzate dell'account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンドポイントのホスト名の DNS 解決に失敗しました。AWS 以外のプロバイダでは、多くの場合、バケットをサブドメインとして使う URL が提供されていないことが原因です。アカウントの詳細設定でパススタイルのアドレス指定を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엔드포인트 호스트 이름의 DNS 조회에 실패했습니다. AWS가 아닌 공급자에서는 일반적으로 버킷을 하위 도메인으로 사용하는 URL이 제공되지 않는다는 의미이므로, 계정의 고급 설정에서 경로 스타일 주소를 활성화하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-oppslaget for endpoint-vertsnavnet mislyktes. For andre leverandører enn AWS betyr dette vanligvis at bucket-som-underdomene-URL-en ikke betjenes — aktiver path-style-adressering under kontoens avanserte innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-opzoeking voor de eindpunt-hostnaam is mislukt. Bij niet-AWS-providers betekent dit meestal dat de bucket-als-subdomein-URL niet wordt aangeboden — schakel adressering in path-stijl in onder Geavanceerd in de accountinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszukiwanie DNS dla nazwy hosta endpointu nie powiodło się. W przypadku dostawców innych niż AWS oznacza to zwykle, że adres URL z bucketem jako subdomeną nie jest obsługiwany — włącz adresowanie w stylu ścieżki w ustawieniach zaawansowanych konta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A consulta DNS para o nome do host do endpoint falhou. Em provedores que não são AWS, isso normalmente significa que a URL bucket-como-subdomínio não é servida — ative o endereçamento path-style nas configurações avançadas da conta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A resolução de DNS do nome de anfitrião do endpoint falhou. Em fornecedores que não a AWS, isto normalmente significa que o URL bucket-como-subdomínio não é servido — ative o endereçamento path-style nas definições avançadas da conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить DNS-запрос для имени хоста эндпоинта. У провайдеров, отличных от AWS, это обычно означает, что URL вида «бакет как поддомен» не обслуживается — включите path-style адресацию в дополнительных настройках учётной записи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-uppslagningen för endpointens värdnamn misslyckades. För andra leverantörer än AWS betyder detta oftast att URL:en med bucket som underdomän inte serveras — aktivera path-style-adressering under kontots avancerade inställningar."
          }
        }
      }
    },
