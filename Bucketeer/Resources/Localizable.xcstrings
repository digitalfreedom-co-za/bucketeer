    "crossCopy.prefix.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volitelné. Koncové lomítko se doplní automaticky. Názvy zdrojových souborů zůstanou zachovány pod prefixem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfrit. Afsluttende skråstreg tilføjes automatisk. Kildefilnavne bevares under præfikset."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Trennenden Schrägstrich automatisch. Quelldateinamen bleiben unter dem Präfix erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προαιρετικό. Η τελική κάθετος προστίθεται αυτόματα. Τα ονόματα αρχείων της προέλευσης διατηρούνται κάτω από το πρόθεμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional. Trailing slash auto-applied. Source filenames are kept under the prefix."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcional. Se añade la barra final automáticamente. Los nombres de archivo originales se mantienen bajo el prefijo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valinnainen. Loppuvinoviiva lisätään automaattisesti. Lähteen tiedostonimet säilyvät etuliitteen alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionnel. Le slash final est ajouté automatiquement. Les noms de fichiers sources sont conservés sous le préfixe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kötelező. A záró perjel automatikusan hozzáadódik. A forrásfájlnevek az előtag alatt maradnak meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opzionale. Slash finale aggiunto automaticamente. I nomi dei file sorgente vengono mantenuti sotto il prefisso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意。末尾のスラッシュは自動付与。元のファイル名は接頭辞配下に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택. 슬래시 자동 추가. 원본 파일명은 접두사 아래 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valgfritt. Avsluttende skråstrek legges til automatisk. Kildefilnavn beholdes under prefikset."
          }
