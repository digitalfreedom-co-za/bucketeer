          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem észlelhető olvasó. Csatlakoztasson egy YubiKey-t vagy egy intelligenskártya-olvasót."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
