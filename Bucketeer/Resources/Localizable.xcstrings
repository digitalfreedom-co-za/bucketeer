    "sync.error.localFolderUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místní složka chybí nebo ji nebylo možné celou přečíst, proto se synchronizační úloha zastavila dříve, než cokoli změnila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale mappe mangler eller kunne ikke læses fuldt ud, så synkroniseringsjobbet stoppede, før noget blev ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Ordner fehlt oder konnte nicht vollständig gelesen werden, daher wurde der Sync-Auftrag beendet, bevor etwas geändert wurde."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο τοπικός φάκελος λείπει ή δεν ήταν δυνατή η πλήρης ανάγνωσή του, οπότε η εργασία συγχρονισμού σταμάτησε πριν αλλάξει οτιδήποτε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local folder is missing or could not be read completely, so the sync job stopped before changing anything."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local folder is missing or could not be read completely, so the sync job stopped before changing anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta local no existe o no se pudo leer por completo, así que la tarea de sincronización se detuvo antes de cambiar nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallinen kansio puuttuu tai sitä ei voitu lukea kokonaan, joten synkronointityö pysähtyi ennen kuin mitään muutettiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier local est introuvable ou n'a pas pu être lu entièrement ; la tâche de synchronisation s'est arrêtée avant toute modification."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi mappa hiányzik, vagy nem sikerült teljesen beolvasni, ezért a szinkronizálási feladat leállt, mielőtt bármit módosított volna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella locale manca o non è stato possibile leggerla completamente, quindi il job di sincronizzazione si è fermato prima di modificare qualcosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルフォルダが見つからないか、すべてを読み取れなかったため、同期ジョブは何も変更せずに停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 폴더가 없거나 전체를 읽을 수 없어 동기화 작업이 아무것도 변경하지 않고 중지되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokale mappen mangler eller kunne ikke leses fullstendig, så synkroniseringsjobben stoppet før noe ble endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lokale map ontbreekt of kon niet volledig worden gelezen, dus de synchronisatie is gestopt voordat er iets werd gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder lokalny nie istnieje lub nie dało się go w całości odczytać, więc zadanie synchronizacji zatrzymało się, zanim cokolwiek zmieniło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta local não existe ou não pôde ser lida por completo, então a tarefa de sincronização parou antes de alterar qualquer coisa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta local não existe ou não pôde ser lida na totalidade, pelo que a tarefa de sincronização parou antes de alterar o que quer que fosse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локальная папка отсутствует или не может быть прочитана полностью, поэтому задание синхронизации остановлено, ничего не изменив."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den lokala mappen saknas eller kunde inte läsas helt, så synkjobbet stoppades innan något ändrades."
          }
        }
      }
    },
