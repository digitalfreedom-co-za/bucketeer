    "encryption.reassign.conflict" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account already has a key for this bucket. Choose another account; no key was overwritten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This account already has a key for this bucket. Choose another account; no key was overwritten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Konto hat bereits einen Schlüssel für diesen Bucket. Wähle ein anderes Konto; kein Schlüssel wurde überschrieben."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento účet již má klíč pro tento bucket. Vyberte jiný účet; žádný klíč nebyl přepsán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
