    "error.dnsLookup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Auflösung fehlgeschlagen. Bei Nicht-AWS-Anbietern liegt das meist daran, dass die Bucket-als-Subdomain-URL nicht existiert — schalte in den Account-Einstellungen unter „Erweitert“ die Path-Style-Adressierung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS lookup failed for the endpoint hostname. For non-AWS providers this usually means the bucket-as-subdomain URL is not served — enable Path-Style addressing in the account's Advanced settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la búsqueda DNS del nombre de host del endpoint. Para proveedores que no son AWS, esto suele significar que la URL bucket-as-subdominio no se sirve — activa el direccionamiento estilo path en los ajustes avanzados de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la résolution DNS du nom d'hôte du point de terminaison. Pour les fournisseurs non-AWS, cela signifie généralement que l'URL bucket-en-sous-domaine n'est pas servie — activez l'adressage path-style dans les réglages avancés du compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risoluzione DNS del nome host dell'endpoint non riuscita. Per i provider non-AWS in genere significa che l'URL bucket-as-subdomain non è servito — abilita l'indirizzamento path-style nelle impostazioni avanzate dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントホスト名の DNS 解決に失敗しました。AWS 以外のプロバイダでは、バケットをサブドメインとして使う URL が配信されていないことが多いため、アカウントの詳細設定でパススタイルアドレッシングを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트 호스트 이름의 DNS 조회에 실패했습니다. AWS가 아닌 공급자에서는 일반적으로 버킷-서브도메인 URL이 제공되지 않으므로 계정의 고급 설정에서 경로 스타일 주소를 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-opzoeking voor de eindpunt-hostnaam is mislukt. Bij niet-AWS-providers betekent dit meestal dat de bucket-als-subdomein-URL niet wordt aangeboden — schakel path-stijl-adressering in onder Geavanceerd in het account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wyszukać DNS dla nazwy hosta endpointu. W przypadku dostawców innych niż AWS oznacza to zwykle, że adres URL bucket-jako-subdomena nie jest obsługiwany — włącz adresowanie w stylu ścieżki w ustawieniach zaawansowanych konta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A consulta DNS para o nome do host do endpoint falhou. Em provedores que não são AWS, isso normalmente significa que a URL bucket-como-subdomínio não é servida — ative o endereçamento path-style nas configurações avançadas da conta."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překlad DNS pro hostname endpointu selhal. U poskytovatelů mimo AWS to obvykle znamená, že URL s bucketem jako subdoménou není obsluhována — zapněte path-style adresování v pokročilých nastaveních účtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-opslag mislykkedes for endpointets værtsnavn. For udbydere uden for AWS betyder det som regel, at bucket-som-underdomæne-URL'en ikke serveres — slå path-style-adressering til under kontoens avancerede indstillinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναζήτηση DNS για το όνομα κεντρικού υπολογιστή του endpoint απέτυχε. Για παρόχους εκτός AWS αυτό συνήθως σημαίνει ότι το URL με το bucket ως υποτομέα δεν εξυπηρετείται — ενεργοποιήστε τη διευθυνσιοδότηση τύπου διαδρομής (path-style) στις Προηγμένες ρυθμίσεις του λογαριασμού."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpointin isäntänimen DNS-haku epäonnistui. Muilla kuin AWS-palveluntarjoajilla tämä tarkoittaa yleensä, että bucket-aliverkkotunnuksena-URL ei ole käytössä — ota path-style-osoitus käyttöön tilin lisäasetuksista."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DNS-feloldás sikertelen az endpoint gazdagépnevénél. Nem AWS-szolgáltatóknál ez általában azt jelenti, hogy a bucket-aldomain URL nincs kiszolgálva — engedélyezze a path-style címzést a fiók Speciális beállításaiban."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-oppslaget for endpoint-vertsnavnet mislyktes. For andre leverandører enn AWS betyr dette vanligvis at bucket-som-underdomene-URL-en ikke betjenes — aktiver path-style-adressering under kontoens avanserte innstillinger."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A resolução de DNS do nome de anfitrião do endpoint falhou. Em fornecedores que não a AWS, isto normalmente significa que o URL bucket-como-subdomínio não é servido — ative o endereçamento path-style nas definições avançadas da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось выполнить DNS-запрос для имени хоста endpoint. У провайдеров, отличных от AWS, это обычно означает, что URL вида «бакет как поддомен» не обслуживается — включите path-style адресацию в дополнительных настройках учётной записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-uppslagningen för endpointens värdnamn misslyckades. För andra leverantörer än AWS betyder detta oftast att URL:en med bucket som underdomän inte serveras — aktivera path-style-adressering under kontots avancerade inställningar."
          }
        }
      }
    },
