    "trash.empty.confirm.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny položky koše a kopie v mezipaměti budou z tohoto Macu odstraněny. Data na straně poskytovatele jsou už pryč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle poster i papirkurven og cachede kopier fjernes fra denne Mac. Data hos udbyderen er allerede væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Papierkorbeinträge und zwischengespeicherten Kopien werden von diesem Mac entfernt. Die Daten beim Anbieter sind bereits gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι εγγραφές του Κάδου και τα αντίγραφα στην προσωρινή μνήμη θα αφαιρεθούν από αυτό το Mac. Τα δεδομένα στην πλευρά του παρόχου έχουν ήδη διαγραφεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All trash entries and cached copies will be removed from this Mac. Provider-side data is already gone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All trash entries and cached copies will be removed from this Mac. Provider-side data is already gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este Mac todas las entradas de la papelera y las copias en caché. Los datos en el proveedor ya están eliminados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki roskakorin merkinnät ja välimuistikopiot poistetaan tältä Macilta. Palveluntarjoajan puolella data on jo poistettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les entrées de la corbeille et les copies en cache seront supprimées de ce Mac. Les données chez le fournisseur sont déjà supprimées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kukabejegyzés és gyorsítótárazott másolat törlődik erről a Macről. A szolgáltatóoldali adatok már törlődtek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le voci del cestino e le copie in cache verranno rimosse da questo Mac. I dati lato provider sono già stati eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac から、ゴミ箱のすべての項目とキャッシュされたコピーが削除されます。プロバイダ側のデータはすでに削除されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 휴지통의 모든 항목과 캐시된 사본이 삭제됩니다. 공급자 측 데이터는 이미 삭제되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle oppføringer i papirkurven og bufrede kopier fjernes fra denne Macen. Dataene hos leverandøren er allerede borte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vermeldingen in de prullenmand en gecachte kopieën worden van deze Mac verwijderd. De gegevens bij de provider zijn al verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie wpisy kosza i kopie z pamięci podręcznej zostaną usunięte z tego Maca. Dane po stronie dostawcy zostały już usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as entradas da lixeira e cópias em cache serão removidas deste Mac. Os dados no provedor já foram excluídos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as entradas do Lixo e cópias em cache serão removidas deste Mac. Os dados do lado do fornecedor já foram eliminados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все записи корзины и кэшированные копии будут удалены с этого Mac. Данные на стороне провайдера уже удалены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla poster i papperskorgen och cachade kopior tas bort från denna Mac. Data hos leverantören är redan borta."
          }
        }
      }
    },
