    "account.action.revealSecret.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication is unavailable right now, so the stored credentials stay hidden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Authentifizierung ist derzeit nicht verfügbar, daher bleiben die gespeicherten Zugangsdaten verborgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autenticación no está disponible en este momento, por lo que las credenciales guardadas permanecen ocultas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’authentification est indisponible pour le moment, les identifiants enregistrés restent donc masqués."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autenticazione non è al momento disponibile, quindi le credenziali salvate restano nascoste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在認証を利用できないため、保存された資格情報は非表示のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 인증을 사용할 수 없으므로 저장된 자격 증명이 숨겨진 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificatie is momenteel niet beschikbaar, dus de opgeslagen inloggegevens blijven verborgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie jest obecnie niedostępne, więc zapisane dane dostępowe pozostają ukryte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação está indisponível no momento, então as credenciais salvas permanecem ocultas."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověření není momentálně dostupné, uložené přihlašovací údaje proto zůstávají skryté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelse er ikke tilgængelig lige nu, så de gemte adgangsoplysninger forbliver skjulte."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ταυτοποίηση δεν είναι διαθέσιμη αυτήν τη στιγμή, επομένως τα αποθηκευμένα διαπιστευτήρια παραμένουν κρυφά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Todennus ei ole juuri nyt käytettävissä, joten tallennetut tunnistetiedot pysyvät piilotettuina."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hitelesítés jelenleg nem érhető el, ezért a mentett hitelesítő adatok rejtve maradnak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisering er utilgjengelig akkurat nå, så den lagrede påloggingsinformasjonen forblir skjult."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autenticação não está disponível neste momento, pelo que as credenciais guardadas permanecem ocultas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация сейчас недоступна, поэтому сохранённые учётные данные остаются скрытыми."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisering är inte tillgänglig just nu, så de sparade inloggningsuppgifterna förblir dolda."
          }
        }
      }
    },
