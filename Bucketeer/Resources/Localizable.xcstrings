    "sync.delete.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mazání při zrcadlení se provádí jako poslední, takže přechodná chyba porovnání nikdy nezpůsobí ztrátu dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spejlsletninger udføres til sidst, så en forbigående sammenligningsfejl aldrig mister data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror-Löschungen laufen zum Schluss, damit ein temporärer Vergleichsfehler nie Daten zerstört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι διαγραφές κατοπτρισμού εφαρμόζονται τελευταίες, ώστε ένα παροδικό σφάλμα σύγκρισης να μην προκαλεί ποτέ απώλεια δεδομένων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror deletes are applied last so a transient compare error never loses data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las eliminaciones del espejo se aplican al final para que un error temporal de comparación nunca pierda datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peilauspoistot tehdään viimeisenä, jotta ohimenevä vertailuvirhe ei koskaan hävitä dataa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppressions miroir sont appliquées en dernier — une erreur transitoire de comparaison ne perd jamais de données."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tükrözési törlések utoljára kerülnek alkalmazásra, így egy átmeneti összehasonlítási hiba sosem okoz adatvesztést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le eliminazioni mirror vengono applicate per ultime così un errore temporaneo non perde dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミラー削除は最後に適用されるため、一時的な比較エラーでもデータが失われることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미러 삭제는 마지막에 적용되므로 일시적인 비교 오류로 데이터가 손실되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speil-slettinger utføres til slutt, slik at en forbigående sammenligningsfeil aldri fører til datatap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror-verwijderingen worden als laatste uitgevoerd, zodat een tijdelijke vergelijkingsfout nooit data verliest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcia w trybie mirror są wykonywane na końcu, by tymczasowy błąd porównania nigdy nie spowodował utraty danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exclusões em modo espelho são aplicadas por último para que um erro temporário de comparação nunca perca dados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As eliminações em modo espelho são aplicadas no fim, para que um erro transitório de comparação nunca cause perda de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаления при зеркалировании применяются в последнюю очередь, поэтому временная ошибка сравнения никогда не приводит к потере данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speglingsraderingar tillämpas sist så att ett tillfälligt jämförelsefel aldrig leder till dataförlust."
          }
        }
      }
    },
    "sync.diff.localHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místní složky nemají ETag. Název + velikost je jediná použitelná strategie porovnání pro synchronizaci napříč systémy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale mapper har ingen ETag. Navn + størrelse er den eneste brugbare sammenligningsstrategi for synkronisering på tværs af systemer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Ordner haben keinen ETag. Name + Größe ist die einzige sinnvolle Vergleichsstrategie für system-übergreifende Syncs."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τοπικοί φάκελοι δεν έχουν ETag. Το «Όνομα + μέγεθος» είναι η μόνη εφικτή στρατηγική σύγκρισης για συγχρονισμούς μεταξύ συστημάτων."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local folders have no ETag. Name + size is the only viable diff strategy for cross-system syncs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas locales no tienen ETag. Nombre + tamaño es la única estrategia de comparación viable para sincronizaciones entre sistemas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikallisilla kansioilla ei ole ETagia. Nimi + koko on ainoa toimiva vertailutapa järjestelmien väliseen synkronointiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers locaux n'ont pas d'ETag. Nom + taille est la seule stratégie de comparaison viable pour des synchronisations entre systèmes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A helyi mappáknak nincs ETagjük. Rendszerek közötti szinkronizálásnál a Név + méret az egyetlen működőképes összehasonlítási stratégia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cartelle locali non hanno ETag. Nome + dimensione è l'unica strategia di confronto utilizzabile per sincronizzazioni fra sistemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルフォルダには ETag がありません。クロスシステム同期では名前+サイズが唯一実用的な比較方法です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 폴더에는 ETag가 없습니다. 시스템 간 동기화에는 이름 + 크기 비교만 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale mapper har ingen ETag. Navn + størrelse er den eneste brukbare sammenligningsstrategien for synkronisering på tvers av systemer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale mappen hebben geen ETag. Naam + grootte is de enige werkbare vergelijking voor synchronisaties tussen systemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalne foldery nie mają ETag. Nazwa + rozmiar to jedyna sensowna strategia porównania dla synchronizacji między systemami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pastas locais não têm ETag. Nome + tamanho é a única estratégia de comparação viável para sincronizações entre sistemas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas locais não têm ETag. Nome + tamanho é a única estratégia de comparação viável para sincronizações entre sistemas."
          }
        },
        "ru" : {
          "stringUnit" : {
