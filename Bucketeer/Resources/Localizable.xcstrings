    "trash.empty.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All trash entries and cached copies will be removed from this Mac. Provider-side data is already gone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge und zwischengespeicherten Kopien werden von diesem Mac entfernt. Provider-Daten sind bereits gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les entrées et copies en cache seront supprimées de ce Mac. Les données chez le fournisseur sont déjà supprimées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las entradas y copias en caché de este Mac. Los datos en el proveedor ya están eliminados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le voci e le copie in cache verranno rimosse da questo Mac. I dati lato provider sono già stati eliminati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacからすべてのエントリとキャッシュされたコピーが削除されます。プロバイダ側のデータはすでに削除済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 모든 항목과 캐시된 사본이 삭제됩니다. 공급자 측 데이터는 이미 삭제되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vermeldingen en gecachte kopieën worden verwijderd van deze Mac. Provider-data is al weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wpisy i zachowane kopie zostaną usunięte z tego Maca. Dane po stronie dostawcy już nie istnieją."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as entradas e cópias em cache serão removidas deste Mac. Os dados no provedor já foram excluídos."
          }
        }
      }
    },
