    "account.note.bucket" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyplňte, pokud má klíč přístup jen k jednomu bucketu. Účet pak zobrazí pouze tento bucket."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udfyld, hvis nøglen kun har adgang til én bucket. Kontoen viser så kun denne bucket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfüllen, wenn der Schlüssel nur auf einen Bucket zugreifen darf. Das Konto zeigt dann nur diesen Bucket."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συμπληρώστε το, αν το κλειδί έχει πρόσβαση μόνο σε ένα bucket. Ο λογαριασμός θα εμφανίζει τότε μόνο αυτό το bucket."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter it if the key can only access one bucket. The account then shows only this bucket."
          }
        },
        "en-GB" : {
          "stringUnit" : {
