    "autoTag.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules tag and add metadata to objects automatically after upload — e.g. set project-id on every PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regeln versehen Objekte nach dem Upload automatisch mit Tags und Metadaten — z. B. project-id für jede PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles taguent et ajoutent automatiquement des métadonnées après téléversement — p. ex. project-id pour chaque PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas etiquetan y añaden metadatos automáticamente tras subir — p. ej. project-id en cada PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole aggiungono automaticamente tag e metadati dopo l’upload — es. project-id su ogni PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールはアップロード後にタグやメタデータを自動付与します。例: 全PDFに project-id を設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 업로드 후 객체에 자동으로 태그와 메타데이터를 추가합니다 — 예: 모든 PDF에 project-id 설정."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regels taggen en voorzien geüploade objecten automatisch van metadata — bv. project-id op elke PDF."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguły automatycznie nadają tagi i metadane po wgraniu — np. project-id na każdym PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Regras adicionam tags e metadados automaticamente após upload — ex. project-id em todo PDF."
          }
        }
      }
    },
