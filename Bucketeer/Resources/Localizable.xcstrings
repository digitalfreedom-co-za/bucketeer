    "sync.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege eine Synchronisation an, um Objekte zwischen Buckets und Anbietern zu kopieren, zu verschieben oder zu spiegeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a job to copy, move or mirror objects between buckets and providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una sincronización para copiar, mover o reflejar objetos entre buckets y proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une tâche pour copier, déplacer ou refléter des objets entre buckets et fournisseurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un job per copiare, spostare o rispecchiare oggetti tra bucket e provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バケットやプロバイダ間でオブジェクトをコピー、移動、ミラーするジョブを作成しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버킷과 공급자 간에 객체를 복사, 이동, 미러링하는 작업을 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een job om objecten te kopiëren, verplaatsen of spiegelen tussen buckets en providers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utwórz zadanie do kopiowania, przenoszenia lub mirrorowania obiektów między bucketami i dostawcami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma tarefa para copiar, mover ou espelhar objetos entre buckets e provedores."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořte úlohu pro kopírování, přesun nebo zrcadlení objektů mezi buckety a poskytovateli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret et job for at kopiere, flytte eller spejle objekter mellem buckets og udbydere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δημιουργήστε μια εργασία για αντιγραφή, μετακίνηση ή κατοπτρισμό αντικειμένων μεταξύ buckets και παρόχων."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo työ kopioidaksesi, siirtääksesi tai peilataksesi objekteja bucketien ja palveluntarjoajien välillä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozzon létre egy feladatot objektumok másolásához, áthelyezéséhez vagy tükrözéséhez bucketek és szolgáltatók között."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett en jobb for å kopiere, flytte eller speile objekter mellom buckets og leverandører."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma tarefa para copiar, mover ou espelhar objetos entre buckets e fornecedores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
