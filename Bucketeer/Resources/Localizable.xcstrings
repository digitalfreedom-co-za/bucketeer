    "account.note.credentialsKept" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponechte prázdné, chcete-li zachovat uložené přihlašovací údaje. Chcete-li je zobrazit nebo změnit, odemkněte je pomocí Touch ID nebo hesla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad felterne stå tomme for at beholde de gemte adgangsoplysninger. Vis dem med Touch ID eller din adgangskode for at se eller ændre dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um die gespeicherten Zugangsdaten zu behalten. Mit Touch ID oder Passwort anzeigen, um sie zu sehen oder zu ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφήστε το κενό για να διατηρηθούν τα αποθηκευμένα διαπιστευτήρια. Εμφανίστε τα με Touch ID ή με το συνθηματικό σας για να τα δείτε ή να τα αλλάξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave blank to keep the stored credentials. Reveal them with Touch ID or your password to view or change them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave blank to keep the stored credentials. Reveal them with Touch ID or your password to view or change them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo en blanco para conservar las credenciales guardadas. Revélalas con Touch ID o tu contraseña para verlas o cambiarlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jätä tyhjäksi säilyttääksesi tallennetut tunnistetiedot. Näytä ne Touch ID:llä tai salasanallasi katsoaksesi tai muuttaaksesi niitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour conserver les identifiants enregistrés. Révélez-les avec Touch ID ou votre mot de passe pour les voir ou les modifier."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagyja üresen a mentett hitelesítő adatok megtartásához. Megtekintésükhöz vagy módosításukhoz fedje fel őket Touch ID-val vagy a jelszavával."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia vuoto per conservare le credenziali salvate. Rivelale con Touch ID o con la password per visualizzarle o modificarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された認証情報をそのまま使う場合は空欄のままにしてください。表示または変更するには、Touch ID またはパスワードで認証してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 자격 증명을 유지하려면 비워 두십시오. Touch ID 또는 암호로 자격 증명을 표시한 후 확인하거나 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La feltene stå tomme for å beholde den lagrede påloggingsinformasjonen. Vis den med Touch ID eller passordet ditt for å se eller endre den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat leeg om de opgeslagen inloggegevens te behouden. Toon ze met Touch ID of je wachtwoord om ze te bekijken of te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw puste, aby zachować zapisane poświadczenia. Wyświetl je za pomocą Touch ID lub hasła, aby je sprawdzić lub zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para manter as credenciais salvas. Mostre-as com Touch ID ou senha para visualizá-las ou alterá-las."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe em branco para manter as credenciais guardadas. Revele-as com Touch ID ou com a sua palavra-passe para as ver ou alterar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте поля пустыми, чтобы сохранить текущие учётные данные. Чтобы просмотреть или изменить их, покажите их с помощью Touch ID или пароля."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lämna tomt för att behålla de sparade inloggningsuppgifterna. Visa dem med Touch ID eller ditt lösenord för att se eller ändra dem."
          }
        }
      }
    },
    "account.note.credentialsRevealed" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené přihlašovací údaje byly načteny. Úpravy při uložení přepíší záznam v klíčence."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemte adgangsoplysninger indlæst. Ændringer overskriver posten i nøgleringen, når du gemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Zugangsdaten geladen. Änderungen überschreiben beim Speichern den Schlüsselbund-Eintrag."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα αποθηκευμένα διαπιστευτήρια φορτώθηκαν. Οι αλλαγές θα αντικαταστήσουν την εγγραφή στην Κλειδοθήκη κατά την Αποθήκευση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored credentials loaded. Edits will overwrite the Keychain entry on Save."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored credentials loaded. Edits will overwrite the Keychain entry on Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credenciales guardadas cargadas. Las ediciones sobrescribirán la entrada del Llavero al guardar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetut tunnistetiedot ladattu. Muutokset korvaavat avainnipun merkinnän tallennettaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identifiants enregistrés chargés. Les modifications écraseront l'entrée du Trousseau lors de l'enregistrement."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mentett hitelesítő adatok betöltve. A módosítások mentéskor felülírják a kulcskarika-bejegyzést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credenziali salvate caricate. Le modifiche sovrascriveranno la voce del Portachiavi al salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された認証情報を読み込みました。保存すると、キーチェーンの項目が上書きされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 자격 증명이 로드되었습니다. 편집 내용은 저장 시 키체인 항목을 덮어씁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret påloggingsinformasjon er lastet inn. Endringer overskriver oppføringen i nøkkelringen når du lagrer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen inloggegevens geladen. Wijzigingen overschrijven het Sleutelhanger-item bij opslaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wczytano zapisane poświadczenia. Po zapisaniu zmiany nadpiszą wpis w Pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credenciais salvas carregadas. Ao salvar, as edições substituirão o item nas Chaves."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Credenciais guardadas carregadas. Ao guardar, as edições substituem a entrada no Porta-chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые учётные данные загружены. При сохранении изменения перезапишут запись в Связке ключей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparade inloggningsuppgifter inlästa. Ändringar skriver över nyckelringsposten när du sparar."
          }
        }
      }
    },
