    "sync.delete.confirm.message %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit %@? Objektová úložiště zůstanou nedotčena; smaže se pouze definice úlohy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne %@? Objektlagrene røres ikke; kun jobdefinitionen slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ entfernen? Die Object Stores bleiben unverändert, nur die Auftragsdefinition wird gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαίρεση του %@; Οι χώροι αποθήκευσης αντικειμένων δεν επηρεάζονται· διαγράφεται μόνο ο ορισμός της εργασίας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@? Object stores are untouched; only the job definition is deleted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@? Object stores are untouched; only the job definition is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar %@? Los almacenes de objetos no se modifican; solo se borra la definición de la tarea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko %@? Objektivarastoihin ei kosketa; vain työn määritys poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ ? Les stockages d'objets ne sont pas modifiés ; seule la définition de la tâche est supprimée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítja a(z) %@ feladatot? Az objektumtárolók érintetlenek maradnak; csak a feladatdefiníció törlődik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovere %@? Gli object store non vengono toccati; viene cancellata solo la definizione del job."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除しますか？オブジェクトストアはそのままで、ジョブ定義のみが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 제거하시겠습니까? 객체 스토어는 그대로 두고 작업 정의만 삭제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne %@? Objektlagrene berøres ikke; bare jobbdefinisjonen slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwijderen? De objectopslag blijft ongemoeid; alleen de instellingen van deze synchronisatie worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć %@? Magazyny obiektów pozostaną nietknięte; usunięta zostanie tylko definicja zadania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %@? O armazenamento de objetos não é afetado; apenas a definição da tarefa é excluída."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remover %@? Os armazenamentos de objetos não são alterados; apenas a definição da tarefa é eliminada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить %@? Объектные хранилища не затрагиваются; удаляется только определение задания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta bort %@? Objektlagringen påverkas inte; endast jobbdefinitionen raderas."
          }
        }
      }
    },
