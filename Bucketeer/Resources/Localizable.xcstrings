    "metadata.userMetadata.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are lower-case ASCII with dashes — e.g. project-id, content-language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel sind kleinbuchstabig ASCII mit Bindestrichen — z. B. project-id, content-language."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés sont en ASCII minuscule avec des tirets — p. ex. project-id, content-language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves son ASCII en minúscula con guiones — p. ej. project-id, content-language."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi sono ASCII minuscolo con trattini — es. project-id, content-language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーは小文字ASCIIとハイフン（例: project-id, content-language）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 소문자 ASCII와 하이픈을 사용합니다 — 예: project-id, content-language."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels zijn ASCII in kleine letters met streepjes — bv. project-id, content-language."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze są małymi literami ASCII z myślnikami — np. project-id, content-language."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves são ASCII em minúsculas com hifens — ex.: project-id, content-language."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíče jsou malá písmena ASCII s pomlčkami — např. project-id, content-language."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgler er små ASCII-bogstaver med bindestreger — f.eks. project-id, content-language."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά είναι πεζοί χαρακτήρες ASCII με παύλες — π.χ. project-id, content-language."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimet ovat pieniä ASCII-kirjaimia ja viivoja — esim. project-id, content-language."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsok kisbetűs ASCII karakterek kötőjelekkel — pl. project-id, content-language."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkler er ASCII med små bokstaver og bindestreker — f.eks. project-id, content-language."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves são ASCII em minúsculas com hífenes — p. ex. project-id, content-language."
          }
        },
        "ru": {
          "stringUnit": {
