    "account.note.credentialsKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to keep the stored credentials. Reveal them with Touch ID or your password to view or change them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um die gespeicherten Zugangsdaten zu behalten. Mit Touch ID oder Passwort anzeigen, um sie zu sehen oder zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo en blanco para conservar las credenciales guardadas. Revélalas con Touch ID o tu contraseña para verlas o cambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour conserver les identifiants enregistrés. Révélez-les avec Touch ID ou votre mot de passe pour les voir ou les modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per conservare le credenziali salvate. Rivela tramite Touch ID o password per visualizzarle o modificarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を維持するには空欄のままにします。Touch ID またはパスワードで表示・変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명을 유지하려면 비워 두세요. Touch ID 또는 암호로 확인하거나 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de opgeslagen referenties te behouden. Toon ze met Touch ID of je wachtwoord om ze te bekijken of te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby zachować zapisane poświadczenia. Wyświetl je za pomocą Touch ID lub hasła, aby je sprawdzić lub zmienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para manter as credenciais salvas. Mostre-as com Touch ID ou senha para visualizá-las ou alterá-las."
          }
        }
      }
    },
    "account.note.credentialsRevealed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored credentials loaded. Edits will overwrite the Keychain entry on Save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Zugangsdaten geladen. Änderungen überschreiben beim Speichern den Schlüsselbund-Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciales guardadas cargadas. Las ediciones sobrescribirán la entrada del Llavero al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiants enregistrés chargés. Les modifications écraseront l'entrée du Trousseau lors de l'enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenziali salvate caricate. Le modifiche sovrascriveranno la voce del Portachiavi al salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認証情報を読み込みました。保存時にキーチェーンエントリを上書きします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 자격 증명이 로드되었습니다. 편집 내용은 저장 시 키체인 항목을 덮어씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen referenties geladen. Wijzigingen overschrijven het Sleutelhangeritem bij opslaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane poświadczenia załadowane. Edycje nadpiszą wpis w Pęku kluczy podczas zapisywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais salvas carregadas. Edições sobrescreverão a entrada no Acesso às Chaves ao salvar."
          }
        }
      }
    },
