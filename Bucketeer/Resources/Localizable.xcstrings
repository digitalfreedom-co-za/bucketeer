          "stringUnit": {
            "state": "translated",
            "value": "Τα ονόματα δεν μπορούν να είναι κενά ή να περιέχουν καθέτους."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi ei voi olla tyhjä eikä sisältää vinoviivoja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A név nem lehet üres, és nem tartalmazhat perjelet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navn kan ikke være tomme eller inneholde skråstreker."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes não podem estar vazios nem conter barras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя не может быть пустым или содержать косую черту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Namn kan inte vara tomma eller innehålla snedstreck."
          }
        }
      }
