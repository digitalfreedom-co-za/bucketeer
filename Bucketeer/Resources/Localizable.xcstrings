    "Queues a local file for upload to the chosen bucket. The upload runs in the background." : {
      "comment" : "Description of the UploadFileIntent intent.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
