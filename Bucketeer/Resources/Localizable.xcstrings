    "about.tagline" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativní aplikace pro macOS k procházení, přenosu, připojování a synchronizaci objektových úložišť kompatibilních s S3 napříč více poskytovateli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS-app til at gennemse, overføre, montere og synkronisere S3-kompatibelt objektlager på tværs af flere udbydere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS-App zum Durchstöbern, Übertragen, Einbinden und Synchronisieren von S3-kompatiblem Object Storage über verschiedene Anbieter hinweg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εγγενής εφαρμογή macOS για περιήγηση, μεταφορά, προσάρτηση και συγχρονισμό αποθήκευσης αντικειμένων συμβατής με S3 σε πολλούς παρόχους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS app for browsing, transferring, mounting and synchronising S3-compatible object storage across multiple providers."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS app for browsing, transferring, mounting and synchronising S3-compatible object storage across multiple providers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App nativa de macOS para navegar, transferir, montar y sincronizar almacenamiento de objetos compatible con S3 entre varios proveedores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natiivi macOS-sovellus S3-yhteensopivan objektitallennuksen selaamiseen, siirtämiseen, liittämiseen ja synkronointiin useiden palveluntarjoajien välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Application macOS native pour parcourir, transférer, monter et synchroniser le stockage d'objets compatible S3 entre plusieurs fournisseurs."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natív macOS-alkalmazás S3-kompatibilis objektumtárolók böngészéséhez, átviteléhez, csatolásához és szinkronizálásához több szolgáltatónál."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App nativa per macOS per esplorare, trasferire, montare e sincronizzare object storage compatibile con S3 tra più provider."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のプロバイダにまたがって S3 互換オブジェクトストレージを参照、転送、マウント、同期できる macOS ネイティブアプリ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 공급자의 S3 호환 객체 스토리지를 탐색, 전송, 마운트, 동기화할 수 있는 macOS 네이티브 앱."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nativ macOS-app for å bla i, overføre, montere og synkronisere S3-kompatibel objektlagring på tvers av flere leverandører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS-app om S3-compatibele objectopslag bij meerdere providers te verkennen, te verplaatsen, te koppelen en te synchroniseren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natywna aplikacja macOS do przeglądania, przesyłania, montowania i synchronizowania pamięci obiektowej kompatybilnej z S3 między wieloma dostawcami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App nativo do macOS para navegar, transferir, montar e sincronizar armazenamento de objetos compatível com S3 entre vários provedores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicação nativa para macOS para navegar, transferir, montar e sincronizar armazenamento de objetos compatível com S3 em vários fornecedores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нативное приложение для macOS для просмотра, передачи, монтирования и синхронизации S3-совместимых объектных хранилищ у разных провайдеров."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native macOS-app för att bläddra i, överföra, montera och synkronisera S3-kompatibel objektlagring hos flera leverantörer."
          }
        }
      }
    },
