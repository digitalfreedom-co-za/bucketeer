    "encryption.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíče existují pouze na tomto Macu (klíčenka). Jejich ztráta = ztráta přístupu ke všem zašifrovaným objektům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøgler findes kun på denne Mac (nøglering). Mister du dem, mister du adgangen til alle objekter, du har krypteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlüssel existieren nur auf diesem Mac (Schlüsselbund). Verlust = kein Zugriff mehr auf verschlüsselte Objekte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδιά υπάρχουν μόνο σε αυτό το Mac (Κλειδοθήκη). Αν τα χάσετε, χάνετε την πρόσβαση σε κάθε αντικείμενο που κρυπτογραφήσατε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys live only on this Mac (Keychain). Lose them = lose access to every object you encrypted."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys live only on this Mac (Keychain). Lose them = lose access to every object you encrypted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves solo se guardan en este Mac (en el Llavero). Si las pierdes, pierdes el acceso a todos los objetos cifrados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaimet ovat vain tällä Macilla (avainnippu). Jos menetät ne, menetät pääsyn kaikkiin salaamiisi objekteihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés sont stockées uniquement sur ce Mac (dans le Trousseau). Si vous les perdez, vous perdez l’accès à tous les objets chiffrés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcsok csak ezen a Macen, a kulcskarikában vannak tárolva. Ha elvesznek, a velük titkosított objektumokhoz sem fér hozzá többé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi sono salvate solo su questo Mac (nel Portachiavi). Se le perdi, perdi l’accesso a tutti gli oggetti crittografati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵はこの Mac（キーチェーン）にのみ保存されます。紛失すると、暗号化したすべてのオブジェクトにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 이 Mac(키체인)에만 저장됩니다. 키를 분실하면 암호화한 모든 객체에 접근할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nøkler finnes bare på denne Macen (nøkkelring). Mister du dem, mister du tilgangen til alle objekter du har kryptert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleutels staan alleen op deze Mac (Sleutelhanger). Kwijt = geen toegang meer tot alle objecten die je ermee hebt versleuteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze istnieją tylko na tym Macu (Pęk kluczy). Ich utrata = utrata dostępu do każdego zaszyfrowanego obiektu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves ficam apenas neste Mac (nas Chaves). Perdê-las = perder o acesso a todos os objetos criptografados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves existem apenas neste Mac (Porta-chaves). Perdê-las = perder o acesso a todos os objetos que encriptou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи хранятся только на этом Mac (Связка ключей). Потеряете их — потеряете доступ ко всем зашифрованным объектам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nycklarna finns bara på denna Mac (nyckelringen). Förlorar du dem förlorar du åtkomsten till alla objekt du har krypterat."
          }
        }
      }
    },
