            "state" : "translated",
            "value" : "Smazáním %@ se všechny objekty jím zašifrované stanou neobnovitelnými. Opravdu pokračovat?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du sletter %@, kan objekter, der er krypteret med den, ikke længere gendannes. Er du sikker?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen von %@ macht alle damit verschlüsselten Objekte unwiederherstellbar. Bist du sicher?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διαγραφή του %@ καθιστά μη ανακτήσιμο κάθε αντικείμενο που κρυπτογραφήθηκε με αυτό. Είστε βέβαιοι;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting %@ makes every object encrypted with it unrecoverable. Are you sure?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting %@ makes every object encrypted with it unrecoverable. Are you sure?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si eliminas %@, todos los objetos cifrados con ella serán irrecuperables. ¿Seguro que quieres continuar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos poistat avaimen %@, mitään sillä salattua objektia ei voi enää palauttaa. Oletko varma?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer %@ rend irrécupérable tout objet chiffré avec cette clé. Êtes-vous sûr ?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) %@ törlése után minden vele titkosított objektum helyreállíthatatlanná válik. Biztos benne?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini %@, tutti gli oggetti crittografati con questa chiave diventano irrecuperabili. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を削除すると、その鍵で暗号化されたすべてのオブジェクトが復元不可能になります。よろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 삭제하면 해당 키로 암호화된 모든 객체를 복구할 수 없습니다. 계속하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter du %@, blir alle objekter som er kryptert med den, umulige å gjenopprette. Er du sikker?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je %@ verwijdert, worden alle hiermee versleutelde objecten onherstelbaar. Weet je het zeker?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie %@ sprawi, że wszystkie obiekty zaszyfrowane tym kluczem będą nieodzyskiwalne. Na pewno?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir %@ torna irrecuperáveis todos os objetos criptografados com ela. Tem certeza?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar %@ torna irrecuperáveis todos os objetos encriptados com ela. Tem a certeza?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После удаления %@ все зашифрованные им объекты станут невосстановимыми. Вы уверены?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du raderar %@ blir alla objekt som krypterats med den omöjliga att återskapa. Är du säker?"
          }
        }
      }
