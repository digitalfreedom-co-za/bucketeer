    "mount.error.encryptedBucket" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento bucket používá šifrování na straně klienta. V této verzi Bucketeeru nelze šifrované buckety připojit ve Finderu; přenášejte jeho soubory v okně Bucketeeru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne bucket bruger kryptering på klientsiden. I denne version af Bucketeer kan krypterede buckets ikke monteres i Finder; overfør dens filer i Bucketeer-vinduet i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bucket nutzt clientseitige Verschlüsselung. In dieser Version von Bucketeer lassen sich verschlüsselte Buckets nicht im Finder einbinden; übertrage die Dateien stattdessen im Bucketeer-Fenster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το bucket χρησιμοποιεί κρυπτογράφηση στην πλευρά του πελάτη. Σε αυτή την έκδοση του Bucketeer τα κρυπτογραφημένα buckets δεν μπορούν να προσαρτηθούν στο Finder· μεταφέρετε τα αρχεία του από το παράθυρο του Bucketeer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bucket uses client-side encryption. In this version of Bucketeer, encrypted buckets can't be mounted in Finder; transfer its files in the Bucketeer window instead."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bucket uses client-side encryption. In this version of Bucketeer, encrypted buckets can't be mounted in Finder; transfer its files in the Bucketeer window instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket usa cifrado del lado del cliente. En esta versión de Bucketeer, los buckets cifrados no se pueden montar en el Finder; transfiere sus archivos desde la ventana de Bucketeer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä bucket käyttää asiakaspuolen salausta. Tässä Bucketeerin versiossa salattuja bucketeja ei voi liittää Finderiin; siirrä sen tiedostot Bucketeer-ikkunassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce bucket utilise un chiffrement côté client. Dans cette version de Bucketeer, les buckets chiffrés ne peuvent pas être montés dans le Finder ; transférez ses fichiers depuis la fenêtre de Bucketeer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a bucket kliensoldali titkosítást használ. A Bucketeer ezen verziójában titkosított bucketek nem csatolhatók a Finderben; a fájljait a Bucketeer ablakában vigye át."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo bucket usa la crittografia lato client. In questa versione di Bucketeer i bucket crittografati non possono essere montati nel Finder; trasferisci i suoi file dalla finestra di Bucketeer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバケットはクライアント側暗号化を使用しています。このバージョンの Bucketeer では、暗号化されたバケットを Finder にマウントできません。Bucketeer のウインドウでファイルを転送してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 버킷은 클라이언트 측 암호화를 사용합니다. 이 버전의 Bucketeer에서는 암호화된 버킷을 Finder에 마운트할 수 없습니다. Bucketeer 윈도우에서 파일을 전송하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne bucketen bruker kryptering på klientsiden. I denne versjonen av Bucketeer kan krypterte buckets ikke monteres i Finder; overfør filene i Bucketeer-vinduet i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze bucket gebruikt versleuteling aan de clientzijde. In deze versie van Bucketeer kunnen versleutelde buckets niet in de Finder worden gekoppeld; zet de bestanden over in het Bucketeer-venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten bucket używa szyfrowania po stronie klienta. W tej wersji Bucketeera zaszyfrowanych bucketów nie można zamontować w Finderze; przenoś jego pliki w oknie Bucketeera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket usa criptografia no lado do cliente. Nesta versão do Bucketeer, buckets criptografados não podem ser montados no Finder; transfira os arquivos pela janela do Bucketeer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este bucket utiliza encriptação do lado do cliente. Nesta versão do Bucketeer, os buckets encriptados não podem ser montados no Finder; transfira os ficheiros na janela do Bucketeer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот бакет использует шифрование на стороне клиента. В этой версии Bucketeer зашифрованные бакеты нельзя смонтировать в Finder; передавайте его файлы в окне Bucketeer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här bucketen använder kryptering på klientsidan. I den här versionen av Bucketeer kan krypterade buckets inte monteras i Finder; överför filerna i Bucketeer-fönstret i stället."
          }
        }
      }
    },
    "openWith.quit.kept.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravené soubory, které nebylo možné nahrát: %lld. Zůstávají uložené v tomto Macu a při příštím otevření Bucketeeru vám je znovu nabídneme."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigerede filer, der ikke kunne uploades: %lld. De gemmes på denne Mac og tilbydes igen, næste gang du åbner Bucketeer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeitete Dateien, die nicht hochgeladen werden konnten: %lld. Die Dateien bleiben auf diesem Mac und werden dir beim nächsten Öffnen von Bucketeer erneut angeboten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επεξεργασμένα αρχεία που δεν ήταν δυνατό να μεταφορτωθούν: %lld. Διατηρούνται σε αυτό το Mac και θα σας προταθούν ξανά την επόμενη φορά που θα ανοίξετε το Bucketeer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edited files that could not be uploaded: %lld. They are kept on this Mac and offered again the next time you open Bucketeer."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edited files that could not be uploaded: %lld. They are kept on this Mac and offered again the next time you open Bucketeer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos editados que no se pudieron subir: %lld. Se conservan en este Mac y se te ofrecerán de nuevo la próxima vez que abras Bucketeer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muokatut tiedostot, joita ei voitu lähettää: %lld. Ne säilytetään tässä Macissa ja tarjotaan uudelleen, kun avaat Bucketeerin seuraavan kerran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers modifiés qui n'ont pas pu être téléversés : %lld. Ils sont conservés sur ce Mac et vous seront proposés à nouveau à la prochaine ouverture de Bucketeer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Módosított fájlok, amelyeket nem sikerült feltölteni: %lld. Ezen a Macen maradnak, és a Bucketeer következő megnyitásakor ismét felajánljuk őket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File modificati che non è stato possibile caricare: %lld. Restano su questo Mac e ti verranno riproposti alla prossima apertura di Bucketeer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードできなかった編集済みファイル: %lld 件。これらのファイルはこの Mac に保持され、次回 Bucketeer を開いたときに再度表示されます。"
          }
        },
        "ko" : {
