    "about.legal.summary": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer ist Source-Available, keine OSI-Open-Source. Die einzige autorisierte Binärdistribution läuft über den Mac App Store. Details unter Lizenz, EULA und Open-Source-Hinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer is source-available, not open source. The single canonical binary is distributed via the Mac App Store. See License, EULA and Open Source Notices for details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer es de código disponible, no de código abierto. El único binario canónico se distribuye a través de la Mac App Store. Consulta la Licencia, el EULA y los Avisos de Open Source para más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer est en source disponible, pas open source. Le seul binaire officiel est distribué via le Mac App Store. Voir la Licence, le CLUF et les Mentions Open Source pour les détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer è a sorgente disponibile, non open source. L'unico binario ufficiale viene distribuito tramite il Mac App Store. Consulta Licenza, EULA e Avvisi Open Source per dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer はソース公開ですが、オープンソースではありません。正規のバイナリは Mac App Store でのみ配布されます。詳細はライセンス、EULA、オープンソース表記をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer는 소스가 공개되지만 오픈 소스는 아닙니다. 공식 바이너리는 Mac App Store를 통해서만 배포됩니다. 자세한 내용은 라이선스, EULA, 오픈 소스 고지를 참조하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer is source-available, geen open source. De enige officiële binary wordt verspreid via de Mac App Store. Zie Licentie, EULA en Open Source-vermeldingen voor details."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucketeer udostępnia kod źródłowy, ale nie jest open source. Jedyna oficjalna wersja binarna jest dystrybuowana przez Mac App Store. Szczegóły w Licencji, EULA i Informacjach o Open Source."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bucketeer tem o código disponível, mas não é open source. O único binário oficial é distribuído pela Mac App Store. Veja Licença, EULA e Avisos de Open Source para detalhes."
          }
        }
      }
    },
