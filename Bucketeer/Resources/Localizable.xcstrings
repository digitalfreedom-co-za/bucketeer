    "browser.action.rename.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbenennen kopiert serverseitig und löscht das Original. Objekte über 5 GB und providerübergreifende Umbenennungen sind in v1 nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename copies the object server-side and deletes the original. Large objects (> 5 GB) and cross-provider renames are not supported in v1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renombrar copia el objeto en el servidor y elimina el original. Objetos grandes (> 5 GB) y renombrados entre proveedores no están soportados en la v1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renommer copie l'objet côté serveur puis supprime l'original. Les objets volumineux (> 5 Go) et les renommages entre fournisseurs ne sont pas pris en charge dans la v1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La rinomina copia l'oggetto lato server ed elimina l'originale. Oggetti grandi (> 5 GB) e rinomine fra provider non sono supportati nella v1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前変更はサーバ側でコピーしてからオリジナルを削除します。5 GB を超える大きなオブジェクトやプロバイダ間の名前変更は v1 ではサポートされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 변경은 서버에서 객체를 복사한 다음 원본을 삭제합니다. 5 GB가 넘는 큰 객체나 공급자 간 이름 변경은 v1에서 지원되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hernoemen kopieert het object op de server en verwijdert het origineel. Grote objecten (> 5 GB) en hernoemen tussen providers worden niet ondersteund in v1."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana nazwy kopiuje obiekt po stronie serwera, a następnie usuwa oryginał. Duże obiekty (> 5 GB) i zmiana nazwy między dostawcami nie są obsługiwane w v1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renomear copia o objeto no servidor e exclui o original. Objetos grandes (> 5 GB) e renomeações entre provedores não são suportados na v1."
          }
        }
      }
    },
