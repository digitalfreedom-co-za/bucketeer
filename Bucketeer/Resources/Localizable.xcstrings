    "activity.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, downloads, deletes, sync runs and signed URLs will appear here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, Downloads, Löschungen, Sync-Läufe und signierte URLs erscheinen hier."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléversements, téléchargements, suppressions, exécutions de sync et URL signées apparaissent ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subidas, descargas, eliminaciones, sincronizaciones y URLs firmadas aparecerán aquí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caricamenti, download, eliminazioni, esecuzioni di sync e URL firmate appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード・ダウンロード・削除・同期実行・署名付きURLがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드, 다운로드, 삭제, 동기화 실행, 서명된 URL이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, downloads, verwijderingen, sync-runs en ondertekende URL’s verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wgrania, pobrania, usunięcia, uruchomienia synchronizacji oraz podpisane URL pojawią się tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, downloads, exclusões, execuções de sync e URLs assinadas aparecerão aqui."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahrávání, stahování, mazání, běhy synchronizace a podepsané URL se zobrazí zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads, downloads, sletninger, synkroniseringskørsler og signerede URL'er vises her."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μεταφορτώσεις, λήψεις, διαγραφές, εκτελέσεις συγχρονισμού και υπογεγραμμένα URL θα εμφανίζονται εδώ."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetykset, lataukset, poistot, synkronoinnit ja allekirjoitetut URL-osoitteet näkyvät tässä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A feltöltések, letöltések, törlések, szinkronizálási futtatások és aláírt URL-ek itt jelennek meg."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplastinger, nedlastinger, slettinger, synkroniseringskjøringer og signerte URL-er vises her."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os carregamentos, descarregamentos, eliminações, execuções de sincronização e URLs assinados aparecerão aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь будут отображаться загрузки, скачивания, удаления, запуски синхронизации и подписанные URL."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppladdningar, hämtningar, raderingar, synkkörningar och signerade URL:er visas här."
          }
        }
      }
    },
