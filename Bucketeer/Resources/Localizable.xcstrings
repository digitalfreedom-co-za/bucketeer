    "settings.spotlight.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve výchozím nastavení vypnuto. Po zapnutí lze názvy objektů + kontext bucketu / účtu vyhledávat v celém systému. Obsah objektů se nikdy neindexuje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået fra som standard. Når slået til, bliver objektfilnavne + bucket-/kontokontekst søgbare i hele systemet. Objektindhold indekseres aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig aus. Eingeschaltet werden Dateinamen sowie Bucket-/Konto-Kontext systemweit durchsuchbar. Objektinhalte werden nie indiziert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιημένο από προεπιλογή. Όταν είναι ενεργό, τα ονόματα αρχείων των αντικειμένων + το πλαίσιο bucket / λογαριασμού γίνονται αναζητήσιμα σε όλο το σύστημα. Τα περιεχόμενα των αντικειμένων δεν ευρετηριάζονται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When on, object filenames + bucket / account context become searchable system-wide. Object contents are never indexed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off by default. When on, object filenames + bucket / account context become searchable system-wide. Object contents are never indexed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por defecto. Si se activa, los nombres de archivo y el contexto bucket/cuenta se pueden buscar en todo el sistema. El contenido de los objetos nunca se indexa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletuksena pois päältä. Kun käytössä, objektien tiedostonimet sekä bucket- ja tilikonteksti ovat haettavissa koko järjestelmässä. Objektien sisältöä ei koskaan indeksoida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé par défaut. Une fois l’option activée, les noms de fichiers et le contexte bucket/compte deviennent recherchables dans tout le système. Le contenu des objets n’est jamais indexé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapértelmezés szerint kikapcsolva. Bekapcsolva az objektumok fájlnevei és a bucket-/fiókkontextus rendszerszinten kereshetővé válnak. Az objektumok tartalmát a Bucketeer soha nem indexeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato per impostazione predefinita. Se attivo, i nomi dei file e il contesto bucket/account diventano ricercabili in tutto il sistema. Il contenuto degli oggetti non viene mai indicizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトではオフです。オンにすると、オブジェクトのファイル名とバケット/アカウントの情報がシステム全体で検索できるようになります。オブジェクトの内容はインデックスされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 꺼져 있습니다. 켜면 객체 파일 이름과 버킷/계정 정보를 시스템 전체에서 검색할 수 있습니다. 객체 내용은 색인되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av som standard. Når det er på, blir objektfilnavn + bucket-/kontokontekst søkbare i hele systemet. Objektinnhold indekseres aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standaard uit. Indien ingeschakeld worden bestandsnamen en bucket-/accountcontext systeembreed doorzoekbaar. Objectinhoud wordt nooit geïndexeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Domyślnie wyłączone. Po włączeniu nazwy plików i kontekst bucket/konto są przeszukiwalne w całym systemie. Zawartość nigdy nie jest indeksowana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por padrão. Quando ativo, nomes de arquivo e contexto bucket/conta ficam pesquisáveis no sistema. O conteúdo nunca é indexado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado por predefinição. Quando ativo, os nomes de ficheiro dos objetos + o contexto de bucket/conta ficam pesquisáveis em todo o sistema. Os conteúdos dos objetos nunca são indexados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию выключено. При включении имена файлов объектов и контекст бакета / учётной записи становятся доступны для поиска по всей системе. Содержимое объектов никогда не индексируется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av som standard. När det är på blir objektfilnamn samt bucket- och kontokontext sökbara i hela systemet. Objektens innehåll indexeras aldrig."
          }
        }
      }
    },
