            "state": "translated",
            "value": "Delete local file after successful upload"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Datei nach erfolgreichem Upload löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le fichier local après téléversement réussi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar archivo local tras subida exitosa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il file locale dopo upload riuscito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロード成功後にローカルファイルを削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 성공 후 로컬 파일 삭제"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder lokaal bestand na succesvolle upload"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń lokalny plik po udanym wgraniu"
          }
        },
        "pt-BR": {
