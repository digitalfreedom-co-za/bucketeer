    "about.legal.summary" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer je software s dostupným zdrojovým kódem (source-available), nikoli open source. Jediná kanonická binárka je distribuována přes Mac App Store. Podrobnosti najdete v Licenci, EULA a poznámkách k open source."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer er source-available, ikke open source. Den eneste kanoniske binære fil distribueres via Mac App Store. Se Licens, EULA og Open Source-meddelelser for detaljer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer ist Source-Available, nicht Open Source. Die einzige offizielle Binärversion wird über den Mac App Store vertrieben. Details unter Lizenz, EULA und Open-Source-Hinweise."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Bucketeer διατίθεται με διαθέσιμο πηγαίο κώδικα (source-available), δεν είναι ανοιχτού κώδικα. Το μοναδικό επίσημο εκτελέσιμο διανέμεται μέσω του Mac App Store. Δείτε την Άδεια χρήσης, την EULA και τις Σημειώσεις ανοιχτού κώδικα για λεπτομέρειες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer is source-available, not open source. The single canonical binary is distributed via the Mac App Store. See License, EULA and Open Source Notices for details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer es de código disponible, no de código abierto. El único binario canónico se distribuye a través de la Mac App Store. Consulta la Licencia, el EULA y los Avisos de Open Source para más detalles."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer on lähdekoodiltaan saatavilla (source-available), ei avointa lähdekoodia. Ainoa virallinen binääri jaellaan Mac App Storen kautta. Katso lisätiedot lisenssistä, EULAsta ja avoimen lähdekoodin ilmoituksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer est en source disponible, pas open source. Le seul binaire officiel est distribué via le Mac App Store. Pour en savoir plus, consultez la Licence, le CLUF et les mentions Open Source."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Bucketeer forráskódja nyilvános (source-available), de nem nyílt forráskódú szoftver. Az egyetlen hivatalos binárist a Mac App Store-on keresztül terjesztjük. Részletek a Licenc, az EULA és a Nyílt forráskódú közlemények részben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer è a sorgente disponibile, non open source. L'unico binario ufficiale viene distribuito tramite il Mac App Store. Per i dettagli consulta Licenza, EULA e Avvisi Open Source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer はソース公開ですが、オープンソースではありません。正規のバイナリは Mac App Store でのみ配布されます。詳細はライセンス、EULA、オープンソース表記をご覧ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer는 소스가 공개되지만 오픈 소스는 아닙니다. 공식 바이너리는 Mac App Store를 통해서만 배포됩니다. 자세한 내용은 라이선스, EULA, 오픈 소스 고지를 참조하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer er source-available, ikke åpen kildekode. Den ene kanoniske binærfilen distribueres via Mac App Store. Se Lisens, EULA og Åpen kildekode-merknader for detaljer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer is source-available, geen open source. De enige officiële binary wordt verspreid via de Mac App Store. Zie Licentie, EULA en Open Source-vermeldingen voor details."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer udostępnia kod źródłowy, ale nie jest open source. Jedyna oficjalna wersja binarna jest dystrybuowana przez Mac App Store. Szczegóły w Licencji, EULA i Informacjach o Open Source."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bucketeer tem o código disponível, mas não é de código aberto. O único binário oficial é distribuído pela Mac App Store. Veja Licença, EULA e Avisos de código aberto para mais detalhes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bucketeer tem o código-fonte disponível, mas não é de código aberto. O único binário canónico é distribuído através da Mac App Store. Consulte a Licença, o EULA e os Avisos de Código Aberto para mais detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer распространяется по модели source-available, это не open source. Единственная каноническая сборка распространяется через Mac App Store. Подробности см. в разделах «Лицензия», «EULA» и «Открытый код»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer är source-available, inte öppen källkod. Den enda officiella binärfilen distribueras via Mac App Store. Se Licens, EULA och Öppen källkod för mer information."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bucketeer is source-available, not open source. The single canonical binary is distributed via the Mac App Store. See Licence, EULA and Open Source Notices for details."
          }
        }
      }
    },
