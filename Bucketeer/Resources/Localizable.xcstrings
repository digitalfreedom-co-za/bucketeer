    "hardwareKey.status.noReader" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit nehlásí žádné sloty. macOS možná nenačetl ovladač — zkuste čtečku odpojit a znovu připojit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit rapporterer ingen pladser. macOS har muligvis ikke indlæst en driver — prøv at tage læseren ud og sætte den i igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit meldet keine Slots. macOS hat möglicherweise keinen Treiber geladen — Reader aus- und wieder einstecken."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το CryptoTokenKit δεν αναφέρει υποδοχές. Το macOS ίσως δεν έχει φορτώσει πρόγραμμα οδήγησης — δοκιμάστε να αποσυνδέσετε και να ξανασυνδέσετε τον αναγνώστη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit reports no slots. macOS may not have loaded a driver — try unplugging and reinserting the reader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit no informa ranuras. macOS quizás no ha cargado un driver — desconecta y reconecta el lector."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit ei ilmoita yhtään korttipaikkaa. macOS ei ehkä ole ladannut ajuria — kokeile irrottaa lukija ja kytkeä se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit ne signale aucun emplacement. macOS n’a peut-être pas chargé de pilote — débranchez et rebranchez le lecteur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A CryptoTokenKit nem jelez foglalatot. Előfordulhat, hogy a macOS nem töltött be illesztőprogramot — húzza ki, majd csatlakoztassa újra az olvasót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit non segnala slot. macOS potrebbe non aver caricato un driver — scollega e ricollega il lettore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit はスロットを報告しません。macOS がドライバを読み込んでいない可能性があります。リーダーを抜き差ししてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit가 슬롯을 보고하지 않습니다. macOS가 드라이버를 로드하지 않았을 수 있습니다. 리더를 다시 연결하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit rapporterer ingen spor. macOS har kanskje ikke lastet inn en driver — prøv å koble leseren fra og til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit meldt geen sleuven. macOS heeft mogelijk geen driver geladen — verwijder en plaats de lezer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit nie zgłasza slotów. macOS mógł nie załadować sterownika — odłącz i podłącz czytnik ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit não informa slots. macOS pode não ter carregado um driver — desconecte e reconecte o leitor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O CryptoTokenKit não reporta slots. O macOS pode não ter carregado um controlador — experimente desligar e voltar a ligar o leitor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit не сообщает о слотах. Возможно, macOS не загрузила драйвер — попробуйте отключить и снова подключить считыватель."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CryptoTokenKit rapporterar inga platser. macOS kanske inte har läst in en drivrutin — prova att koppla ur läsaren och sätta i den igen."
          }
        }
      }
    },
