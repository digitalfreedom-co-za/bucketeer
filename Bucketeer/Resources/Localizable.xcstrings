    "encryption.editor.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the key safely — losing it permanently locks any object encrypted with it. Bucketeer cannot recover lost keys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel sicher aufbewahren — verlorene Schlüssel sperren verschlüsselte Objekte unwiderruflich. Bucketeer kann sie nicht wiederherstellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la clé en sécurité — la perdre verrouille définitivement les objets chiffrés avec elle. Bucketeer ne peut pas la récupérer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la clave de forma segura: perderla bloquea permanentemente los objetos cifrados con ella. Bucketeer no puede recuperarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la chiave in sicurezza — perderla blocca per sempre gli oggetti cifrati con essa. Bucketeer non può recuperarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵を安全に保管してください — 紛失すると、そのキーで暗号化されたオブジェクトは復元できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 안전하게 보관하세요 — 분실하면 해당 키로 암호화된 객체를 영구적으로 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de sleutel veilig — verlies betekent dat met die sleutel versleutelde objecten permanent ontoegankelijk worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj klucz bezpiecznie — utrata trwale blokuje wszystkie obiekty zaszyfrowane tym kluczem. Bucketeer nie może go odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde a chave em segurança — perdê-la bloqueia permanentemente os objetos cifrados com ela. O Bucketeer não pode recuperá-la."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíč bezpečně uložte — jeho ztráta trvale uzamkne všechny objekty, které jím byly zašifrovány. Bucketeer ztracené klíče obnovit nedokáže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem nøglen et sikkert sted — mistes den, låses alle objekter krypteret med den permanent. Bucketeer kan ikke gendanne mistede nøgler."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φυλάξτε το κλειδί με ασφάλεια — η απώλειά του κλειδώνει οριστικά κάθε αντικείμενο που κρυπτογραφήθηκε με αυτό. Το Bucketeer δεν μπορεί να ανακτήσει χαμένα κλειδιά."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna avain turvallisesti — sen kadottaminen lukitsee pysyvästi kaikki sillä salatut objektit. Bucketeer ei voi palauttaa kadonneita avaimia."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse el a kulcsot biztonságos helyre — elvesztése véglegesen zárolja az összes vele titkosított objektumot. A Bucketeer nem tudja helyreállítani az elveszett kulcsokat."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta godt vare på nøkkelen — mister du den, låses alle objekter som er kryptert med den, permanent. Bucketeer kan ikke gjenopprette tapte nøkler."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde a chave em segurança — perdê-la bloqueia permanentemente qualquer objeto encriptado com ela. O Bucketeer não consegue recuperar chaves perdidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните ключ в надёжном месте — его утрата навсегда заблокирует все зашифрованные им объекты. Bucketeer не может восстановить утерянные ключи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara nyckeln på ett säkert ställe — om du förlorar den låses alla objekt som krypterats med den permanent. Bucketeer kan inte återskapa förlorade nycklar."
          }
        }
      }
    },
    "encryption.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys live only on this Mac (Keychain). Lose them = lose access to every object you encrypted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel existieren nur auf diesem Mac (Schlüsselbund). Verlust = kein Zugriff mehr auf verschlüsselte Objekte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés vivent uniquement sur ce Mac (trousseau). Les perdre = perdre l’accès à tous les objets chiffrés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves viven solo en este Mac (llavero). Perderlas = perder el acceso a todos los objetos cifrados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi esistono solo su questo Mac (Portachiavi). Perderle = perdere accesso a ogni oggetto cifrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵はこのMacのキーチェーンのみに存在します。紛失すると暗号化済みオブジェクトにアクセスできなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 Mac의 키체인에만 존재합니다. 분실 시 모든 암호화된 객체에 접근할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels staan alleen op deze Mac (sleutelhanger). Verloren = geen toegang meer tot versleutelde objecten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze istnieją tylko na tym Macu (pęk kluczy). Utrata = brak dostępu do każdego zaszyfrowanego obiektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves existem apenas neste Mac (Chaveiro). Perdê-las = perder o acesso a todos os objetos criptografados."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíče existují pouze na tomto Macu (klíčenka). Jejich ztráta = ztráta přístupu ke všem zašifrovaným objektům."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgler findes kun på denne Mac (nøglering). Mister du dem, mister du adgangen til alle objekter, du har krypteret."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά υπάρχουν μόνο σε αυτό το Mac (Κλειδοθήκη). Αν τα χάσετε, χάνετε την πρόσβαση σε κάθε αντικείμενο που κρυπτογραφήσατε."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaimet ovat vain tällä Macilla (avainnippu). Jos menetät ne, menetät pääsyn kaikkiin salaamiisi objekteihin."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kulcsok csak ezen a Macen élnek (kulcskarika). Elvesztésük = minden titkosított objektumhoz való hozzáférés elvesztése."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkler finnes bare på denne Macen (nøkkelring). Mister du dem, mister du tilgangen til alle objekter du har kryptert."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves existem apenas neste Mac (porta-chaves). Perdê-las = perder o acesso a todos os objetos que encriptou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи хранятся только на этом Mac (Связка ключей). Потеряете их — потеряете доступ ко всем зашифрованным объектам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nycklarna finns bara på denna Mac (nyckelringen). Förlorar du dem förlorar du åtkomsten till alla objekt du har krypterat."
          }
        }
      }
    },
