    "autoTag.mime.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty matches every MIME. Prefix is case-insensitive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer = jeder MIME-Typ. Präfix ist nicht case-sensitiv."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide = tout MIME. Sans tenir compte de la casse."
          }
        },
        "es": {
