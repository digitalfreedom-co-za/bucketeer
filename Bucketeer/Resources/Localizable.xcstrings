    "autoTag.empty.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pravidla automaticky přidávají objektům štítky a metadata po nahrání — např. nastaví project-id každému PDF."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regler tagger og tilføjer metadata til objekter automatisk efter upload — sæt f.eks. project-id på hver PDF."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeln versehen Objekte nach dem Upload automatisch mit Tags und Metadaten — z. B. project-id für jedes PDF."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κανόνες προσθέτουν αυτόματα ετικέτες και μεταδεδομένα στα αντικείμενα μετά τη μεταφόρτωση — π.χ. ορισμός project-id σε κάθε PDF."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rules tag and add metadata to objects automatically after upload — e.g. set project-id on every PDF."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rules tag and add metadata to objects automatically after upload — e.g. set project-id on every PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas añaden etiquetas y metadatos a los objetos automáticamente tras la subida — p. ej., project-id en cada PDF."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säännöt lisäävät objekteihin tunnisteita ja metatietoja automaattisesti lähetyksen jälkeen — esim. aseta project-id jokaiselle PDF:lle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles ajoutent automatiquement des tags et des métadonnées aux objets après le téléversement — p. ex. project-id pour chaque PDF."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szabályok feltöltés után automatikusan címkéket és metaadatokat adnak az objektumokhoz — pl. project-id beállítása minden PDF-re."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le regole aggiungono automaticamente tag e metadati agli oggetti dopo il caricamento — ad es. project-id su ogni PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルールを使うと、アップロード後にオブジェクトへタグやメタデータを自動で付与できます（例: すべての PDF に project-id を設定）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙을 사용하면 업로드 후 객체에 태그와 메타데이터가 자동으로 추가됩니다(예: 모든 PDF에 project-id 설정)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regler tagger og legger til metadata på objekter automatisk etter opplasting — f.eks. sett project-id på hver PDF."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regels taggen en voorzien geüploade objecten automatisch van metadata — bv. project-id op elke PDF."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły automatycznie nadają obiektom tagi i metadane po wysłaniu — np. project-id dla każdego pliku PDF."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras adicionam tags e metadados aos objetos automaticamente após o upload — por exemplo, project-id em todo PDF."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras etiquetam e adicionam metadados aos objetos automaticamente após o carregamento — p. ex. definir project-id em todos os PDF."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила автоматически добавляют теги и метаданные к объектам после загрузки — например, задают project-id для каждого PDF."
          }
        },
        "sv" : {
