    "error.credentialsMissing" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlašovací údaje tohoto účtu chybí. Upravte účet a znovu zadejte přístupový a tajný klíč."
          }
        },
        "da" : {
          "stringUnit" : {
