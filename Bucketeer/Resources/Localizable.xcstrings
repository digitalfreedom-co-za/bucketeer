    "trash.empty.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted objects appear here. Cached copies enable one-click restore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Objekte erscheinen hier. Zwischengespeicherte Kopien ermöglichen Wiederherstellung mit einem Klick."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les objets supprimés apparaissent ici. Les copies en cache permettent une restauration en un clic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los objetos eliminados aparecen aquí. Las copias en caché permiten restaurar con un clic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli oggetti eliminati appaiono qui. Le copie in cache abilitano il ripristino con un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたオブジェクトはここに表示されます。キャッシュされたコピーがあればワンクリックで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 객체가 여기에 표시됩니다. 캐시된 사본이 있으면 한 번의 클릭으로 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijderde objecten verschijnen hier. Gecachte kopieën maken herstellen met één klik mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte obiekty pojawią się tutaj. Zachowane kopie pozwalają na przywrócenie jednym kliknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Objetos excluídos aparecem aqui. Cópias em cache permitem restaurar com um clique."
          }
        }
      }
    },
